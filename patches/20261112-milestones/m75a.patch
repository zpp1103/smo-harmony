+static int m71a_near(float a, float bb) { float d = a - bb; if (d < 0) d = -d; float s = bb < 0 ? -bb : bb; return d <= (s > 1.f ? s * 2e-5f : 1e-6f); }
+static int m71a_ubo_patch(int st, const vkshader_t *s, const dmsv_bind *b, VkDescriptorBufferInfo *bi) {
+    const int m = vk_m71a_mode(); if (!((m & 7) && st == 1 && s && s->key == M71A_FOG_FS)) return 0;
+    const p_bind_buf *u = b->reg >= 0 && b->reg < 16 ? &S.ubo[st][b->reg] : NULL;
+    if (!u || !u->addr || u->size < 64) return 0;
