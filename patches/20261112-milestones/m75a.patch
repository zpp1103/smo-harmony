+        if (v > 0) VKLOG("[m71a-seg] variant (pass 71 FS %016llx%s%s%s%s%s)", (unsigned long long)M71A_FOG_FS,
+                         (v & 1) ? ", c2[2]/2" : "", (v & 2) ? ", c1[2]/2" : "", (v & 4) ? ", both/2" : "", (v & 8) ? ", last-stage compressed" : "",
