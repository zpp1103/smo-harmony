+}
+typedef struct { VkBuffer b; VkDeviceMemory m; void *p; uint32_t w, h, bpp; VkFormat f; uint64_t fence; } m71ahcp_t;
+static m71ahcp_t g_m71ahcp[8]; static int g_m71ahcp_n;
+static void m71a_hist_poll(uint64_t done_fence) {
+    int keep = 0;
+    for (int i = 0; i < g_m71ahcp_n; i++) {
+        m71ahcp_t *d = &g_m71ahcp[i];
+        if (!d->b) continue;
+        if (done_fence < d->fence) { g_m71ahcp[keep++] = *d; continue; }
+        const uint64_t np = (uint64_t)d->w * d->h; uint64_t far = 0, a = 0, bb = 0, c = 0; double sum = 0; float lo = 1e9f, hi = -1e9f;
+        for (uint64_t q = 0; q < np; q++) {
+            float v = d->bpp == 2 ? half2f(((const uint16_t *)d->p)[q]) : ((const float *)d->p)[q];
+            if (!(v == v)) v = 0.f;
+            sum += v; if (v < lo) lo = v; if (v > hi) hi = v;
+            if (v >= 0.999f) far++; else if (v >= 0.9f) a++; else if (v >= 0.5f) bb++; else c++;
+        }
+        if (np) VKLOG("[m71a-hist] pass 71's sampled %ux%u depth (fmt=%d): d>=0.999 %.2f%% | 0.9-0.999 %.2f%% | 0.5-0.9 %.2f%% | <0.5 %.2f%% (min %.6f max %.6f mean %.6f)",
+                      d->w, d->h, (int)d->f, 100.0 * (double)far / (double)np, 100.0 * (double)a / (double)np, 100.0 * (double)bb / (double)np, 100.0 * (double)c / (double)np,
+                      (double)lo, (double)hi, sum / (double)np);
+        vkDestroyBuffer(V.dev, d->b, NULL); vkFreeMemory(V.dev, d->m, NULL); memset(d, 0, sizeof *d);
+    }
+    g_m71ahcp_n = keep;
+}
+static void m71a_pass_end(void) {
+    const int m = vk_m71a_mode(); if (!m) return;
+    if ((m & 8) && g_m71a_bc_lines < 4 && g_m71a_bc) { g_m71a_bc_lines++;
+        VKLOG("[m71a-bc] pass %d (%ux%u, %d draws so far, colour write mask %#x): last-stage outputs compressed x%g (blend src=CONSTANT_COLOR dst=ZERO)", g_sub_pass - 1, S.pass_w, S.pass_h,
+              (int)g_pass_draws, S.chmask.mask, (double)m71a_bconst()); }
+    if ((m & 7) && g_m71a_fog_sub == mtl_last_fence() + 1 && g_m71a_patched_sub != mtl_last_fence() + 1) {   // 改道没发生 ⇒ 银行不是走 cbuf_desc 绑的（否则就是 pattern 没对上，那行由 [m71a-miss] 报）
+        static int said; if (!said && g_m71a_ubo_lines == 0) { said = 1;
+            VKLOG("[m71a-nobank] pass 71 drew this submission, but none of its constant-buffer descriptors went through cbuf_desc: c1[2]/c2[2] were NOT patched"); } }
+    if (!(m & 16)) return;
+    m71a_hist_poll(mtl_last_fence());
+    if (g_m71a_dep_ready && g_m71a_dep && g_m71a_dep->img && g_m71a_dep_sub == mtl_last_fence() + 1 && g_m71a_hist_n < 24 && g_m71ahcp_n < 8) {
+        g_m71a_dep_ready = 0;
+        vkimg_t *im = g_m71a_dep;
+        const uint32_t bpp = im->fmt == VK_FORMAT_D16_UNORM ? 2u : 4u; const VkDeviceSize n = (VkDeviceSize)im->w * im->h * bpp;
+        m71ahcp_t *d = &g_m71ahcp[g_m71ahcp_n]; memset(d, 0, sizeof *d);
+        d->w = im->w; d->h = im->h; d->bpp = bpp; d->f = im->fmt; d->fence = mtl_last_fence() + 1;
+        VkBufferCreateInfo bi = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, NULL, 0, n, VK_BUFFER_USAGE_TRANSFER_DST_BIT, VK_SHARING_MODE_EXCLUSIVE};
+        int ok = vkCreateBuffer(V.dev, &bi, NULL, &d->b) == VK_SUCCESS;
+        if (ok) { VkMemoryRequirements rq; vkGetBufferMemoryRequirements(V.dev, d->b, &rq);
+            VkMemoryAllocateInfo ai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, NULL, rq.size, vk_mem_type(rq.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, 0)};
+            ok = !vkAllocateMemory(V.dev, &ai, NULL, &d->m) && !vkBindBufferMemory(V.dev, d->b, d->m, 0) && !vkMapMemory(V.dev, d->m, 0, VK_WHOLE_SIZE, 0, &d->p); }
+        if (!ok) { if (d->m) vkFreeMemory(V.dev, d->m, NULL); if (d->b) vkDestroyBuffer(V.dev, d->b, NULL); d->b = VK_NULL_HANDLE; d->m = VK_NULL_HANDLE; d->p = NULL; return; }
+        VkCommandBuffer cb = vk_cmd(); vk_img_barrier_all(cb);
+        VkBufferImageCopy c = {0, 0, 0, {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1}, {0, 0, 0}, {d->w, d->h, 1}};
+        vkCmdCopyImageToBuffer(cb, im->img, VK_IMAGE_LAYOUT_GENERAL, d->b, 1, &c); vk_img_barrier_all(cb);
+        g_m71ahcp_n++; g_m71a_hist_n++;
+    }
+}
