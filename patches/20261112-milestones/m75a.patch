+        if (g_m71a_ubo_lines < 4) { g_m71a_ubo_lines++;
+            VKLOG("[m71a-miss] pass 71 FS %016llx bank=%#llx+%llu: c1[2]@%d c2[2]@%d (wanted %d/%d) are not where the pattern says; not patched. head floats: %g %g %g %g | %g %g %g %g | %g %g %g %g",
+                  (unsigned long long)M71A_FOG_FS, (unsigned long long)u->addr, (unsigned long long)u->size, o1, o2, want1, want2,
+                  (double)f[0], (double)f[1], (double)f[2], (double)f[3], (double)f[4], (double)f[5], (double)f[6], (double)f[7], (double)f[8], (double)f[9], (double)f[10], (double)f[11]); }
