+    { static int said = -1; if (v != said) { said = v; g_ubo_gen[1]++;   // 变档要让 stage 1 的描述符重算（否则 set memo 会把上一档的 set 直接复给这一帧）
+        VKLOG("[m71a-seg] knob now DM_VK_M71A=%d, 2 s cache (probe lines after this one belong to this variant)", v);
+        if (v > 0) VKLOG("[m71a] knob on (DM_VK_M71A=%d: c2[2]/2 %s, c1[2]/2 %s, both %s, last-stage x%g %s, 800x450 depth histogram %s)", v,
