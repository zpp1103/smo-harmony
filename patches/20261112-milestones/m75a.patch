+static int m70a_cur_col(uint64_t *pool, int64_t *off) {   // 当前 pass 的第一个颜色目标（只看状态影子，不创建/刷新图像）
+    int ci = 0; while (ci < S.ncol && ci < 8 && !S.rt_has_col[ci]) ci++;
