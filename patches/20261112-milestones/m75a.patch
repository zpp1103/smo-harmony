+   c2=(49.9975,-1,33.3317,-0.333333)）：out.rgb = col·c1[2]·(t²+luma)、t = clamp(f·c2[2] − 0.3333,0,1)。本块只做「仅本单生效」的替换：
+     bit0(1)  = c2[2] 减半（33.3317→16.66585）：雾项 t 的斜率，只压缩过渡带（远平面仍 clamp 到 1）
+     bit1(2)  = c1[2] 减半（0.06→0.03）：雾/亮度项的整体增益
+     bit2(4)  = 两者都减半
+     bit3(8)  = 末级（渲染面那一级：宽 16–40、高 8–24 = 40×22 / 25×14 / 20×11，随动态分辨率缩放；2×1 曝光与 128² 阴影不在内）
+                **每条 pass 的输出等比例压缩**：
+                blend src = CONSTANT_COLOR、dst = ZERO、add ⇒ out = DM_VK_M71A_BC·src（默认 0.55）。是「等比例压缩」不是 min 截断
+                （Vulkan 的 blend 不能取 min；派活单允许两者之一，实现方式在此写清）。纯 pass 状态改动，不碰游戏数据
+     bit4(16) = 诊断：把 pass 71 采样的 800×450 D32 深度在 pass 结束时 transfer copy 读回，算四档直方图（d≥0.999 / 0.9–0.999 /
+                0.5–0.9 / <0.5）——回答「这张深度是不是真的远平面饱和」
+   实现（bit0/1/2）不用 render pass 内的写内存（vkCmdUpdateBuffer 在 render pass 里非法）：在描述符构建处把 pass 71 的 FS 看到的
+   **那一份** c0 常量银行重定向到一块打了补丁的 scratch 副本（本 submission 内的 host-visible 环，vk_scratch），VS 与其它 pass 一律不动。
+   两个偏移先在 bank 头里按实测的 float 组合验证（100,0,0.06,10000 / 49.9975,-1,33.3317,-0.3333），对不上再在前 512 B 里按这个组合扫；
+   都对不上就一行 [m71a-miss] 并放弃（不猜）。全 0 = 零日志、零分配、零行为变化。 */
+#define M71A_FOG_FS 0x4761cab3adf56549ull
+static int g_m71a_ubo_lines, g_m71a_hist_n, g_m71a_bc_lines;
+static vkimg_t *g_m71a_dep; static uint64_t g_m71a_dep_sub; static int g_m71a_dep_ready;
+static uint64_t g_m71a_fog_sub, g_m71a_patched_sub;   // 这一帧 pass 71 画过没有 / 它的常量银行这一帧被改道过没有（两者不一致 = 银行不是走 cbuf_desc 绑的）
+float m71a_bconst(void) { const char *e = getenv("DM_VK_M71A_BC"); return e && *e ? (float)atof(e) : 0.55f; }
+int vk_m71a_mode(void) {
