+// ============================ M72A：那张 800×450 D32 到底谁该写（默认关；smo_m72a → DM_VK_M72A）============================
+/* 派活单（2026-11-12 07:05）：雾链 pass 71 采样的那张 800×450 D32 直方图是「无几何」（d≥0.999 45.64% / 0.9–0.999 54.36% /
+   0.5–0.9 0% / <0.5 0%，min 0.98584 / mean 0.995937）——要分出「写错图 / 被 clear 覆盖 / 池别名同段」。本块只取证，不改任何
+   渲染状态（不碰描述符、不碰 loadOp、不碰内存）：
+     bit0(1) = pass 归属表（本窗口内每条 pass 一行）：深度附件的 pool+off / w×h / fmt / loadOp / clearDepth / storeOp，
+               本 pass 的 draw 数、逐 draw 的 depthTest/depthWrite/compare/bias 汇总，depth clear 次数（含没折叠成 loadOp 的
+               vkCmdClearAttachments 与它清成的值），以及颜色附件 #0 的身份；
+     bit1(2) = 深度读回：深度附件是 800×450（雾采样那张所在的尺寸类）的 pass 结束时 vkCmdCopyImageToBuffer 回读 → 四档直方图；
+     bit2(4) = 深度读回：其它 w≥512 的深度图在 pass 结束时同样回读 → 找「承载真实几何」的那一张；
+     bit3(8) = 采样归属：每条 pass 采样的 w≥512 深度图一行（谁采样谁）。
+   窗口按**提交号**（`mtl_last_fence() + 1`，与 M71A 同一个号）而不是 present 计数：本 build 里 `g_tex_frame` 恒 0（源码注释：
+   `g_tex_frame stays 0 for the whole run`），拿它当哨兵会让窗口永远关不上。第 3 轮（2026-11-12 10:10）的修法：
+   `m72a_samp` 认出「pass 71 采到了那张 800×450」时记下 `g_m72a_fog_sub`（= 那个提交号）；`m72a_pass_end` 在该提交的 pass-end
+   **武装一次**（`g_m72a_armed=1`、`g_m72a_arm_sub=` 该提交号），此后不再重复武装（上一轮 11.7 万行 `[m72a-arm]` 噪声就是每次
+   pass-end 重新武装来的）。窗口 = 提交号 `[arm_sub, arm_sub + M72A_WIN)` = 雾链帧剩余 pass + 下一整帧（含「场景 color pass 写
+   深度 → pass 71 采样」的完整顺序）。全 0 = 零日志、零分配、零读回。 */
+#define M72A_FOG_FS 0x4761cab3adf56549ull   // pass 71 的 FS（M70A/M71A 已钉：全帧只有这条 pass 用它）
+enum { M72A_WIN = 2, M72A_PASS_MAX = 1600, M72A_HIST_A = 60, M72A_HIST_B = 22, M72A_HIST_BIG = 10, M72A_SAMP_MAX = 200, M72A_IMG_MAX = 48 };   // M72A_WIN 现在是**提交数**（2 = 雾链帧剩余 + 下一整帧）
+static int g_m72a_passn, g_m72a_sampn, g_m72a_imgn, g_m72a_hist_a, g_m72a_hist_b, g_m72a_hist_big;
+static uint64_t g_m72a_fog_sub;  // 这个提交号里 pass 71 真的采到了那张 800×450（决定性触发）
+static uint64_t g_m72a_arm_sub;  // 窗口的起点提交号；窗口 = [arm_sub, arm_sub + M72A_WIN)
+static int g_m72a_armed, g_m72a_arms;   // 只武装一次（最多两次：第一窗口一行 pass 都没打时再给一次机会）
+static vkimg_t *g_m72a_fogdep;   // pass 71 采样到的那张 800×450 D32（M70A/M71A 的 binding1）
+static int g_m72a_dw1, g_m72a_dt1, g_m72a_bias, g_m72a_clr; static uint32_t g_m72a_cmp; static float g_m72a_clrd;
+static float g_m72a_biasf, g_m72a_biasu;   // the polygon-offset factor/units of the last draw that had one (NVN's depth bias)
+int vk_m72a_mode(void) {
+    static int v = -1; static long last; long now = (long)time(NULL);
+    if (v >= 0 && now == last) return v;
+    last = now; const char *e = getenv("DM_VK_M72A"); v = e ? atoi(e) : 0;
+    { static int said = -1; if (v != said) { said = v;
+        VKLOG("[m72a-seg] knob now DM_VK_M72A=%d, 2 s cache (probe lines after this one belong to this variant)", v);
+        if (v > 0) VKLOG("[m72a] knob on (DM_VK_M72A=%d: pass census %s, read-back 800x450 depth %s, other depths %s, sampler census %s; the window is the submission that samples it + %d)",
+                         v, (v & 1) ? "on" : "off", (v & 2) ? "on" : "off", (v & 4) ? "on" : "off", (v & 8) ? "on" : "off", M72A_WIN - 1); } }
+    return v;
+}
+static int m72a_win(void) { const uint64_t s = mtl_last_fence() + 1; return g_m72a_armed && s >= g_m72a_arm_sub && s < g_m72a_arm_sub + M72A_WIN; }   // M72A r3: 提交号窗口（g_tex_frame 恒 0，不能用）
+void vk_m72a_img_note(const vkimg_t *im) {   // 一张深度图创建时一行：身份 + 重叠者（同 pool 的内存段，别名判定用）
+    if (!im || !(im->aspect & VK_IMAGE_ASPECT_DEPTH_BIT) || im->w < 512 || g_m72a_imgn >= M72A_IMG_MAX) return;
+    g_m72a_imgn++;
+    char ov[256]; int k = 0; ov[0] = 0;
+    for (int i = 0; i < im->novl && k < (int)sizeof ov - 44; i++)
+        k += snprintf(ov + k, sizeof ov - (size_t)k, " +%#llx..%#llx/%ux%u/%d", (unsigned long long)im->ovl[i]->off,
+                      (unsigned long long)(im->ovl[i]->off + im->ovl[i]->size), im->ovl[i]->w, im->ovl[i]->h, (int)im->ovl[i]->fmt);
+    VKLOG("[m72a-img] sub=%llu %ux%u fmt=%d aspect=%#x levels=%u layers=%u pool=%#llx off=+%#llx..+%#llx size=%#llx img=%p mem=%p sub=%p novl=%d overlap:%s",
+          (unsigned long long)(mtl_last_fence() + 1), im->w, im->h, (int)im->fmt, (unsigned)im->aspect, im->levels, im->layers,
+          (unsigned long long)im->pool, (unsigned long long)im->off, (unsigned long long)(im->off + im->size), (unsigned long long)im->size,
+          (void *)im->img, (const void *)im->mem, im->sub, im->novl, ov[0] ? ov : " -");
+}
+enum { M72A_D32 = 0, M72A_D16 = 1, M72A_D24 = 2, M72A_D32S8 = 3 };
+static float m72a_val(int cls, const uint8_t *row, size_t i) {
+    switch (cls) {
+    case M72A_D16: return (float)((const uint16_t *)row)[i] / 65535.f;
+    case M72A_D24: return (float)(((const uint32_t *)row)[i] & 0xffffffu) / 16777215.f;
+    case M72A_D32S8: { float v; memcpy(&v, row + 8 * i, 4); return v; }
+    default: { float v; memcpy(&v, row + 4 * i, 4); return v; }
+    }
+}
+typedef struct { VkBuffer b; VkDeviceMemory m; void *p; uint32_t w, h; int cls; VkFormat f; uint64_t fence, present, draws; int pass; int64_t off; uint64_t pool; char tag[4]; } m72acp_t;
+static m72acp_t g_m72acp[8]; static int g_m72acp_n;
+static void m72a_poll(uint64_t done_fence) {
+    int keep = 0;
+    for (int i = 0; i < g_m72acp_n; i++) {
+        m72acp_t *d = &g_m72acp[i]; if (!d->b) continue;
+        if (done_fence < d->fence) { g_m72acp[keep++] = *d; continue; }
+        const uint64_t np = (uint64_t)d->w * d->h; uint64_t far = 0, a = 0, bb = 0, c = 0; double sum = 0; float lo = 1e9f, hi = -1e9f;
+        for (uint64_t q = 0; q < np; q++) {
+            float v = m72a_val(d->cls, (const uint8_t *)d->p, (size_t)q);
+            if (!(v == v)) v = 0.f;
+            sum += v; if (v < lo) lo = v; if (v > hi) hi = v;
+            if (v >= 0.999f) far++; else if (v >= 0.9f) a++; else if (v >= 0.5f) bb++; else c++;
+        }
+        if (np) VKLOG("[m72a-hist] tag=%s sub=%llu p=%d draws=%llu dep={%#llx+%#llx %ux%u fmt=%d}: d>=0.999 %.2f%% | 0.9-0.999 %.2f%% | 0.5-0.9 %.2f%% | <0.5 %.2f%% (min %.6f max %.6f mean %.6f)",
+                      d->tag, (unsigned long long)d->present, d->pass, (unsigned long long)d->draws, (unsigned long long)d->pool, (unsigned long long)d->off,
+                      d->w, d->h, (int)d->f, 100.0 * (double)far / (double)np, 100.0 * (double)a / (double)np, 100.0 * (double)bb / (double)np, 100.0 * (double)c / (double)np,
+                      (double)lo, (double)hi, sum / (double)np);
+        vkDestroyBuffer(V.dev, d->b, NULL); vkFreeMemory(V.dev, d->m, NULL); memset(d, 0, sizeof *d);
+    }
+    g_m72acp_n = keep;
+}
+static void m72a_copy(vkimg_t *im, const char *tag) {
+    if (!im || !im->img || !im->w || !im->h || g_m72acp_n >= 8) return;
+    int cls = -1;
+    if (im->fmt == VK_FORMAT_D32_SFLOAT) cls = M72A_D32;
+    else if (im->fmt == VK_FORMAT_D16_UNORM) cls = M72A_D16;
+    else if (im->fmt == VK_FORMAT_X8_D24_UNORM_PACK32 || im->fmt == VK_FORMAT_D24_UNORM_S8_UINT) cls = M72A_D24;
+    else if (im->fmt == VK_FORMAT_D32_SFLOAT_S8_UINT) cls = M72A_D32S8;
+    if (cls < 0) { static int said; if (!said++) VKLOG("[m72a-hist] depth format %d cannot be decoded here: not read back", (int)im->fmt); return; }
+    const uint32_t bpp = cls == M72A_D16 ? 2u : cls == M72A_D32S8 ? 8u : 4u;
+    const VkDeviceSize n = (VkDeviceSize)im->w * im->h * bpp;
+    m72acp_t *d = &g_m72acp[g_m72acp_n]; memset(d, 0, sizeof *d);
+    d->w = im->w; d->h = im->h; d->cls = cls; d->f = im->fmt; d->fence = mtl_last_fence() + 1;
+    d->present = mtl_last_fence() + 1; d->draws = g_pass_draws; d->pass = g_sub_pass - 1; d->pool = im->pool; d->off = im->off;   // M72A r3: 记提交号（present 恒 0）
+    snprintf(d->tag, sizeof d->tag, "%s", tag);
+    VkBufferCreateInfo bi = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, NULL, 0, n, VK_BUFFER_USAGE_TRANSFER_DST_BIT, VK_SHARING_MODE_EXCLUSIVE};
+    if (vkCreateBuffer(V.dev, &bi, NULL, &d->b) != VK_SUCCESS) { d->b = VK_NULL_HANDLE; return; }
+    VkMemoryRequirements rq; vkGetBufferMemoryRequirements(V.dev, d->b, &rq);
+    VkMemoryAllocateInfo ai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, NULL, rq.size, vk_mem_type(rq.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, 0)};
