+    if (g_m71a_dep != im) { g_m71a_dep = im;
+        VKLOG("[m71a-depth] pass %d binds its 800x450 D32: img=%p pool=%#llx off=+%#llx..%#llx fmt=%d aspect=%#x levels=%u layers=%u (sampled at binding %d)",
