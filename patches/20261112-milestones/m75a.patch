+    case VK_FORMAT_R8_UNORM: return 1;
+    case VK_FORMAT_R16_SFLOAT: return 2;
+    case VK_FORMAT_R8G8B8A8_UNORM: case VK_FORMAT_R8G8B8A8_SRGB: case VK_FORMAT_B8G8R8A8_UNORM: case VK_FORMAT_B8G8R8A8_SRGB:
+    case VK_FORMAT_A2B10G10R10_UNORM_PACK32: case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+    case VK_FORMAT_B10G11R11_UFLOAT_PACK32: case VK_FORMAT_R32_SFLOAT: return 4;
+    case VK_FORMAT_R16G16B16A16_SFLOAT: return 8;
+    case VK_FORMAT_R32G32B32A32_SFLOAT: return 16;
+    default: return 0; }
+}
+static void m70a_px(VkFormat f, const uint8_t *t, float *o) {   // 一个 texel → 0..1 的 RGB（与 passdump 同一套解码）
+    o[0] = o[1] = o[2] = 0.f;
+    switch (f) {
+    case VK_FORMAT_R8G8B8A8_UNORM: case VK_FORMAT_R8G8B8A8_SRGB: o[0] = t[0] / 255.f; o[1] = t[1] / 255.f; o[2] = t[2] / 255.f; break;
+    case VK_FORMAT_B8G8R8A8_UNORM: case VK_FORMAT_B8G8R8A8_SRGB: o[0] = t[2] / 255.f; o[1] = t[1] / 255.f; o[2] = t[0] / 255.f; break;
+    case VK_FORMAT_R8_UNORM: o[0] = o[1] = o[2] = t[0] / 255.f; break;
+    case VK_FORMAT_A2B10G10R10_UNORM_PACK32: { uint32_t w; memcpy(&w, t, 4); o[0] = (w & 0x3ff) / 1023.f; o[1] = ((w >> 10) & 0x3ff) / 1023.f; o[2] = ((w >> 20) & 0x3ff) / 1023.f; } break;
+    case VK_FORMAT_A2R10G10B10_UNORM_PACK32: { uint32_t w; memcpy(&w, t, 4); o[0] = ((w >> 20) & 0x3ff) / 1023.f; o[1] = ((w >> 10) & 0x3ff) / 1023.f; o[2] = (w & 0x3ff) / 1023.f; } break;
+    case VK_FORMAT_R16G16B16A16_SFLOAT: { const uint16_t *h = (const uint16_t *)t; o[0] = half2f(h[0]); o[1] = half2f(h[1]); o[2] = half2f(h[2]); } break;
+    case VK_FORMAT_R16_SFLOAT: { float v = half2f(*(const uint16_t *)t); o[0] = o[1] = o[2] = v; } break;
+    case VK_FORMAT_B10G11R11_UFLOAT_PACK32: { uint32_t w; memcpy(&w, t, 4); o[0] = half2f((uint16_t)((w & 0x7ff) << 4)); o[1] = half2f((uint16_t)((w >> 11 & 0x7ff) << 4)); o[2] = half2f((uint16_t)((w >> 22 & 0x3ff) << 5)); } break;
+    case VK_FORMAT_R32_SFLOAT: { float v; memcpy(&v, t, 4); o[0] = o[1] = o[2] = v; } break;
+    case VK_FORMAT_R32G32B32A32_SFLOAT: { const float *p = (const float *)t; o[0] = p[0]; o[1] = p[1]; o[2] = p[2]; } break;
+    }
+}
+static void m70a_stats(m70acp_t *d) {   // 一张颜色目标的 nearwhite / 均值 / 8×8 网格（宿主侧与 off-line passstat 同口径）
+    const unsigned bpp = d->bpp; const double np = (double)d->w * (double)d->h;
+    uint64_t nw = 0, ge = 0, cnw[64] = {0}, ctot[64] = {0}; double sr = 0, sg = 0, sb = 0; double mx = 0;
+    for (uint32_t y = 0; y < d->h; y++) {
+        const uint8_t *row = (const uint8_t *)d->p + (size_t)y * d->w * bpp; const int gy = (int)((uint64_t)y * 8 / d->h);
+        for (uint32_t x = 0; x < d->w; x++) {
+            float c[3]; m70a_px(d->f, row + (size_t)x * bpp, c);
+            for (int k = 0; k < 3; k++) { if (!(c[k] == c[k])) c[k] = 0.f; else if (c[k] < 0.f) c[k] = 0.f; else if (c[k] > 1.f) c[k] = 1.f; }
