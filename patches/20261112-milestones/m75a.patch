+__attribute__((constructor(170))) static void m64a_apply_at_start(void)
+{
+    char p[256];
+    for (int v = 0; v < 2; v++) {
+        snprintf(p, sizeof p, "%s%s", v ? M48A_A : M48A_B, "smo_m64a");
+        FILE *f = fopen(p, "r");
+        if (!f) continue;
+        char b[32]; size_t n = fread(b, 1, sizeof b - 1, f); fclose(f);
+        b[n] = 0;
+        int val = atoi(b);
+        char vb[16]; snprintf(vb, sizeof vb, "%d", val > 0 ? val : 0);
+        setenv("DM_VK_M64A", vb, 1);
+        return;
+    }
