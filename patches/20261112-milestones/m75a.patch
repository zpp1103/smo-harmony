+// ============================ M73A：pass 71 的 z→视距换算式重标定（默认关；smo_m73a → DM_VK_M73A）============================
+/* 派活单（2026-11-12 11:20）：M72A 已证明那张 800×450 D32 **就是场景深度本身**（0.9–0.999 是 f/n≈10⁴ 投影下的正常落位，
+   0.5–0.9 与 <0.5 两档构造上永远为空），白斑的物理入口在 **pass 71**（200×112 / 320×180，1 笔全屏三角形，FS 4761cab3adf56549）
+   把 z 换算成视距的那一步 + t 的二值化。M70A 的 SPIR-V 反汇编给出这一步的完整数学：
+     d   = tex(binding1, uv).x                                        （800×450 D32 场景深度，落在 0.9698…1.0）
+     h   = 1/(1 − d·c4[0]) − 1                                        （c4[0]=0.99995, c4[1]=5.0003e-05）
+     f   = c4[1]·h
+     t   = clamp(f·c2[2] + c2[3], 0, 1)                               （c2[2]=33.3317, c2[3]=−0.3333）
+     out.rgb = col.rgb · c1[2] · (t² + luma)、out.a = col.a · 同一系数  （c1[2]=0.06；luma = clamp(dot(col,c0)))
+   把投影的 d =(f/(f−n))·(1 − n/z) 代进 h：1−d = (n/(f−n))·(f/z − 1) ⇒ **h ≈ z/n − 1、f ≈ z/20000**（n=1、far=10000 时
+   c4 的两个系数正好是 1−n/far=0.9999 与 1/far=1e-4 的近似）。⇒ t = 0 在 z≈200 单位、t = 1 在 z≈741 单位：
+   实测帧里 d≥0.999（z≳1000，天穹 + 月亮）的 38.71% 像素 **t 恒 1**，d 在 0.9698–0.994（z≈33–200，雪丘/马里奥/白塔）的
+   61.29% 像素 **t 恒 0**，过渡带只剩 d∈[0.995,0.999] 一条细缝 ⇒ 雾项在整块天穹上二值饱和，被下游 8 级累加放大成两团白斑。
+   本块**只改 pass 71 的 FS 常量银行**（不碰深度图/场景 pass/几何/分辨率，不碰其它 pass 或阶段）：把这条 draw 的 FS 常量银行
+   重定向到打了补丁的 scratch 副本（`vk_scratch`；render pass 里不能 vkCmdUpdateBuffer），按预设置位改 5 个 float：
+     c1[2]（增益） / c2[2]（斜率 A） / c2[3]（偏置 B） / c4[0] / c4[1]（后两个 = 双曲反演的两个系数）。
+   预设 = smo_m73a 的 bit（都可 2 s 热切；变一次打一行 [m73a-seg]，之后每笔 draw 打在 [m73a-ubo]）：
+     bit0(1)  双曲反演按投影做**精确**：c4 = (1−n/far, 1/far) = (0.9999, 1e-4)（far 取银行里的 c1[3]=10000、near=1），
+               f 因此翻倍 ⇒ A 减半成 16.665825，t 的零点/满点仍落在 z≈200/800（= 基线但反演形式正确、不再用 0.99995 那笔压缩）；
+     bit1(2)  远平面压缩项按 far 动态（同 bit0 的 c4）+ **只雾真远**：t 重标到 z∈[700,2500]（A=5.555556, B=−0.388889）
+               ⇒ 场景带 33–200 一律 t=0，天穹仍有连续梯度直到 z≈2500 才夹到 1；
+     bit2(4)  线性视距插值：t = clamp((z−50)/(800−50))（保持原 c4；f≈z/2e4 ⇒ A=26.666667, B=−0.0666667）；
+     bit3(8)  取消饱和（放弃夹到 1）：t = 0.30·f（A=0.30, B=0）⇒ 天穹最高 0.30、t² 从 1 降到 0.09，仍随视距连续变化；
+     bit4(16) bit1 + 增益 c1[2] 0.06→0.045（同一 pass 的常量，一起做「远雾 + 电平」联合臂）；
+     bit5(32) 只压增益 c1[2] 0.06→0.045（对照臂：把「症状级电平」与「换算式」分开计量）。
+   另有一条字符串开关 `smo_m73a_p = "A B gain [c4_0 c4_1]"`：非空就覆盖上面的 A/B/gain（给了后两项再覆盖 c4），
+   用来在**同一个 build** 里细扫 fog_near/far，不必为每一档再 build 一次。全 0 = 零日志、零分配、零行为变化。 */
+typedef struct { float A, B, gain, c40, c41; } m73p_t;
+static m73p_t g_m73p; static int g_m73a_lines;   // g_m73p = 当前生效的 5 个 float（vk_m73a_mode 每次重读时写）
+static void m73a_preset(int m, m73p_t *p) {   // 基线（c4 原样、A/B/gain 原值），再按 bit 叠
+    p->A = 33.331665f; p->B = -0.3333333f; p->gain = 0.06f; p->c40 = 0.f; p->c41 = 0.f;
+    if (m & 1)  { p->c40 = 0.9999f; p->c41 = 1e-4f; p->A = 16.665825f; }
+    if (m & 2)  { p->c40 = 0.9999f; p->c41 = 1e-4f; p->A = 5.555556f; p->B = -0.3888889f; }
+    if (m & 4)  { p->A = 26.666667f; p->B = -0.0666667f; }
+    if (m & 8)  { p->A = 0.30f; p->B = 0.f; }
+    if (m & 16) { p->c40 = 0.9999f; p->c41 = 1e-4f; p->A = 5.555556f; p->B = -0.3888889f; p->gain = 0.045f; }
+    if (m & 32) { p->gain = 0.045f; }
+}
+int vk_m73a_mode(void) {
+    static int v = -1, last = 0, have = 0; static m73p_t prev;
+    const long now = (long)time(NULL);
+    if (v >= 0 && now == last) return v;
+    last = now;
+    const char *e = getenv("DM_VK_M73A"); const int nv = e ? atoi(e) : 0;
+    const char *s = getenv("DM_VK_M73A_P");
+    float fv[5]; int nf = 0;
+    if (s && *s) { const char *q = s; while (*q && nf < 5) { char *end = NULL; const float x = (float)strtod(q, &end); if (end == q) break; fv[nf++] = x; q = end; } }
+    const int on = nv > 0 || nf >= 3 || vk_m74a_mode() != 0;   // M74A：只开 luma/末级时这条银行副本也要改道（A/B/gain 用游戏原值）
+    /* M75A：缺省 = M73A 最佳（A=1, B=0, gain=0.048）烘进代码。判据同 M74A 侧：「没给 bit 且字符串不够 3 个数」。
+       app 构造期把 smo_m73a_p 种成 "0" ⇒ 落在缺省；写满 3 个数（例：游戏原值 33.331665 -0.3333333 0.06）仍覆盖。 */
+    const int baked = (nv == 0 && nf < 3);
+    m73p_t p; m73a_preset(nv, &p);
+    if (baked) { p.A = 1.f; p.B = 0.f; p.gain = 0.048f; p.c40 = 0.f; p.c41 = 0.f; }   // M73A 最佳
+    if (nf >= 3) { p.A = fv[0]; p.B = fv[1]; p.gain = fv[2]; if (nf >= 5) { p.c40 = fv[3]; p.c41 = fv[4]; } }
+    if (!on) {
+        v = 0;
+        if (have) { have = 0; g_ubo_gen[1]++; VKLOG("[m73a-seg] off (DM_VK_M73A=0, no override): pass 71 reads the game's own constants again"); }
+        return 0;
+    }
+    v = nv > 0 ? nv : 64;   // 64 = 只用字符串覆盖（没有预设 bit）
+    g_m73p = p;             // ← 打补丁用的是这一份（少了这句，patch 会把 5 个 float 全写成 0 = 雾项整块熄掉）
+    if (!have || memcmp(&prev, &p, sizeof p)) {
+        have = 1; prev = p; g_ubo_gen[1]++;   // 变档要让 stage 1 的描述符重算（否则 set memo 会把上一档的 set 直接复给这一帧）
+        VKLOG("[m73a-seg] pass 71 FS constants: A=%g B=%g gain=%g c4=%s (source=%s bits=%d override=\"%s\"); every [m73a-*] line after this one belongs to this variant",
+              (double)p.A, (double)p.B, (double)p.gain, p.c40 > 0.f ? "patched(1-n/far,1/far)" : "game's",
+              baked ? "BAKED-DEFAULT" : (nv > 0 ? "bits" : "override"), nv, s && *s ? s : "");
+        if (baked) VKLOG("[m75a-bake] M73A best is now the DEFAULT: A=%g B=%g gain=%g c4=game's (no knob file / the seeded \"0\" both land here); write smo_m73a_p=\"A B gain [c4_0 c4_1]\" to override",
+                         (double)p.A, (double)p.B, (double)p.gain);
+    }
+    return v;
+}
+static int m73a_ubo_patch(int st, const vkshader_t *s, const dmsv_bind *b, VkDescriptorBufferInfo *bi) {
+    const int m = vk_m73a_mode(); if (!m || st != 1 || !s || s->key != M71A_FOG_FS) return 0;
+    const p_bind_buf *u = b->reg >= 0 && b->reg < 16 ? &S.ubo[st][b->reg] : NULL;
+    if (!u || !u->addr || u->size < 80) return 0;
+    void vk_ubd_read(uint64_t a, uint64_t n, uint8_t *dst);
+    float f[128]; const uint64_t nread = u->size < sizeof f ? u->size : sizeof f;
+    memset(f, 0, sizeof f); vk_ubd_read(u->addr, nread, (uint8_t *)f);
+    int o1 = -1, o2 = -1;   // c1[2]（0.06）与 c2[2]（33.3317）在银行里的字节偏移
+    if (m71a_near(f[4], 100.f) && m71a_near(f[7], 10000.f) && m71a_near(f[6], 0.06f) && m71a_near(f[8], 49.9975f) && m71a_near(f[10], 33.331665f) && m71a_near(f[11], -0.3333333f)) { o1 = 24; o2 = 40; }
+    else for (int i = 2; i < (int)(nread / 4) - 2; i++) {
+        if (o1 < 0 && m71a_near(f[i], 0.06f) && m71a_near(f[i - 2], 100.f) && m71a_near(f[i + 2], 10000.f)) o1 = i * 4;
+        if (o2 < 0 && m71a_near(f[i], 33.331665f) && m71a_near(f[i - 2], 49.9975f) && m71a_near(f[i + 2], -0.3333333f)) o2 = i * 4;
+    }
+    if (o1 < 0 || o2 < 0 || o2 + 32 > (int)nread) {
+        if (g_m73a_lines < 4) { g_m73a_lines++;
+            VKLOG("[m73a-miss] pass 71 bank=%#llx+%llu: c1[2]@%d c2[2]@%d are not where the pattern says; not patched (head floats %g %g %g %g | %g %g %g %g | %g %g %g %g)",
+                  (unsigned long long)u->addr, (unsigned long long)u->size, o1, o2,
+                  (double)f[0], (double)f[1], (double)f[2], (double)f[3], (double)f[4], (double)f[5], (double)f[6], (double)f[7], (double)f[8], (double)f[9], (double)f[10], (double)f[11]); }
+        return 0;
+    }
+    const int i2 = o2 / 4;   // c4[0]/c4[1] 紧跟 c3 之后 = c2 起点 + 24 B/+32 B；先按实测值验，不符就只改 t 曲线不动 c4
+    const int c4ok = (i2 + 7 < (int)(nread / 4)) && f[i2 + 6] > 0.98f && f[i2 + 6] < 1.01f && f[i2 + 7] > 1e-6f && f[i2 + 7] < 1e-3f;
+    const uint64_t n = u->size > 65536 ? 65536 : u->size; VkBuffer sb; VkDeviceSize so;
+    uint8_t *d = vk_scratch(n, V.props.limits.minUniformBufferOffsetAlignment, &sb, &so);
+    vk_ubd_read(u->addr, n, d);
+    float *pa = (float *)(d + o2), *pg = (float *)(d + o1);
+    const float oldA = pa[0], oldB = pa[1], oldG = *pg;
+    const float gain_final = g_m73p.gain * g_m74p.gainmul;   // M74A：在 M73A 的 gain 之上再乘（默认 1 = 不变）
+    pa[0] = g_m73p.A; pa[1] = g_m73p.B; *pg = gain_final;
+    if (g_m73p.c40 > 0.f && c4ok) { float *pc = (float *)(d + o2 + 24); pc[0] = g_m73p.c40; pc[1] = g_m73p.c41; }
+    /* M74A：luma = clamp(dot(col.rgba, c0[0..3]), 0, 1)。c0 就是这份银行的头 4 个 float（M70A 实测 (2.98912, 5.86610, 1.14478, −2)，
+       与 c1 的 100/0/0.06/10000 相邻）⇒ 缩 c0 只改 luma 项，t² 项与 col 都不动。先按实测值定位，不符再扫前 512 B。 */
+    const float kL = g_m74p.klum, kO = g_m74p.koff;
+    if (kL != 1.f || kO != 1.f) {
+        int o0 = -1;
+        if (m71a_near(f[0], 2.98912f) && m71a_near(f[1], 5.86610f) && m71a_near(f[2], 1.14478f) && m71a_near(f[3], -2.f)) o0 = 0;
+        else for (int i = 0; i + 3 < (int)(nread / 4) && i < 128; i++)
+            if (m71a_near(f[i], 2.98912f) && m71a_near(f[i + 1], 5.86610f) && m71a_near(f[i + 2], 1.14478f) && m71a_near(f[i + 3], -2.f)) { o0 = i * 4; break; }
+        if (o0 >= 0) {
+            float *p0 = (float *)(d + o0);
+            const float b0 = p0[0], b1 = p0[1], b2 = p0[2], b3 = p0[3];
+            p0[0] = b0 * kL; p0[1] = b1 * kL; p0[2] = b2 * kL; p0[3] = b3 * kO;
+            if (g_m74a_lines < 16) { g_m74a_lines++;
+                VKLOG("[m74a-luma] pass 71 FS %016llx bank=%#llx+%llu c0+%d: (%g %g %g %g) -> (%g %g %g %g) [x%g on rgb, x%g on the -2 offset] — luma = clamp(dot(col.rgba,c0),0,1); the t^2 term, col and every other pass are untouched",
+                      (unsigned long long)M71A_FOG_FS, (unsigned long long)u->addr, (unsigned long long)u->size, o0,
+                      (double)b0, (double)b1, (double)b2, (double)b3, (double)p0[0], (double)p0[1], (double)p0[2], (double)p0[3], (double)kL, (double)kO); }
+        } else if (g_m74a_lines < 16) { g_m74a_lines++;
+            VKLOG("[m74a-miss] pass 71 bank=%#llx: the c0 pattern (2.98912 5.86610 1.14478 -2) is not in the first 512 B; luma untouched (head floats %g %g %g %g)",
+                  (unsigned long long)u->addr, (double)f[0], (double)f[1], (double)f[2], (double)f[3]); }
+    }
+    bi->buffer = sb; bi->offset = so; bi->range = n;
+    if (g_m73a_lines < 64) { g_m73a_lines++;
+        VKLOG("[m73a-ubo] pass 71 FS %016llx bank=%#llx+%llu n=%llu: gain c1[2]+%d %g->%g, A c2[2]+%d %g->%g, B c2[3]+%d %g->%g, c4[0/1]+%d %s (c4 usable=%d) — this draw reads a patched copy; VS and every other pass untouched",
+              (unsigned long long)M71A_FOG_FS, (unsigned long long)u->addr, (unsigned long long)u->size, (unsigned long long)n,
+              o1, (double)oldG, (double)gain_final, o2, (double)oldA, (double)g_m73p.A, o2 + 4, (double)oldB, (double)g_m73p.B,
+              o2 + 24, g_m73p.c40 > 0.f ? (c4ok ? "patched" : "WANTED but pattern off") : "game's", c4ok); }
+    if (g_m73a_lines < 64 && g_m73p.c40 > 0.f && c4ok) { g_m73a_lines++;
+        VKLOG("[m73a-c4] pass 71 FS %016llx: c4[0] %g->%g, c4[1] %g->%g (the hyperbolic inversion is now 1/(1-d*c4[0])*c4[1], then A/B above)",
+              (unsigned long long)M71A_FOG_FS, (double)f[i2 + 6], (double)g_m73p.c40, (double)f[i2 + 7], (double)g_m73p.c41); }
+    return 1;
+}
