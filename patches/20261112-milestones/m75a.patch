+    if (!bpp || g_m70acp_n >= M70ACP_MAX) return 0;
+    const VkDeviceSize n = (VkDeviceSize)im->w * im->h * bpp;
+    if (n > ((VkDeviceSize)256 << 20)) return 0;
+    m70acp_t *d = &g_m70acp[g_m70acp_n]; memset(d, 0, sizeof *d);
+    d->w = im->w; d->h = im->h; d->f = im->fmt; d->bpp = bpp; d->pass = g_sub_pass - 1; d->present = g_tex_frame;
