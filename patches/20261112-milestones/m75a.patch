+typedef struct { VkBuffer b; VkDeviceMemory m; void *p; uint32_t w, h; VkFormat f; uint32_t bpp; int pass; uint64_t present, fence, pool; int64_t off; } m70acp_t;
+static m70acp_t g_m70acp[M70ACP_MAX]; static int g_m70acp_n;
+static int g_m70a_copies, g_m70a_frames, g_m70a_last_pass = -1, g_m70a_detail_frames, g_m70a_draws_in_pass;
+static int g_m70a_armed, g_m70a_arm_pass, g_m70a_arm_pw, g_m70a_arm_ph;
+static uint64_t g_m70a_arm_pool; static int64_t g_m70a_arm_off = -1;
+static float g_m70a_armed_nw;
+static int g_m70a_cand_ok, g_m70a_cand_pass; static float g_m70a_cand_nw;
