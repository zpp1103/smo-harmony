+    if (g_m71a_ubo_lines < 8) { g_m71a_ubo_lines++;
+        VKLOG("[m71a-ubo] pass 71 FS %016llx bank=%#llx+%llu n=%llu: c1[2] +%d %g->%g, c2[2] +%d %g->%g (this draw reads a patched copy; no other pass/stage is touched)",
+              (unsigned long long)M71A_FOG_FS, (unsigned long long)u->addr, (unsigned long long)u->size, (unsigned long long)n,
+              o1, (double)v1, (double)(want1 && o1 >= 0 ? v1 * 0.5f : v1), o2, (double)v2, (double)(want2 && o2 >= 0 ? v2 * 0.5f : v2)); }
