+    for (int gy = 0; gy < 8 && k < (int)sizeof grid - 8; gy++) { if (gy) grid[k++] = '/'; for (int gx = 0; gx < 8 && k < (int)sizeof grid - 6; gx++) {
+        const int ci = gy * 8 + gx; const int pc = ctot[ci] ? (int)(100.0 * (double)cnw[ci] / (double)ctot[ci] + .5) : 0;
+        k += snprintf(grid + k, sizeof grid - (size_t)k, "%s%d", gx ? "," : "", pc); } }
+    grid[k] = 0;
+    const double pct = np > 0 ? 100.0 * (double)nw / np : 0.0;
+    VKLOG("[m70a-nw] f=%llu p=%d %ux%u fmt=%d col=%#llx+%#llx: nearwhite(>=250)=%.2f%% ge240=%.2f%% mean(R)=%.1f R=%.1f G=%.1f B=%.1f max=%.1f draws=%llu ncol=%d grid=%s",
+          (unsigned long long)d->present, d->pass, d->w, d->h, (int)d->f, (unsigned long long)d->pool, (unsigned long long)d->off,
+          pct, np > 0 ? 100.0 * (double)ge / np : 0.0, np > 0 ? sr / np : 0.0, np > 0 ? sr / np : 0.0, np > 0 ? sg / np : 0.0, np > 0 ? sb / np : 0.0, mx,
+          (unsigned long long)g_pass_draws, S.ncol, grid);
+    /* 武装候选：一帧里最早出现「左右两侧都有近白格」的那条 pass（白斑的形态判据），面积已由 copy 条件保证 > 256×256 */
+    if (pct >= (double)m70a_ienv("DM_VK_M70A_NW", 15) / 10.0) {
+        int nl = 0, nr = 0, nm = 0;   // 白斑形态：左三分之一与右三分之一都有近白格，而中间两列基本不白（两团分开）
+        for (int gy = 0; gy < 8; gy++) for (int gx = 0; gx < 8; gx++) { const int ci = gy * 8 + gx;
+            const int pc = ctot[ci] ? (int)(100.0 * (double)cnw[ci] / (double)ctot[ci] + .5) : 0;
+            if (pc >= 60) { if (gx < 3) nl++; else if (gx > 4) nr++; else nm++; } }
+        if (nl >= 3 && nr >= 3 && nm * 2 <= nl + nr && (!g_m70a_cand_ok || d->pass < g_m70a_cand_pass)) {
+            g_m70a_cand_ok = 1; g_m70a_cand_pass = d->pass; g_m70a_cand_nw = (float)pct; g_m70a_cand_w = d->w; g_m70a_cand_h = d->h;
+            g_m70a_cand_pool = d->pool; g_m70a_cand_off = d->off;
+            VKLOG("[m70a-cand] f=%llu p=%d %ux%u fmt=%d col=%#llx+%#llx: nearwhite %.2f%%, white cells left=%d right=%d middle=%d (blob signature)",
+                  (unsigned long long)d->present, d->pass, d->w, d->h, (int)d->f, (unsigned long long)d->pool, (unsigned long long)d->off, pct, nl, nr, nm);
+        }
+    }
+}
+static void m70a_poll(uint64_t done_fence) {   // 只读已完成的 copy（与 M66A 同一条规则：先读完再释放）
+    if (g_m70acp_n <= 0) return;
+    for (int i = 0; i < g_m70acp_n; i++) {
+        m70acp_t *d = &g_m70acp[i];
+        if (!d->b || done_fence < d->fence) continue;
+        m70a_stats(d);
+        vkDestroyBuffer(V.dev, d->b, NULL); vkFreeMemory(V.dev, d->m, NULL);
+        d->b = VK_NULL_HANDLE; d->m = VK_NULL_HANDLE; d->p = NULL;
+    }
+    { int q = 0; for (int i = 0; i < g_m70acp_n; i++) if (g_m70acp[i].b) g_m70acp[q++] = g_m70acp[i]; g_m70acp_n = q; }
+}
+static int m70a_copy(vkimg_t *im) {   // 颜色目标 → host-visible buffer（transfer copy，与 passdump 同一条路径）
+    if (!im || !im->img || !im->w || !im->h) return 0;
