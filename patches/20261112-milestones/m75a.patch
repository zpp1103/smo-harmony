+static int m70a_ienv(const char *k, int def) { const char *e = getenv(k); return (e && *e) ? atoi(e) : def; }
+static unsigned m70a_bpp(VkFormat f) {   // 颜色目标一个 texel 的字节数（不认识的格式返回 0 = 不 copy）
