+            const int isw = (r >= 250.0 && g >= 250.0 && b >= 250.0);
+            if (isw) nw++; if (r >= 240.0 || g >= 240.0 || b >= 240.0) ge++;
+            const int cell = gy * 8 + (int)((uint64_t)x * 8 / d->w); ctot[cell]++; if (isw) cnw[cell]++;
+        }
+    }
