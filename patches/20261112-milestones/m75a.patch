+// ============================ M74A：清掉剩余白斑的第二来源——`luma`（c0 点积亮通道）+ 末级累加归一化（默认关；smo_m74a → DM_VK_M74A）============================
+/* 派活单（2026-11-12 12:26）：M73A 已把 t 连续化（t=1 38.71%→0%）并把斑区 nearwhite 压 −53.4%，但 **t≡0 参考档的斑区仍有 12.79%**
+   ⇒ 剩下的白不来自 t，而来自同一条 FS 的第二项 **luma**：
+     out.rgb = col.rgb · c1[2] · (t² + luma)，luma = clamp(dot(col.rgba, c0[0..3]), 0, 1)
+   c0 = 这份 65536 B 常量银行的**头 4 个 float** = (2.98912, 5.86610, 1.14478, −2)（M70A `[m69a-ubo]` 实测，紧邻 c1 的 100/0/0.06/10000）：
+   前三个正好是 Rec.601 亮度系数的 10 倍（0.2989/0.5866/0.1145 × 10），第 4 个 −2 是常数偏置 ⇒
+   **luma = clamp(10·L601(col) − 2, 0, 1)** = 「亮度 0.2 以上开始亮、0.3 以上饱和」的**纯颜色**掩码，与深度/t 完全无关
+   ⇒ 无论 t 怎么标定，它都把亮像素原样加进雾项，再被下游 8 级未归一化累加放大。
+   本块只动 **pass 71 那一份常量银行副本**里的 c0（与 M73A 共用 `m73a_ubo_patch` 的同一个落点，不新增描述符改道、不碰别的 pass）：
+     klum    = c0[0..2] 的缩放（压 luma 的主体）
+     koff    = c0[3]（−2 偏置）的缩放（=1 时阈值不动、只把「亮」的幅度压低；=klum 时是整体等比缩，连阈值一起抬）
+     gainmul = 乘在 c1[2] 上（在 M73A 档的 gain 之上再乘）
+     bc      = 末级（25×14 那一级 = 累加链最后一级）输出的等比例压缩系数（复用 M71A bit3 已验证的 blend-constant 通道）
+   预设 = smo_m74a 的 bit（2 s 热切；每次变档打一行 [m74a-seg]）：
+     bit0(1)  luma×0.5（只缩权重：klum=0.5, koff=1）
+     bit1(2)  luma×0.25（klum=0.25, koff=1）
+     bit2(4)  luma=0（klum=0 ⇒ dot 恒 −2 ⇒ clamp 到 0；**探边界，不许当选**）
+     bit3(8)  增益 1/8（gainmul=0.125 = 派活单允许的「只压 71 的 c1[2] 到 gain/8」）
+     bit4(16) 末级归一化（bc=0.55）
+     bit5(32) luma 整体等比×0.5（klum=koff=0.5，连阈值一起抬 ⇒ 与 bit0 的差别就是「饱和区也真的减半」）
+   字符串 `smo_m74a_p = "klum [koff [gainmul [bc [bc2]]]]"` 覆盖上面的数值（同一 build 里细扫，不必再 build）。
+   ---- M75A（2026-11-12 13:45）三处改动 ----
+   ① **阻断项修复**：`on = nv>0 || nf>=1` → `nf>=2`；`if (nf>=1) klum=fv[0]` → `if (nf>=2) {klum=fv[0]; koff=fv[1];}`。
+      原因：app 构造期 `m48a_seed_files()` 把 smo_m74a_p 种成 "0"，旧判据把「单个 0」当覆盖 ⇒ klum=0 = 熄掉 luma = 关雾；
+      修后「写 0」与「文件不存在」同解（都落缺省）。
+   ② **烘默认**：缺省（没给 bit 且字符串不足 2 个数）= M74A 最佳 `klum=1 koff=1 gainmul=0.80 bc=0.55`，hardcode 在下面；
+      与 M73A 侧的缺省 `A=1 B=0 gain=0.048` 合用 = M73A+M74A 最佳态。写 ≥2 个数仍覆盖。
+   ③ **可选第二级 bc2**（第 5 个数 / bit6=64）：把 12×7（81..83）那一级的输出再等比压一次，热切即可测。
+   旧行为**逐字节**回退：`smo_m73a_p="33.331665 -0.3333333 0.06"`（游戏原值）+ `smo_m74a_p="1 1 1 1"`（bc 归一化成「通道关」）+ `smo_m74a=0`。
+   真正的「全关」不再存在（缺省就是修好的画面）；要回到未修的雾必须写上面那组游戏原值。 */
+typedef struct { float klum, koff, gainmul, bc, bc2; } m74p_t;
+static m74p_t g_m74p = {1.f, 1.f, 0.80f, 0.55f, 0.f};   // 生效值（vk_m74a_mode 每次重读时写）= M75A 烘入的缺省（M74A 最佳）
+static int g_m74a_lines;
+float m74a_bconst(void) { return g_m74p.bc; }
+float m74a_bconst2(void) { return g_m74p.bc2; }
+int vk_m74a_mode(void) {
+    static int v = -1; static long last = 0; static m74p_t prev; static int have;
+    const long now = (long)time(NULL);
+    if (v >= 0 && now == last) return v;
+    last = now;
+    const char *e = getenv("DM_VK_M74A"); const int nv = e ? atoi(e) : 0;
+    const char *s = getenv("DM_VK_M74A_P");
+    float fv[5]; int nf = 0;
+    if (s && *s) { const char *q = s; while (*q && nf < 5) { char *end = NULL; const float x = (float)strtod(q, &end); if (end == q) break; fv[nf++] = x; q = end; } }
+    /* M75A：缺省 = M74A 最佳（klum=1 koff=1 gainmul=0.80 bc=0.55）**烘进代码**。
+       判据 = 「没给 bit（nv==0）且字符串不够 2 个数」⇒ 用烘入值。app 构造期会把 smo_m74a_p 种成 "0"
+       （单个 0 = 1 个数）⇒ 落到缺省，这正是修掉 M74A §4 那个阻断项的地方：
+         on   : nv > 0 || nf >= 1   ->  nv > 0 || nf >= 2
+         klum : if (nf >= 1) fv[0]  ->  if (nf >= 2) { klum=fv[0]; koff=fv[1]; }
+       于是「写 0」与「文件不存在」等价（都解成缺省），而写满 ≥2 个数仍覆盖；
+       旧行为逐字节回退 = smo_m73a_p 写回游戏原值 + smo_m74a_p="1 1 1 1"（bc=1 走下面的归一化 = 通道关）。 */
+    const int baked = (nv == 0 && nf < 2);
+    m74p_t p; p.klum = 1.f; p.koff = 1.f; p.gainmul = 1.f; p.bc = 0.f; p.bc2 = 0.f;
+    if (baked) { p.gainmul = 0.80f; p.bc = 0.55f; }     // M74A 最佳（luma 权重不动 = 1,1）
+    if (nv & 1)  { p.klum = 0.5f;  p.koff = 1.f; }    // 顺序 = 后写的覆盖前面的：bit2 的 luma=0 最强
+    if (nv & 2)  { p.klum = 0.25f; p.koff = 1.f; }
+    if (nv & 32) { p.klum = 0.5f;  p.koff = 0.5f; }
+    if (nv & 4)  { p.klum = 0.f;   p.koff = 1.f; }
+    if (nv & 8)  { p.gainmul = 0.125f; }
+    if (nv & 16) { p.bc = 0.55f; }
+    if (nv & 64) { p.bc2 = 0.55f; }                    // bit6 = 第二级（12×7 那一级）等比压缩（M75A 可选档）
+    if (nf >= 2) { p.klum = fv[0]; p.koff = fv[1]; }   // M75A 阻断项修法：单值（含被种进去的 "0"）不再当覆盖
+    if (nf >= 3) p.gainmul = fv[2];
+    if (nf >= 4) p.bc = fv[3];
+    if (nf >= 5) p.bc2 = fv[4];
+    if (p.bc >= 0.999f) p.bc = 0.f;    // 1.0 = 恒等 ⇒ 当作「通道关」，保证旧行为回退不多走一条 blend 路径
+    if (p.bc2 >= 0.999f) p.bc2 = 0.f;
+    const int on = nv > 0 || nf >= 2 || baked;
+    g_m74p = p;
+    v = on ? (nv > 0 ? nv : 64) : 0;
+    if (on && (!have || memcmp(&prev, &p, sizeof p))) {
+        have = 1; prev = p; g_ubo_gen[1]++;   // 变档要让 stage 1 的描述符重算（否则 set memo 会把上一档的 set 直接复给这一帧）
+        VKLOG("[m74a-seg] pass 71 luma: c0[0..2] x%g, c0[3] x%g, gain x%g, last-level bc=%g, 12x7 bc2=%g (source=%s bits=%d override=\"%s\"); every [m74a-*] line after this one belongs to this variant",
+              (double)p.klum, (double)p.koff, (double)p.gainmul, (double)p.bc, (double)p.bc2,
+              baked ? "BAKED-DEFAULT" : (nv > 0 ? "bits" : "override"), nv, s && *s ? s : "");
+        if (baked) VKLOG("[m75a-bake] M74A best is now the DEFAULT: klum=%g koff=%g gainmul=%g bc=%g (no knob file / the seeded \"0\" both land here); write smo_m74a_p=\"klum koff gainmul bc [bc2]\" to override",
+                         (double)p.klum, (double)p.koff, (double)p.gainmul, (double)p.bc);
+    } else if (!on && have) {
+        have = 0; g_ubo_gen[1]++;
+        VKLOG("[m74a-seg] off (DM_VK_M74A=0, no override): pass 71 keeps the game's own luma weights, no last-level compression");
+    }
+    return v;
+}
