+#define M68B_KN_A   P_SLOT_DIR_A "/smo_m67b"   /* 与 M67B 同一开关文件：bit4=16 上屏泵，bit5=32 泵心跳 */
+#define M68B_KN_B   P_SLOT_DIR_B "/smo_m67b"
+#define M68B_MS_A   P_SLOT_DIR_A "/smo_m68b_pump_ms"
+#define M68B_MS_B   P_SLOT_DIR_B "/smo_m68b_pump_ms"
+#define M68B_NICE_A P_SLOT_DIR_A "/smo_m68b_pump_nice"
+#define M68B_NICE_B P_SLOT_DIR_B "/smo_m68b_pump_nice"
+
+static _Atomic int      g_m68b_run;    /* 1 = 泵线程继续跑（退出标志） */
+static _Atomic int      g_m68b_main;   /* 1 = 主线程在 present 的「拷贝→写屏」段里 */
+static _Atomic unsigned g_m68b_gen;    /* 已完成帧序号（0 = 还没有可泵的帧） */
+static _Atomic unsigned g_m68b_sw, g_m68b_sh;
+static _Atomic int      g_m68b_owner;  /* 0 空 / 1 泵 / 2 主线程（CAS，零等待） */
+static volatile int     g_m68b_live;   /* 线程活着：心跳线程写，present 线程只读 */
+static pthread_t        g_m68b_th;
+static unsigned         g_m68b_ms = 16;
+static int              g_m68b_nice;
+static unsigned long long g_m68b_pump_ok, g_m68b_pump_fail, g_m68b_skip_main, g_m68b_skip_win,
+                          g_m68b_nosrc, g_m68b_torn, g_m68b_collide, g_m68b_iters;
+
+static int m68b_tid(void)   /* 日志用真线程 id（musl 下 syscall(__NR_gettid)，非 musl 退 getpid） */
+{
+#ifdef __MUSL__
+    return (int)syscall(__NR_gettid);
+#else
+    return (int)getpid();
+#endif
+}
