+/* ---- 主线程侧三个钩子：全部由 g_m68b_live 包住（bit4=0 ⇒ 只多一次 volatile 读）---- */
+static void m68b_main_enter(void) { if (g_m68b_live) atomic_store_explicit(&g_m68b_main, 1, memory_order_release); }
+static void m68b_main_leave(void) { if (g_m68b_live) atomic_store_explicit(&g_m68b_main, 0, memory_order_release); }
+static void m68b_publish(unsigned w, unsigned h)
+{
+    if (!g_m68b_live) return;
+    atomic_store_explicit(&g_m68b_sw, w, memory_order_relaxed);
+    atomic_store_explicit(&g_m68b_sh, h, memory_order_relaxed);
+    atomic_fetch_add_explicit(&g_m68b_gen, 1u, memory_order_release);   /* release：先像素、后序号 */
+}
+static int  m68b_win_claim(int who)
+{
+    int e = 0;
+    return (int)atomic_compare_exchange_strong_explicit(&g_m68b_owner, &e, who,
+                                                        memory_order_acq_rel, memory_order_relaxed);
 }
+static void m68b_win_release(void) { atomic_store_explicit(&g_m68b_owner, 0, memory_order_release); }
 
+/* ---- 泵线程：每 g_m68b_ms 尝试一次；上一帧没完成/主线程在写屏 → 本周期跳过，不排队 ---- */
+static void *m68b_pump_main(void *arg)
+{
+    (void)arg;
+    __attribute__((weak)) int nvn_win_present_rgba(void *, const void *, int, int, int);
+    if (g_m68b_nice) setpriority(PRIO_PROCESS, 0, g_m68b_nice);
+    vk_boot_logf("[m68b-pump] start tid=%d ms=%u nice=%d map=%s win=%p blit=%s",
+                 m68b_tid(), g_m68b_ms, g_m68b_nice, g_p_map ? "mapped" : "lazy", g_win,
+                 nvn_win_present_rgba ? "yes" : "nosym");
+    while (atomic_load_explicit(&g_m68b_run, memory_order_relaxed)) {
+        g_m68b_iters++;
+        const unsigned gen = atomic_load_explicit(&g_m68b_gen, memory_order_acquire);
+        if (atomic_load_explicit(&g_m68b_main, memory_order_acquire)) {
+            g_m68b_skip_main++;                         /* 主线程正在拷贝/写屏：本周期什么都不做 */
+        } else if (!nvn_win_present_rgba || !g_p_map || !g_win || !gen) {
+            g_m68b_nosrc++;                             /* 还没有可泵的帧（或符号/窗口缺失） */
+        } else if ((m80a_bits() & 2) &&
+                   (gen == g_m80a_pump_gen ||
+                    gen <= atomic_load_explicit(&g_m80a_main_gen, memory_order_acquire))) {
+            g_m80a_pump_skip++;                         /* M80A 按需：这帧已推过 / 主线程自己写过了 */
+        } else if (!m68b_win_claim(1)) {
+            g_m68b_skip_win++;                          /* 主线程刚抢到窗口：让开 */
+        } else {
+            const int w = (int)atomic_load_explicit(&g_m68b_sw, memory_order_relaxed);
+            const int h = (int)atomic_load_explicit(&g_m68b_sh, memory_order_relaxed);
+            const int ok = (w > 0 && h > 0) ? nvn_win_present_rgba(g_win, g_p_map, w, h, w * 4) : 0;
+            m68b_win_release();
+            if (ok) { g_m68b_pump_ok++; g_m80a_pump_gen = gen; } else g_m68b_pump_fail++;
