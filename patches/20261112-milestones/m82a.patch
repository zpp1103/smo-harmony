+/* ---- 心跳钩子（vk_boot.c 的 beat_thread 每 2 s 调一次）：
+   ① 直读 smo_m67b 看 bit4 ⇒ 起/停泵（2 s 内响应 hdc 改位）；② bit4 在跑时热更周期；③ 每 20 s 一行 st。
+   bit4=0 且从未起过泵 ⇒ 只有一次文件读 + 两个整数比较，零输出（与 M67B 关态空转同款）。 ---- */
+void nvn_vk_m68b_pump_tick(unsigned tsec, unsigned long frames)
+{
+    static unsigned last_stat;
+    const int v = p_file_int(M68B_KN_A, M68B_KN_B, 0);   /* 直读：hdc 覆盖 2 s 内生效（同 smo_m40c 节奏） */
+    const int want = (v & 16) != 0;
+    if (want && !g_m68b_live) {
+        g_m68b_ms = (unsigned)p_file_int(M68B_MS_A, M68B_MS_B, 16);
+        if ((int)g_m68b_ms < 4) g_m68b_ms = 4;
+        if (g_m68b_ms > 1000) g_m68b_ms = 1000;
+        if (m80a_bits() & 2) {                             /* M80A bit1：泵按需 —— 周期不短于 33 ms */
+            if (g_m68b_ms < 33u) g_m68b_ms = 33u;
+            vk_boot_logf("[m80a] pump on-demand: ms=%u (bit1=1, 只推新帧/不覆盖主线程)", g_m68b_ms);
+        }
+        g_m68b_nice = p_file_int(M68B_NICE_A, M68B_NICE_B, 0);
+        if (g_m68b_nice < -20) g_m68b_nice = -20;
+        if (g_m68b_nice > 19) g_m68b_nice = 19;
+        atomic_store_explicit(&g_m68b_run, 1, memory_order_relaxed);
+        g_m68b_live = 1;                                   /* 先置活：泵首轮就能看到 run=1 */
+        if (pthread_create(&g_m68b_th, NULL, m68b_pump_main, NULL) != 0) {
+            g_m68b_live = 0;
+            atomic_store_explicit(&g_m68b_run, 0, memory_order_relaxed);
+            vk_boot_logf("[m68b-pump] fail stage=create errno=%d knob=%d t=%us", errno, v, tsec);
+        } else {
+            vk_boot_logf("[m68b-pump] enabled knob=%d bit4=1 ms=%u nice=%d t=%us", v, g_m68b_ms, g_m68b_nice, tsec);
+        }
+    } else if (!want && g_m68b_live) {
+        atomic_store_explicit(&g_m68b_run, 0, memory_order_relaxed);
+        pthread_join(g_m68b_th, NULL);                     /* 不 detach：这里等着它退干净 */
+        g_m68b_live = 0;
+        vk_boot_logf("[m68b-pump] disabled knob=%d iters=%llu pump=%llu fail=%llu t=%us", v,
+                     g_m68b_iters, g_m68b_pump_ok, g_m68b_pump_fail, tsec);
+    }
+    if (!g_m68b_live) return;
+    {   /* 周期热更新（每 2 s 一次文件读）：ms 变更下一轮生效 */
+        const unsigned ms2 = (unsigned)p_file_int(M68B_MS_A, M68B_MS_B, (int)g_m68b_ms);
+        if (ms2 >= 4 && ms2 <= 1000) g_m68b_ms = ms2;
+        if ((m80a_bits() & 2) && g_m68b_ms < 33u) g_m68b_ms = 33u;   /* M80A：按需下限 33 ms */
+    }
+    if ((int)(tsec - last_stat) < 20) return;
+    last_stat = tsec;
+    if (v & 32)   /* bit5：追加排查字段 */
+        vk_boot_logf("[m68b-pump] st t=%us frames=%lu on=1 ms=%u gen=%u pump=%llu fail=%llu "
+                     "skip_main=%llu skip_win=%llu nosrc=%llu torn=%llu collide=%llu iters=%llu win=%p",
+                     tsec, frames, g_m68b_ms, atomic_load_explicit(&g_m68b_gen, memory_order_relaxed),
+                     g_m68b_pump_ok, g_m68b_pump_fail, g_m68b_skip_main, g_m68b_skip_win,
+                     g_m68b_nosrc, g_m68b_torn, g_m68b_collide, g_m68b_iters, g_win);
+    else
+        vk_boot_logf("[m68b-pump] st t=%us frames=%lu on=1 ms=%u gen=%u pump=%llu fail=%llu",
+                     tsec, frames, g_m68b_ms, atomic_load_explicit(&g_m68b_gen, memory_order_relaxed),
+                     g_m68b_pump_ok, g_m68b_pump_fail);
+}
