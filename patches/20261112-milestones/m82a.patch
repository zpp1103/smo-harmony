+    }
+    vk_boot_logf("[m68b-pump] exit tid=%d iters=%llu pump=%llu fail=%llu", m68b_tid(),
+                 g_m68b_iters, g_m68b_pump_ok, g_m68b_pump_fail);
+    return NULL;
+}
