+/* 找 a 所在的 VMA（/proc/self/maps；小 ring 缓存，避免每次绑定都解析）。0 = 找不到（未映射/权限外）。 */
+static int m82a_vma_find(uint64_t a, m82a_vma *out)
+{
+    for (unsigned i = 0; i < g_m82a_vcn && i < 8u; i++)
+        if (a >= g_m82a_vc[i].lo && a < g_m82a_vc[i].hi) { if (out) *out = g_m82a_vc[i]; return 1; }
+    FILE *f = fopen("/proc/self/maps", "r");
+    if (!f) return 0;
+    char line[400];
+    while (fgets(line, sizeof line, f)) {
+        unsigned long long lo = 0, hi = 0; char perms[8]; perms[0] = 0;
+        if (sscanf(line, "%llx-%llx %7s", &lo, &hi, perms) != 3) continue;
+        if (a < lo || a >= hi) continue;
+        m82a_vma v; v.lo = lo; v.hi = hi; memcpy(v.perms, perms, 5); v.perms[4] = 0;
+        g_m82a_vc[g_m82a_vcn & 7u] = v; g_m82a_vcn++;
+        fclose(f);
+        if (out) *out = v;
+        return 1;
+    }
+    fclose(f);
+    return 0;
+}
+/* VMA 钳位 + 按页容错读。返回真正读进 dst 的字节数（0..len）。got_flat 非 NULL 时回填"平读"结果，
+   clamped 非 NULL 时回填钳位后的长度。**不 memset dst**（尾部清零由调用方按 cp 做）。 */
+static uint32_t m82a_read(uint8_t *dst, uint64_t addr, uint32_t len, uint32_t *got_flat,
+                          uint32_t *clamped_to)
+{
+    if (!dst || !len) return 0;
+    uint32_t want = len;
+    m82a_vma v;
+    if (m82a_vma_find(addr, &v) && addr < v.hi && (uint64_t)addr + want > v.hi) {
+        want = (uint32_t)(v.hi - addr);
+        g_m82a_clamped++;
+    }
+    if (clamped_to) *clamped_to = want;
+    uint32_t total = r_guest_copy(dst, addr, want);      /* 平读（旧口径），命中即完事 */
+    if (got_flat) *got_flat = total;
+    if (total < want) {                                  /* 兜底：按页切块，保住已读前缀 */
+        while (total < want) {
+            uint64_t a = addr + total;
+            uint32_t chunk = 0x1000u - (uint32_t)(a & 0xFFFu);
+            if (chunk > want - total) chunk = want - total;
+            uint32_t n = r_guest_copy(dst + total, a, chunk);
+            if (!n) break;
+            total += n;
+            if (n < chunk) break;
+        }
+        if (total) g_m82a_partial++; else g_m82a_fail++;
+    }
+    g_m82a_bytes += total;
+    return total;
+}
+/* bit1 探针：一条小绑定一行（平读 / 按页读 / 原始 readv 的字节数 + errno + maps 行 + stage/idx）。 */
+static void m82a_probe(int si, int idx, uint64_t addr, uint32_t sz, uint32_t got_used, uint32_t got_flat)
+{
+    if (g_m82a_probe_n >= 16) return;
+    g_m82a_probe_n++;
+    m82a_vma v; int hv = m82a_vma_find(addr, &v);
+    uint32_t want = R_UBO_MIN_SLOT;
+    if (hv && addr < v.hi && (uint64_t)addr + want > v.hi) want = (uint32_t)(v.hi - addr);
+    errno = 0;
+    struct iovec l = { g_m82a_scratch, want }, r = { (void *)(uintptr_t)addr, want };
+    ssize_t nraw = syscall(__NR_process_vm_readv, getpid(), &l, 1ul, &r, 1ul, 0ul);
+    int eraw = errno;
+    uint32_t paged = 0; { uint32_t t = 0;
+        while (t < want) {
+            uint64_t a = addr + t;
+            uint32_t chunk = 0x1000u - (uint32_t)(a & 0xFFFu);
+            if (chunk > want - t) chunk = want - t;
+            uint32_t n = r_guest_copy(g_m82a_scratch + t, a, chunk);
+            if (!n) break;
+            t += n;
+            if (n < chunk) break;
+        }
+        paged = t; }
+    vk_boot_logf("[m82a] probe#%u st=%d idx=%d addr=%#llx sz=%u win=%u flat=%u paged=%u raw=%d "
+                 "errno=%d(%s) want=%u vma=%s[%#llx,%#llx) perms=%s",
+                 g_m82a_probe_n, si, idx, (unsigned long long)addr, sz, got_used, got_flat, paged,
+                 (int)nraw, eraw, strerror(eraw ? eraw : 0), want,
+                 hv ? "" : "none", (unsigned long long)(hv ? v.lo : 0), (unsigned long long)(hv ? v.hi : 0),
+                 hv ? v.perms : "-");
+}
