+static void m80a_seed(void)   /* 缺省种 0（**不是** p_file_seed 的 -1：-1 会被当成「全位开」） */
+{
+    const char *p[2] = { M80A_A, M80A_B };
+    for (int i = 0; i < 2; i++) { FILE *f = fopen(p[i], "r"); if (f) { fclose(f); return; } }
+    for (int i = 0; i < 2; i++) {
