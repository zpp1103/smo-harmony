+        g_pkey[g_pkey_n].key = key; g_pkey[g_pkey_n].n1c = !is1d; g_pkey[g_pkey_n].n1d = !!is1d;
+        g_pkey[g_pkey_n].caller = is1d ? caller : 0; g_pkey_n++;
+        return;
+    }
+    if (is1d) g_ovf1d++; else g_ovf1c++;
