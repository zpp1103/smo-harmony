+/* 开关文件必须由 app 自己先创建（hdc 在沙箱里建不出新文件）：缺省写 0 = 关。
+   每 2 s 重读；值变化立刻打 `sw knob -> val=`，未变化也每 10 s 打一行同格式心跳
+   （M104A 教训：knob 未生效被当成实验结果 ⇒ 必须能在 30 s 内从日志看到生效）。 */
+static int m105a_knob(void)
+{
+    const double t = r_now_ms();
+    if (g_m105a_v == -2) {
+        const char *p[2] = { M105A_A, M105A_B };
+        int have = 0, i;
+        for (i = 0; i < 2 && !have; i++) { FILE *f = fopen(p[i], "r"); if (f) { fclose(f); have = 1; } }
+        for (i = 0; i < 2 && !have; i++) {
+            FILE *f = fopen(p[i], "w");
+            if (f) { fputs("0\n", f); fclose(f); have = 1; }
+        }
+        g_m105a_v = p_file_int(M105A_A, M105A_B, 0);
+        g_m105a_kt = t; g_m105a_klog = t;
+        vk_boot_logf("[m105a] sw knob -> val=%d (seed)", g_m105a_v);
+        return g_m105a_v;
+    }
+    if (t - g_m105a_kt >= 2000.0) {
+        const int v = p_file_int(M105A_A, M105A_B, 0);
+        g_m105a_kt = t;
+        if (v != g_m105a_v) {
+            g_m105a_v = v; g_m105a_klog = t;
+            vk_boot_logf("[m105a] sw knob -> val=%d", g_m105a_v);
+        } else if (t - g_m105a_klog >= 10000.0) {
+            g_m105a_klog = t;
+            vk_boot_logf("[m105a] sw knob -> val=%d", g_m105a_v);
+        }
+    }
+    return g_m105a_v;
+}
