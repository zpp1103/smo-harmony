+/* ================= M105A（present 侧）：帧切分 + judge + 内容签名 + 窗口槽学习 =================
+   present = 帧边界：把「上次 present 之后」的所有写该槽的 draw 按发生顺序切出来判一次。
+   judge（派活单 §2 的算法逐字实现）：
+     tex_first = 本帧第一条 real>=1 的写该槽 draw 的下标（-1 = 本帧没有带贴图笔写过它）；
+     last_fs/last_decl = 本帧末笔（未跳过）写该槽的 fs 键 / ntex_decl；
+     ovr = (tex_first>=0 && last_decl==0)；
+     yes = ovr && last_fs ∈ {0a25edc7…, 905cc547…} ⇒ 「最后覆盖 = YES」；
+     tex_first<0 ⇒ NO（带贴图 pass 根本不写最终 RT）。
+   内容签名直接引 M99A 的同一口径（spread>=8 && colored>=5% && mean<250 且非洋红）⇒ 判据③不另造指标。 */
+static void m105a_learn(int sel_slot)
+{
+    int i;
+    if (sel_slot >= 0 && sel_slot < H_RT_SLOTS) g_m105a_win[sel_slot] = 1;
+    for (i = 0; i < 4; i++) {
+        h_rt_slot *s = NULL;
+        const int si = g_win_key[i] ? p_slot_by_key(g_win_key[i], &s) : -1;
+        if (si >= 0 && si < H_RT_SLOTS) g_m105a_win[si] = 1;
+    }
+}
+
+static void m105a_frame(unsigned long long call, const char *srcname, int sel_slot, int ok)
+{
+    const int on = m105a_knob() >= 2;
+    const unsigned long long w = __atomic_load_n(&g_m105a_w, __ATOMIC_ACQUIRE);
+    unsigned long long r = g_m105a_rd, i, n, trunc = 0;
+    int nsel = 0, ntex = 0, tex_first = -1, last_decl = -1, ovr = 0, yes = 0;
+    char lastfs[17];
+    m105a_learn(sel_slot);
+    lastfs[0] = 0;
+    if (!on) {   /* 关态：只把游标推平，零输出（本帧 texmask 也要清，否则 knob 一开就带着旧位） */
+        g_m105a_rd = w;
+        memset(g_m105a_texmask, 0, sizeof g_m105a_texmask);
+        return;
+    }
+    if (w - r > (unsigned long long)M105A_RING) { trunc = (w - r) - (unsigned long long)M105A_RING; r = w - (unsigned long long)M105A_RING; }
+    n = w - r;
+    for (i = r; i < w; i++) {
+        const m105a_ent *e = &g_m105a_ring[(unsigned)(i % (unsigned long long)M105A_RING)];
+        if (e->sk) continue;
+        if ((int)e->slot == sel_slot) {
+            if (e->real >= 1 && tex_first < 0) tex_first = nsel;
+            nsel++;
+        }
+        if (e->real >= 1) ntex++;
+    }
+    for (i = w; i > r; i--) {   /* 末笔 = 最后一个写该槽的未跳过笔 */
+        const m105a_ent *e = &g_m105a_ring[(unsigned)((i - 1ull) % (unsigned long long)M105A_RING)];
+        if (e->sk || (int)e->slot != sel_slot) continue;
+        last_decl = (int)e->decl;
+        memcpy(lastfs, e->fs, sizeof lastfs);
+        break;
+    }
+    ovr = (tex_first >= 0 && last_decl == 0) ? 1 : 0;
+    yes = (ovr && (!strncmp(lastfs, "0a25edc7", 8) || !strncmp(lastfs, "905cc547", 8))) ? 1 : 0;
+    g_m105a_fno++;
+    if (yes) g_m105a_yes++;
+    else if (tex_first < 0) g_m105a_no++;
+    else g_m105a_empty++;
+    if (g_m105a_pf < M105A_FRAME_MAX && (g_m105a_fno <= 10ull || (g_m105a_fno % 60ull) == 0ull)) {
+        g_m105a_pf++;
+        vk_boot_logf("[m105a] f call=%llu src=%s sel=%d n=%llu nsel=%d ntex=%d tex_first=%d "
+                     "last_fs=%s last_decl=%d ovr=%d yes=%d trunc=%llu sk=%llu ok=%d",
+                     call, srcname ? srcname : "-", sel_slot, n, nsel, ntex, tex_first,
+                     lastfs[0] ? lastfs : "-", last_decl, ovr, yes, trunc, g_m105a_skip_n, ok);
+        {   /* 该槽的写入序列：≤16 行（>16 条时取前 8 + 后 8，另打一行 gap） */
+            m105a_ent head[8], tail[8];
+            int nh = 0, nt = 0, k, pos = 0;
+            int xs[8]; unsigned xc[8], xr[8]; char xf[8][17]; int nx = 0;
+            for (i = r; i < w; i++) {
+                const m105a_ent *e = &g_m105a_ring[(unsigned)(i % (unsigned long long)M105A_RING)];
+                if (e->sk) continue;
+                if ((int)e->slot != sel_slot) {
+                    if (e->real < 1) continue;
+                    for (k = 0; k < nx; k++) if (xs[k] == (int)e->slot) break;
+                    if (k == nx) { if (nx >= 8) continue; xs[nx] = (int)e->slot; xc[nx] = 0; xr[nx] = 0; xf[nx][0] = 0; nx++; }
+                    xc[k]++;
+                    if ((unsigned)e->real > xr[k]) xr[k] = (unsigned)e->real;
+                    if (!xf[k][0]) memcpy(xf[k], e->fs, sizeof xf[k]);
+                    continue;
+                }
+                if (nh < 8) head[nh++] = *e;
+                else { tail[nt % 8] = *e; nt++; }
+            }
+            for (k = 0; k < nh; k++) {
+                const m105a_ent *e = &head[k];
+                vk_boot_logf("[m105a] w i=%d seq=%llu dr=%llu p=%llx rp=%llx fs=%s decl=%d real=%d dv=%d "
+                             "nv=%u cnt=%u sk=%d",
+                             pos++, e->seq, e->dr, e->pso, e->rp, e->fs[0] ? e->fs : "-",
+                             (int)e->decl, (int)e->real, (int)e->dv, e->nv, e->cnt, (int)e->sk);
+            }
+            if (nt > 0) {
+                const int st = (nt > 8) ? (nt % 8) : 0, cn = (nt > 8) ? 8 : nt;
+                vk_boot_logf("[m105a] g nsel=%d shown=%d gap=%d (first8+last8)", nsel, nh + cn, nsel - nh - cn);
+                for (k = 0; k < cn; k++) {
+                    const m105a_ent *e = &tail[(st + k) % 8];
+                    vk_boot_logf("[m105a] w i=%d seq=%llu dr=%llu p=%llx rp=%llx fs=%s decl=%d real=%d dv=%d "
+                                 "nv=%u cnt=%u sk=%d",
+                                 nsel - cn + k, e->seq, e->dr, e->pso, e->rp, e->fs[0] ? e->fs : "-",
+                                 (int)e->decl, (int)e->real, (int)e->dv, e->nv, e->cnt, (int)e->sk);
+                }
+            }
+            for (k = 0; k < nx && k < 4; k++)   /* 带贴图笔的**真实目标槽**（NO 分支要的改法依据） */
+                vk_boot_logf("[m105a] x slot=%d n=%u maxreal=%u fs=%s", xs[k], xc[k], xr[k],
+                             xf[k][0] ? xf[k] : "-");
+            {   /* 判据③同一口径：最终 RT 自己的内容签名（不是 staging，是源 RT 本体） */
+                m98a_c_t c;
+                memset(&c, 0, sizeof c);
+                if (sel_slot >= 0 && sel_slot < H_RT_SLOTS && m99a_sig(sel_slot, &c)) {
+                    const unsigned cvd10 = (unsigned)(c.cvd * 10.0);
+                    vk_boot_logf("[m105a] c slot=%d ok=%d content=%d spread=%d colored=%u.%u%% "
+                                 "mean=%llu/%llu/%llu wh=%ux%u",
