+/* 本笔的 ntex 口径与 M102B 完全一致：decl = kf 声明的槽数，real = 其中拿到真 view 的槽数。 */
+static void m105a_ntex(const R_Key *kf, int *decl, int *real)
+{
+    int ntex, i, r = 0;
+    *decl = 0; *real = 0;
+    if (!kf) return;
+    ntex = kf->ntex < NVN_TX_SLOTS ? kf->ntex : NVN_TX_SLOTS;
+    *decl = ntex;
+    for (i = 0; i < ntex; i++) {
+        const int u = r_unit_of(kf, i);
+        if (u >= 0 && u < NVN_TX_SLOTS && g_r_tx_view[u] != VK_NULL_HANDLE) r++;
+    }
+    *real = r;
+}
