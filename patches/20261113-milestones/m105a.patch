+/* 记一笔（knob<2 时第一句即返回；写游标用 release 发布，present 侧 acquire 读）。 */
+static void m105a_rec(const R_Key *kf, int slot, int dvar, unsigned nverts, int count,
+                      unsigned long long pso, unsigned long long rp, int sk)
+{
+    int decl = 0, real = 0;
+    m105a_ent *e;
+    if (g_m105a_v == -2) (void)m105a_knob();
+    if (g_m105a_v < 2 || slot < 0 || slot >= H_RT_SLOTS) return;
+    m105a_ntex(kf, &decl, &real);
+    e = &g_m105a_ring[(unsigned)(g_m105a_w % (unsigned long long)M105A_RING)];
+    memset(e, 0, sizeof *e);
+    e->seq = ++g_m105a_seq;
+    e->dr  = (unsigned long long)g_r_draws;
+    e->pso = pso; e->rp = rp;
+    e->slot = (unsigned)slot;
+    e->nv = nverts;
+    e->cnt = (unsigned)(count > 0 ? count : 0);
+    e->decl = (unsigned char)(decl > 255 ? 255 : decl);
+    e->real = (unsigned char)(real > 255 ? 255 : real);
+    e->dv = (unsigned char)(dvar < 0 ? 0 : (dvar > 255 ? 255 : dvar));
+    e->sk = (unsigned char)(sk ? 1 : 0);
+    if (kf && kf->key[0]) { memcpy(e->fs, kf->key, 16); e->fs[16] = 0; }
+    if (!sk && real > 0) g_m105a_texmask[slot >> 6] |= (1ull << (slot & 63));
+    __atomic_store_n(&g_m105a_w, g_m105a_w + 1ull, __ATOMIC_RELEASE);
 }
 
+/* skip 判定（knob>=3 才可能返 1）：只跳「常量色笔覆盖已有着色内容」这一种，别的笔一律照常下发。 */
+static int m105a_skip_draw(const R_Key *kf, int dvar)
+{
+    int decl = 0, real = 0, si;
+    if (g_m105a_v < 3) { if (g_m105a_v == -2) (void)m105a_knob(); return 0; }
+    if (!kf || dvar >= 3 || !g_rt_cur || !g_h_img) return 0;
+    si = (int)(g_rt_cur - g_rt_tab);
+    if (si < 0 || si >= H_RT_SLOTS) return 0;
+    if (!g_m105a_win[si]) return 0;                       /* 只对 present 学到的窗口槽生效 */
+    m105a_ntex(kf, &decl, &real);
+    (void)real;
+    if (decl != 0) return 0;                             /* 只跳「无贴图声明」的常量色笔 */
+    if (!g_m105a_lastfs[si][0]) return 0;                /* 还没有上一帧末笔记录 ⇒ 不跳 */
+    if (memcmp(kf->key, g_m105a_lastfs[si], 16) != 0) return 0;   /* 只跳「末笔那族 fs」 */
+    if (!(g_m105a_texmask[si >> 6] & (1ull << (si & 63)))) return 0;  /* 本帧必须已有带贴图笔写过它 */
+    g_m105a_skip_n++;
+    return 1;
+}
