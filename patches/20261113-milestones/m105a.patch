+/* ================= M105A（2026-11-13）：最终可见 RT 的帧内写入时序 + 「最后覆盖」判定 =================
+   派活单唯一判断题：带贴图 pass 是不是**先**写了最终可见 RT（present 默认选源那张 800×450 窗口纹理），
+   随后被常量色 pass（fs=0a25edc7 / 905cc547 族，ntex_decl=0）覆盖？
+   ① 记账（只读）：每笔颜色 draw 落一条 {本帧序号, draw 序号, pass 句柄(管线+渲染通道), fs 键,
+      ntex_decl, 动态 ntex_real, dvar} 到环形表；present 当帧边界 ⇒ `[m105a] f` 一行 judge +
+      `[m105a] w` 时序行（≤16 行/帧，只在前 10 帧 + 之后每 60 帧、全 boot ≤64 帧）。
+   ② knob `smo_m105a`（app 启动自种，缺省 0=关）：
+      0/-1 = 关（记账函数第一句即返回，零输出）；
+      2    = 只时序 + judge（不改渲染）；
+      3    = 时序 + 跳过常量色 pass（只跳「present 学到的窗口槽 ∧ 本帧已被带贴图笔写过 ∧
+             fs 与上一帧末笔同族 ∧ ntex_decl==0」的那一笔 —— 不全局禁 renderpass、不动 pass 顺序）。
+   ③ 安全闸：只对窗口槽生效；dvar>=3（纯深度）一律不跳；ntex_decl>0 一律不跳。 */
+#define M105A_A P_SLOT_DIR_A "/smo_m105a"
+#define M105A_B P_SLOT_DIR_B "/smo_m105a"
+#define M105A_RING 2048u
+#define M105A_FRAME_MAX 64u
+
+typedef struct {
+    unsigned long long seq, dr, pso, rp;   /* 本表单调序号 / g_r_draws / 管线 / 渲染通道 */
+    unsigned slot, nv, cnt;
+    unsigned char decl, real, dv, sk;
+    char fs[17];
+} m105a_ent;
+
+static m105a_ent g_m105a_ring[M105A_RING];
+static unsigned long long g_m105a_w, g_m105a_rd, g_m105a_seq;
+static int g_m105a_v = -2;
+static double g_m105a_kt, g_m105a_klog;
+static unsigned long long g_m105a_skip_n;
+static unsigned long long g_m105a_texmask[4];        /* 本帧被「带贴图笔」写过的槽位图 */
+static unsigned char g_m105a_win[H_RT_SLOTS];        /* present 学到的窗口槽集合 */
+static char g_m105a_lastfs[H_RT_SLOTS][17];          /* 每槽上一帧末笔 fs（skip 只跳这一族） */
+static unsigned long long g_m105a_fno, g_m105a_pf;
+static unsigned long long g_m105a_yes, g_m105a_no, g_m105a_empty;
