+            const unsigned da = g_slot_dw_prev[order[a]], db = g_slot_dw_prev[order[b]];
+            const unsigned long long aa = g_slot_dw_all[order[a]], ab = g_slot_dw_all[order[b]];
+            if (db > da || (db == da && ab > aa)) { int t = order[a]; order[a] = order[b]; order[b] = t; }
+        }
+    char list[320]; int o = 0, lc = 0;
+    list[0] = 0;
+    for (int a = 0; a < n && a < 12; a++) {
+        h_rt_slot *t = &g_rt_tab[order[a]];
+        r_sig_t s2; memset(&s2, 0, sizeof s2);
+        const int ok2 = r_tex_signature(t->img, p_slot_layout(t), t->w, t->h, 4, &s2);
+        const double np2 = (double)((ok2 && s2.npx) ? s2.npx : 1);
+        const double nz2 = 100.0 * (double)(ok2 ? s2.nz : 0) / (4.0 * np2);
+        if (o < (int)sizeof list - 40)
+            o += snprintf(list + o, sizeof list - (size_t)o, " %d:%d:%ux%u:%u:%.0f",
+                          order[a], (int)t->tex_id, (unsigned)t->w, (unsigned)t->h,
+                          g_slot_dw_prev[order[a]], nz2);
+        lc++;
+    }
+    if (m97a_budget()) vk_boot_logf("[m97a] census rt n=%d%s", lc, o ? list : " <none>");
+}
