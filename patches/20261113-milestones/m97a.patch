+/* present 时刻普查：原源身份 + 本帧/整 boot 写入笔数 + 签名；再一行全 800x450 活 RT 精简清单。 */
+static void m97a_census(unsigned long long call, const char *srcname, int slot,
+                        VkImage simg, VkImageLayout slay, unsigned sw, unsigned sh)
+{
+    if (!(call <= 8 || (call % 300) == 0)) return;
+    const int ns = (int)(sizeof g_rt_tab / sizeof *g_rt_tab);
+    h_rt_slot *s = (slot >= 0 && slot < ns) ? &g_rt_tab[slot] : NULL;
+    r_sig_t sg; memset(&sg, 0, sizeof sg);
+    const int ok = (simg && sw && sh) ? r_tex_signature(simg, slay, sw, sh, 4, &sg) : 0;
+    const double np = (double)((ok && sg.npx) ? sg.npx : 1);
+    int dom = 0;
+    for (int i = 1; i < sg.nt; i++) if (sg.tn[i] > sg.tn[dom]) dom = i;
+    const double colored = 100.0 * (np - (ok && sg.nt ? (double)sg.tn[dom] : 0.0)) / np;
+    const double nzp = 100.0 * (double)(ok ? sg.nz : 0) / (4.0 * np);
+    const unsigned dwf = (slot >= 0 && slot < (int)(sizeof g_slot_dw_prev / sizeof *g_slot_dw_prev))
+                       ? g_slot_dw_prev[slot] : 0u;
+    const unsigned long long dwa = s ? g_slot_dw_all[slot] : 0ull;
+    if (!m97a_budget()) return;
+    vk_boot_logf("[m97a] census call=%llu c=%llu src=%s slot=%d texid=%d ext=%ux%u fmt=%u lay=%d ok=%d "
+                 "dwf=%u dwall=%llu nz=%.1f%% mean=%llu/%llu/%llu colored=%.1f%% nt=%d",
+                 call, g_p_calls, srcname, slot, s ? (int)s->tex_id : -1, sw, sh, s ? (unsigned)s->fmt : 0u,
+                 (int)slay, ok, dwf, dwa, nzp,
+                 ok ? (unsigned long long)(sg.sum[0] / np) : 0ull,
+                 ok ? (unsigned long long)(sg.sum[1] / np) : 0ull,
+                 ok ? (unsigned long long)(sg.sum[2] / np) : 0ull, colored, ok ? sg.nt : 0);
+    /* 全 800x450 活 RT 清单（最多 12 条：slot:texid:w x h:dwf:nz） */
+    int order[64]; int n = 0;
+    for (int i = 0; i < ns && n < 64; i++) {
+        h_rt_slot *t = &g_rt_tab[i];
+        if (!t->img || !t->w || !t->h || t->w != sw || t->h != sh) continue;
+        const VkImageLayout lay = p_slot_layout(t);
+        if (lay != VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL &&
+            lay != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL) continue;
+        order[n++] = i;
+    }
+    for (int a = 0; a < n; a++)
