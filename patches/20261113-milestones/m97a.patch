+/* 自动选源：枚举全部活着的、尺寸 == rw x rh 的颜色 RT，按「本帧写入笔数 → 整 boot 笔数」降序，
+   最多签 8 个，取 nz 最高且非纯色（nt>1、nz>1%）的一个。返回槽号，-1 = 没有可用内容。 */
+static int m97a_auto_pick(unsigned rw, unsigned rh, double *nz_o, unsigned *mr_o, unsigned *mg_o,
+                          unsigned *mb_o, int *nsig_o)
+{
+    const int ns = (int)(sizeof g_rt_tab / sizeof *g_rt_tab);
+    int idx[64]; int n = 0;
+    for (int i = 0; i < ns && n < 64; i++) {
+        h_rt_slot *s = &g_rt_tab[i];
+        if (!m97a_usable(s) || s->w != rw || s->h != rh) continue;
+        const VkImageLayout lay = p_slot_layout(s);
+        if (lay != VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL &&
+            lay != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL) continue;   /* 签名只认这两态 */
+        idx[n++] = i;
+    }
+    for (int a = 0; a < n; a++)
+        for (int b = a + 1; b < n; b++) {
+            const unsigned da = g_slot_dw_prev[idx[a]], db = g_slot_dw_prev[idx[b]];
+            const unsigned long long aa = g_slot_dw_all[idx[a]], ab = g_slot_dw_all[idx[b]];
+            if (db > da || (db == da && ab > aa)) { int t = idx[a]; idx[a] = idx[b]; idx[b] = t; }
+        }
+    int best = -1, nsig = 0; double bnz = -1.0; unsigned bmr = 0, bmg = 0, bmb = 0;
+    char list[240]; int lo = 0; list[0] = 0;
+    for (int a = 0; a < n && nsig < M97A_AUTO_MAX_SIG; a++) {
+        h_rt_slot *s = &g_rt_tab[idx[a]];
+        r_sig_t sg; memset(&sg, 0, sizeof sg);
+        if (!r_tex_signature(s->img, p_slot_layout(s), s->w, s->h, 4, &sg)) continue;
+        nsig++;
+        const double np = (double)(sg.npx ? sg.npx : 1);
+        const double nzp = 100.0 * (double)sg.nz / (4.0 * np);
+        if (lo < (int)sizeof list - 40)
+            lo += snprintf(list + lo, sizeof list - (size_t)lo, " %d:%d:%.0f%%:%u",
+                           idx[a], (int)s->tex_id, nzp, g_slot_dw_prev[idx[a]]);
+        if (sg.nt > 1 && nzp > 1.0 && nzp > bnz) {
+            bnz = nzp; best = idx[a];
+            bmr = (unsigned)(sg.sum[0] / np); bmg = (unsigned)(sg.sum[1] / np); bmb = (unsigned)(sg.sum[2] / np);
+        }
+    }
+    if (m97a_budget())
+        vk_boot_logf("[m97a] auto cands n=%d sig=%d%s", n, nsig, lo ? list : " <none>");
+    if (nz_o) *nz_o = bnz < 0 ? 0.0 : bnz;
+    if (mr_o) *mr_o = bmr;
+    if (mg_o) *mg_o = bmg;
+    if (mb_o) *mb_o = bmb;
+    if (nsig_o) *nsig_o = nsig;
+    return best;
+}
