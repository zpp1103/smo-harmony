+/* 槽是否「活着且可拷」（与 p_src_copyable 同口径）。 */
+static int m97a_usable(h_rt_slot *s) { return s && p_src_copyable(s); }
+
+/* 直选：按 texid 找活槽；先要精确尺寸 rw x rh，退而求其次「≥ 拷贝下限」。返回 -1 = 找不到。 */
+static int m97a_find_texid(int tid, unsigned rw, unsigned rh)
+{
+    int hit = -1, soft = -1;
+    const int ns = (int)(sizeof g_rt_tab / sizeof *g_rt_tab);
+    g_m97a_nlive = 0;
+    for (int i = 0; i < ns; i++) {
+        h_rt_slot *s = &g_rt_tab[i];
+        if (!s->img) continue;
+        g_m97a_nlive++;
+        if (s->tex_id != tid || !m97a_usable(s)) continue;
+        if (s->w == rw && s->h == rh) { hit = i; break; }
+        if (soft < 0) soft = i;
+    }
+    return hit >= 0 ? hit : soft;
+}
