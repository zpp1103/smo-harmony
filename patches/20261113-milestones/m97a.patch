+/* 1 = 还能打一行（硬上限 400 行/次运行；超限只提示一次）。 */
+static int m97a_budget(void)
+{
+    if (g_m97a_lines < M97A_MAX_LINES) { g_m97a_lines++; return 1; }
+    if (!g_m97a_lim_note) {
+        g_m97a_lim_note = 1;
+        vk_boot_logf("[m97a] probe limit (%u lines) reached — 后续探针静默", M97A_MAX_LINES);
+    }
+    return 0;
+}
