+/* knob 活读：每 40 次 present（≈25 s）重读一次；值变化打一行（A/B 两段就靠它切）。 */
+static void m97a_poll(unsigned long long call)
+{
+    if (g_m97a_src < 0) {
+        m97a_seed();
+        g_m97a_src = p_file_int(M97A_SRC_A, M97A_SRC_B, 0);
+        g_m97a_auto = p_file_int(M97A_AUTO_A, M97A_AUTO_B, 0);
+        g_m97a_lastread = call;
+        vk_boot_logf("[m97a] init src=%d auto=%d file=%s", g_m97a_src, g_m97a_auto, M97A_SRC_B);
+        return;
+    }
+    if (call - g_m97a_lastread < 40) return;
+    g_m97a_lastread = call;
+    { const int os = g_m97a_src, oa = g_m97a_auto;
+      g_m97a_src = p_file_int(M97A_SRC_A, M97A_SRC_B, g_m97a_src);
+      g_m97a_auto = p_file_int(M97A_AUTO_A, M97A_AUTO_B, g_m97a_auto);
+      if (os != g_m97a_src || oa != g_m97a_auto)
+          vk_boot_logf("[m97a] knob src=%d->%d auto=%d->%d call=%llu", os, g_m97a_src, oa, g_m97a_auto, call); }
+}
