+/* hdc 只能覆盖已有文件 ⇒ 由 app 先种子（值 0，不是 -1：缺省必须 = 完全旧行为）。 */
+static void m97a_seed(void)
+{
+    static int done;
+    if (done) return;
+    done = 1;
+    const char *paths[2][2] = { { M97A_SRC_A, M97A_SRC_B }, { M97A_AUTO_A, M97A_AUTO_B } };
+    for (int k = 0; k < 2; k++) {
+        int have = 0;
+        for (int i = 0; i < 2; i++) { FILE *f = fopen(paths[k][i], "r"); if (f) { have = 1; fclose(f); break; } }
+        if (have) continue;
+        for (int i = 0; i < 2; i++) {
+            FILE *f = fopen(paths[k][i], "w");
+            if (f) { fputs("0\n", f); fclose(f); vk_boot_logf("[m97a] seeded %s = 0", paths[k][i]); break; }
+        }
+    }
+}
