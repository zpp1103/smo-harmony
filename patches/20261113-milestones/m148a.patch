+/* ===== M148A（2026-11-15）：present **同刻**对「拷贝实际读的那张源图」做一次廉价指纹 =====
+   位置：`[m104a] p` 行行尾（staging 已拷完、同一 present 调用内）⇒ 一行同时给出
+   「staging 里读到什么」与「源图在那一刻有什么」，用来分开两个子假设：
+     · `stag` 全 0 而 `srcsig` 非 0 ⇒ **拷贝可见性/同步 hazard**（转 barrier 保守化）；
+     · 两者都 0 ⇒ 图在 present 那一刻**真的空**（转「帧内快照上屏」，不是本单的解）。
+   knob `smo_pres_sig`（0 = 关 = **缺省**；1 = 开）：关态后缀是空串 ⇒ `[m104a] p` 行内容逐字节不变、
+   本帧拷贝/barrier/选源一行不动（只多一次 int 比较）。
+   实现：复用 m99a_sig_locked（= g_vkq_lock 保护下的 r_tex_signature，与既有 `[p] gsig` 同一条
+   代码路径，256 点 / 16 行），**不是**新造回读通道；采样率与 `[m104a] p` 完全一致（≤1 Hz）。
+   布局不是 SRO/CAO/TRANSFER_SRC 时 r_tex_signature 自己返回 0 ⇒ 记 ok=0，不猜、不转换布局。 */
+#define M148A_DIR_A P_SLOT_DIR_A
+#define M148A_DIR_B P_SLOT_DIR_B
+#define M148A_SIG_A M148A_DIR_A "/smo_pres_sig"
+#define M148A_SIG_B M148A_DIR_B "/smo_pres_sig"
+static int g_m148a_sig = -2;              /* -2 = 还没读过；0 = 关（缺省） */
+static unsigned g_m148a_reads;
+/* 照抄 m140a_seed：种 "0\n" + chmod 0666（hdc 是 uid=2000，只能覆盖**已存在**的 666 文件）。 */
+__attribute__((constructor)) static void m148a_seed(void)
+{
+    static const char *const p[2] = { M148A_SIG_A, M148A_SIG_B };
+    for (int i = 0; i < 2; i++) {
+        if (access(p[i], F_OK) == 0) { chmod(p[i], 0666); continue; }
+        int fd = open(p[i], O_CREAT | O_WRONLY | O_TRUNC, 0666);
+        if (fd >= 0) { ssize_t wr = write(fd, "0\n", 2); (void)wr; close(fd); chmod(p[i], 0666); }
+    }
+}
+static int m148a_pres_sig_on(void)   /* 每 16 次查询重读一次：hdc 改值 ~1 s 内生效（同 m104a_knob） */
+{
+    if (g_m148a_sig == -2) { g_m148a_sig = p_file_int(M148A_SIG_A, M148A_SIG_B, 0); g_m148a_reads = 0; }
+    else if ((++g_m148a_reads & 15u) == 0) g_m148a_sig = p_file_int(M148A_SIG_A, M148A_SIG_B, g_m148a_sig);
+    if (g_m148a_sig > 0) {
+        static int logged;
+        if (!logged) {
+            logged = 1;
+            vk_boot_logf("[m148a] pres srcsig on=1 file=%s (present 同刻回读源图，≤1 Hz，只读)",
+                         M148A_SIG_B);
+        }
+        return 1;
+    }
+    return 0;
 }
+/* 把 srcsig 后缀写进 b（关态写空串 ⇒ 调用方的格式串输出与改前逐字节相同）。 */
+static void m148a_srcsig_sfx(char *b, size_t n, VkImage img, VkImageLayout lay, unsigned w, unsigned h)
+{
+    if (!n) return;
+    b[0] = 0;
+    if (!m148a_pres_sig_on() || !img || !w || !h) return;
+    r_sig_t sg;
+    const int ok = m99a_sig_locked(img, lay, w, h, 4, &sg);
+    const unsigned long long nn = (ok && sg.npx) ? sg.npx : 1ull;
+    snprintf(b, n, " srcsig[ok=%d img=%#llx lay=%d mean=%u/%u/%u max=%u/%u/%u min=%u/%u/%u "
+                   "nz=%llu/%llu hash=%#llx]",
+             ok, (unsigned long long)(uintptr_t)img, (int)lay,
+             ok ? (unsigned)(sg.sum[0] / nn) : 0u, ok ? (unsigned)(sg.sum[1] / nn) : 0u,
+             ok ? (unsigned)(sg.sum[2] / nn) : 0u,
+             ok ? (unsigned)sg.mx[0] : 0u, ok ? (unsigned)sg.mx[1] : 0u, ok ? (unsigned)sg.mx[2] : 0u,
+             ok ? (unsigned)sg.mn[0] : 0u, ok ? (unsigned)sg.mn[1] : 0u, ok ? (unsigned)sg.mn[2] : 0u,
+             ok ? sg.nz : 0ull, ok ? sg.npx : 0ull, ok ? sg.hash : 0ull);
+}
