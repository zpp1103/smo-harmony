+static h_d_slot *g_m101a_lastds;    /* 最近一次 n=0 纯深度 pass 真的用过的深度槽 */
+static int g_m101a_sw = -1;
+static int m101a_on(void)
+{
+    static unsigned long long last;
+    if (g_m101a_sw < 0) {
+        p_file_seed(M101A_SW_A, M101A_SW_B);       /* 缺省文件 = -1 ⇒ 视为开（默认生效） */
+        g_m101a_sw = p_file_int(M101A_SW_A, M101A_SW_B, 1);
+        last = (unsigned long long)r_now_ms();
+        vk_boot_logf("[m101a] sw init on=%d (1=fix n0/depth-miss host fallback, 0=old M100A mode0)",
+                     g_m101a_sw != 0);
+        return g_m101a_sw != 0;
+    }
+    if ((unsigned long long)r_now_ms() - last >= 3000ull) {
+        const int v = p_file_int(M101A_SW_A, M101A_SW_B, 1);
+        last = (unsigned long long)r_now_ms();
+        if ((v != 0) != (g_m101a_sw != 0)) {
+            vk_boot_logf("[m101a] sw on=%d -> on=%d (runtime switch)", g_m101a_sw != 0, v != 0);
+            g_m101a_sw = v;
+        }
+    }
+    return g_m101a_sw != 0;
+}
+/* P3：n=0 且 depth 声明解不出时的深度兜底。返回深度槽（找不到 = NULL）。
+   *src：1 = 按存储身份/同 pass 上一帧的深度槽命中，2 = 当前颜色目标已挂的那张（沿用），0 = 没有。 */
+static h_d_slot *m101a_dpass_depth(uint64_t raw, int *src)
+{
+    h_d_slot *ds = NULL;
+    if (src) *src = 0;
+    if (raw) {
+        ds = h_d_lookup(raw, 0, 0);          /* 少数情况下 raw 本身就是深度存储身份 */
+        if (!ds) ds = r_dslot_by_store(raw); /* 或它本来就是池存储地址 */
+        if (ds && src) *src = 1;
+    }
+    if (!ds && g_m101a_lastds && g_m101a_lastds->img) {
+        ds = g_m101a_lastds;                 /* 「沿用同 pass 上一帧的 depth 目标」 */
+        if (src) *src = 1;
+    }
+    if (!ds && g_rt_cur && g_rt_cur->ds) {
+        ds = g_rt_cur->ds;                   /* 当前颜色目标已经挂着的那张（沿用，不换） */
+        if (src) *src = 2;
+    }
+    return ds;
 }
