+/* vkQueueSubmit 收口：关态原样透传（一条分支都不多）；开态同时收「本批录制段」+ 提交段 + 提交计数。 */
+static VkResult m108a_queue_submit(VkQueue q, uint32_t n, const VkSubmitInfo *si, VkFence f)
+{
+    unsigned long long t0, t1;
+    VkResult r;
+    if (g_m108a_v <= 0) return vkQueueSubmit(q, n, si, f);
+    t0 = m108a_ns();
+    if (g_m108a_rec_open) {                 /* 本批录制到此收口（submit 起点即录制终点） */
+        if (t0) m108a_seg_add(0, t0 - g_m108a_t_rec);
+        g_m108a_rec_open = 0;
+    }
+    r = vkQueueSubmit(q, n, si, f);
+    t1 = m108a_ns();
+    if (t0 && t1 && t1 >= t0) m108a_seg_add(1, t1 - t0);
+    m108a_hot_add(M108A_H_SUBMIT, t0, t1);
+    g_m108a_c_submits++;
+    return r;
+}
