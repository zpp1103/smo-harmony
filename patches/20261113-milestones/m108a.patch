+#define M108A_A P_SLOT_DIR_A "/smo_m108a"
+#define M108A_B P_SLOT_DIR_B "/smo_m108a"
 
+static void m108a_reset_frame(void)
+{
+    int i;
+    for (i = 0; i < 5; i++) g_m108a_seg[i] = 0;
+    g_m108a_c_draws = 0; g_m108a_c_verts = 0; g_m108a_c_rp = 0; g_m108a_c_pubs = 0;
+    g_m108a_c_imgs = 0; g_m108a_c_bufs = 0; g_m108a_c_allocs = 0; g_m108a_c_dset = 0;
+    g_m108a_c_submits = 0; g_m108a_c_fences = 0;
+    g_m108a_rec_open = 0; g_m108a_t_rec = 0;
+}
+static void m108a_reset_window(unsigned long long tns)
+{
+    int i;
+    for (i = 0; i < M108A_H_N; i++) { g_m108a_hot[i].n = 0; g_m108a_hot[i].ns = 0; g_m108a_hot[i].mx = 0; }
+    g_m108a_w_t0 = tns;
+    g_m108a_w_open = tns ? 1 : 0;
+    g_m108a_w_frames = 0; g_m108a_w_total = 0; g_m108a_w_rec = 0;
+    g_m108a_w_fence = 0; g_m108a_w_pres = 0; g_m108a_w_max = 0;
+    g_m108a_w_pubs = 0; g_m108a_w_imgs = 0; g_m108a_w_allocs = 0; g_m108a_w_dset = 0;
+}
+/* knob 换档：帧边界与窗口一律重立基线（否则新档第一帧会把旧档的时间算进来）。 */
+static void m108a_apply_knob(int v)
+{
+    g_m108a_v = v;
+    g_m108a_t_last_end = 0;
+    g_m108a_t_pres = 0;
+    g_m108a_last_lru = g_rt_img_lru;
+    m108a_reset_frame();
+    m108a_reset_window(0);
+}
+/* knob 文件必须 app 自己先建（hdc 在沙箱里建不出新文件；hdc 只能改写已有文件）。
+   force=1 ⇒ 立刻读一次（「关态也要能切上来」与首次 seed）；force=0 ⇒ 开态按 2 s 节流重读；
+   值变化立刻打 `[m108a] sw knob -> val=`（M104A 教训：knob 未生效不许当结果）。 */
+static int m108a_knob_poll(unsigned long long tns, int force)
+{
+    if (g_m108a_v == -2) {
+        const char *p[2] = { M108A_A, M108A_B };
+        int have = 0, i;
+        for (i = 0; i < 2 && !have; i++) { FILE *f = fopen(p[i], "r"); if (f) { fclose(f); have = 1; } }
+        for (i = 0; i < 2 && !have; i++) {
+            FILE *f = fopen(p[i], "wb");
+            if (f) { fputs("0\n", f); fclose(f); have = 1; }
+        }
+        m108a_apply_knob(p_file_int(M108A_A, M108A_B, 0));
+        g_m108a_knob_t = tns;
+        vk_boot_logf("[m108a] sw knob -> val=%d (seed)", g_m108a_v);
+        return g_m108a_v;
+    }
+    if (!force) {
+        if (!tns) return g_m108a_v;
+        if (!g_m108a_knob_t) { g_m108a_knob_t = tns; return g_m108a_v; }
+        if (tns - g_m108a_knob_t < 2000000000ull) return g_m108a_v;
+    }
+    {
+        const int v = p_file_int(M108A_A, M108A_B, 0);
+        g_m108a_knob_t = tns;
+        if (v != g_m108a_v) {
+            m108a_apply_knob(v);
+            vk_boot_logf("[m108a] sw knob -> val=%d", g_m108a_v);
+        }
+    }
+    return g_m108a_v;
+}
+static void m108a_frame_close(unsigned long long t_end, unsigned long long call, int pres_done, int ok);
