+        m108a_frame_close(t, g_m108a_call, 0, 1);
+        g_m108a_samp = 0;
+        t = m108a_ns();
+    }
+    if (!t) return;
+    g_m108a_call = call;
+    g_m108a_pres_sub0 = g_m108a_seg[1];
+    g_m108a_pres_fen0 = g_m108a_seg[2];
+    g_m108a_pres_blt0 = g_m108a_seg[4];
+    g_m108a_t_pres = t;
+}
+static void m108a_pres_end(unsigned long long call, int ok)
+{
+    unsigned long long t_end;
+    if (g_m108a_v <= 0) return;
+    t_end = m108a_ns();
+    if (!t_end) return;
+    if (m108a_knob_poll(t_end, 0) <= 0) {     /* 本帧内被关掉 ⇒ 丢数据、清帧，不打半帧 */
+        g_m108a_t_pres = 0;
+        m108a_reset_frame();
+        return;
+    }
+    if (!g_m108a_t_pres) return;              /* begin 没立起（预算用尽）⇒ 本帧不计，不产出半帧 */
+    m108a_frame_close(t_end, call, 1, ok);
+}
+/* 帧收口：算出六段与计数 → 打 pf → 进 30 s 窗口（够 30 s 就打 sum，=2 时再打 hot）→ 清帧。 */
+static void m108a_frame_close(unsigned long long t_end, unsigned long long call, int pres_done, int ok)
+{
+    unsigned long long total, pres_ns = 0, seg_sum, oth, lru;
+    (void)ok;                                 /* 失败帧与成功帧同一口径（失败由 oth/计数体现） */
+    lru = g_rt_img_lru;                       /* id-img LRU 淘汰：纯计数（不占采样） */
+    if (lru > g_m108a_last_lru) g_m108a_hot[M108A_H_LRU].n += lru - g_m108a_last_lru;
+    g_m108a_last_lru = lru;
+    if (!g_m108a_t_last_end) {                /* 首帧（或刚换档）：只立基线，不下结论 */
+        g_m108a_t_last_end = t_end;
+        g_m108a_t_pres = 0;
+        m108a_reset_frame();
+        return;
+    }
+    total = (t_end > g_m108a_t_last_end) ? t_end - g_m108a_t_last_end : 0;
+    if (pres_done && g_m108a_t_pres && t_end > g_m108a_t_pres) {
+        pres_ns = t_end - g_m108a_t_pres;
+        {   /* present 段扣掉 present 自己的 submit/fence/blit（它们已单独成段，不能重复计） */
+            unsigned long long sd = g_m108a_seg[1] - g_m108a_pres_sub0;
+            unsigned long long fd = g_m108a_seg[2] - g_m108a_pres_fen0;
+            unsigned long long bd = g_m108a_seg[4] - g_m108a_pres_blt0;
+            if (sd + fd + bd >= pres_ns) pres_ns = 0;
+            else pres_ns -= sd + fd + bd;
+        }
+    }
+    g_m108a_seg[3] = pres_ns;
+    seg_sum = g_m108a_seg[0] + g_m108a_seg[1] + g_m108a_seg[2] + pres_ns + g_m108a_seg[4];
+    oth = (total > seg_sum) ? total - seg_sum : 0;
+    vk_boot_logf("[m108a] pf call=%llu app_t=%llu total=%llu rec=%llu sub=%llu fence=%llu(n=%llu) "
+                 "pres=%llu blit=%llu oth=%llu draws=%llu rp=%llu verts=%llu pubs=%llu imgs=%llu "
+                 "bufs=%llu allocs=%llu dset=%llu submits=%llu",
+                 call, t_end / 1000000ull, total / 1000000ull, g_m108a_seg[0] / 1000000ull,
+                 g_m108a_seg[1] / 1000000ull, g_m108a_seg[2] / 1000000ull, g_m108a_c_fences,
+                 pres_ns / 1000000ull, g_m108a_seg[4] / 1000000ull, oth / 1000000ull,
+                 g_m108a_c_draws, g_m108a_c_rp, g_m108a_c_verts, g_m108a_c_pubs, g_m108a_c_imgs,
+                 g_m108a_c_bufs, g_m108a_c_allocs, g_m108a_c_dset, g_m108a_c_submits);
+    g_m108a_w_frames++;
+    g_m108a_w_total += total;
+    g_m108a_w_rec += g_m108a_seg[0];
+    g_m108a_w_fence += g_m108a_seg[2];
+    g_m108a_w_pres += pres_ns;
+    if (total > g_m108a_w_max) g_m108a_w_max = total;
+    g_m108a_w_pubs += g_m108a_c_pubs;
+    g_m108a_w_imgs += g_m108a_c_imgs;
+    g_m108a_w_allocs += g_m108a_c_allocs;
+    g_m108a_w_dset += g_m108a_c_dset;
+    if (!g_m108a_w_open) m108a_reset_window(t_end);
+    if (g_m108a_w_open && t_end - g_m108a_w_t0 >= 30000000000ull) {
+        const unsigned long long fr = g_m108a_w_frames ? g_m108a_w_frames : 1ull;
+        vk_boot_logf("[m108a] sum t=%llu frames=%llu avg_total=%llu avg_rec=%llu avg_fence=%llu "
+                     "avg_pres=%llu max=%llu pubs=%llu imgs=%llu allocs=%llu dset=%llu",
+                     t_end / 1000000000ull, g_m108a_w_frames, g_m108a_w_total / fr / 1000000ull,
+                     g_m108a_w_rec / fr / 1000000ull, g_m108a_w_fence / fr / 1000000ull,
+                     g_m108a_w_pres / fr / 1000000ull, g_m108a_w_max / 1000000ull,
+                     g_m108a_w_pubs, g_m108a_w_imgs, g_m108a_w_allocs, g_m108a_w_dset);
+        if (g_m108a_v >= 2) {                /* 明细只在 =2 时开，避免刷爆日志 */
+            int i;
+            for (i = 0; i < M108A_H_N; i++)
+                if (g_m108a_hot[i].n)
+                    vk_boot_logf("[m108a] hot name=%s n=%llu ms=%llu max=%llu",
+                                 g_m108a_hot[i].name, g_m108a_hot[i].n,
+                                 g_m108a_hot[i].ns / 1000000ull, g_m108a_hot[i].mx / 1000000ull);
+        }
+        m108a_reset_window(t_end);
+    }
+    g_m108a_t_last_end = t_end;
+    g_m108a_t_pres = 0;
+    m108a_reset_frame();
+}
