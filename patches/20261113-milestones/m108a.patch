+/* 取一枚 CLOCK_MONOTONIC 纳秒戳；关态/预算用尽 ⇒ 返回 0（调用点必须当「这次不计时」处理）。 */
+static inline unsigned long long m108a_ns(void)
+{
+    struct timespec ts;
+    if (g_m108a_v <= 0) return 0;
+    if (g_m108a_samp >= M108A_SAMP_MAX) return 0;
+    g_m108a_samp++;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000000000ull + (unsigned long long)ts.tv_nsec;
