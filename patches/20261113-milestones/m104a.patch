+static void m104a_pat_fill(uint8_t *b, unsigned long long frame)
+{
+    if (!b) return;
+    static const unsigned char bars[5][3] = { {255,0,0}, {0,255,0}, {0,0,255}, {255,255,0}, {255,255,255} };
+    const int bw = M104A_PAT_W / 5;
+    for (int y = 0; y < M104A_PAT_H; y++) {
+        uint8_t *row = b + (size_t)y * (size_t)M104A_PAT_W * 4;
+        for (int x = 0; x < M104A_PAT_W; x++) {
+            const int k = (x / bw) % 5;
+            uint8_t *q = row + (size_t)x * 4;
+            q[0] = bars[k][0]; q[1] = bars[k][1]; q[2] = bars[k][2]; q[3] = 255;
+        }
+    }
+    /* 随帧移动的白块（左上 -> 右下）：x = (frame*37) % (W-80) */
+    const int mx = (int)((frame * 37ull) % (unsigned long long)(M104A_PAT_W - 80));
+    for (int y = 8; y < 88; y++) {
+        uint8_t *row = b + (size_t)y * (size_t)M104A_PAT_W * 4;
+        for (int x = mx; x < mx + 80; x++) {
+            uint8_t *q = row + (size_t)x * 4;
+            q[0] = 255; q[1] = 64; q[2] = 255; q[3] = 255;
+        }
+    }
+}
+/* 源图抽样统计（staging，口径与 win_fill.c 的 m104a_sig 相同：均值/最大/非零/黄，采样每 64 像素）。
+   只读，成本 <0.1 ms；由 `[m104a] p` 行按 ≤1 Hz 调用。 */
+static void m104a_src_sig(const unsigned char *p, unsigned w, unsigned h,
+                          unsigned *mr, unsigned *mg, unsigned *mb, unsigned *mx,
+                          unsigned *nz10, unsigned *yel10)
+{
+    unsigned long long sr = 0, sg = 0, sb = 0, nz = 0, yel = 0, ns = 0, mm = 0;
+    *mr = *mg = *mb = *mx = 0; *nz10 = *yel10 = 0;
+    if (!p || !w || !h) return;
+    const unsigned long long npx = (unsigned long long)w * (unsigned long long)h;
+    for (unsigned long long i = 0; i < npx; i += 64) {
+        const unsigned char *q = p + i * 4;
+        const unsigned r = q[0], g = q[1], b = q[2];
+        sr += r; sg += g; sb += b; ns++;
+        if (r || g || b) nz++;
+        if (r >= 200 && g >= 150 && b <= 60) yel++;
+        if (r > mm) mm = r;
+        if (g > mm) mm = g;
+        if (b > mm) mm = b;
+    }
+    if (!ns) return;
+    *mr = (unsigned)(sr / ns); *mg = (unsigned)(sg / ns); *mb = (unsigned)(sb / ns);
+    *mx = (unsigned)mm;
+    *nz10 = (unsigned)(nz * 1000ull / ns);
+    *yel10 = (unsigned)(yel * 1000ull / ns);
+}
+/* swapchain 通道（CH2 `sc`）的计数：清色 + acquire + present 每次成功写一帧就 +1。 */
+static unsigned long long g_m104a_sc_wr, g_m104a_sc_fail;
+static unsigned long long g_m104a_sc_r, g_m104a_sc_g, g_m104a_sc_b;
+static double g_m104a_sc_first, g_m104a_sc_last;
+static void m104a_sc_note(unsigned r, unsigned g, unsigned b, int ok)
+{
+    if (ok) {
+        const double now = (double)pf_now_us() / 1e6;   /* 墙钟（monotonic），只用于「首末时间」 */
+        if (!g_m104a_sc_first) g_m104a_sc_first = now;
+        g_m104a_sc_last = now;
+        g_m104a_sc_wr++; g_m104a_sc_r = r; g_m104a_sc_g = g; g_m104a_sc_b = b;
+    } else {
+        g_m104a_sc_fail++;
+    }
+}
