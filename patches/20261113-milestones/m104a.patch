+static unsigned g_m104a_reads;
+static unsigned long long g_m104a_pat_n;          /* 合成测试图帧号（同一 boot 内递增） */
+static unsigned m104a_knob(void)
+{
+    if (g_m104a_v == -2) { p_file_seed(M104A_A, M104A_B); g_m104a_v = p_file_int(M104A_A, M104A_B, -1); }
+    else if ((++g_m104a_reads & 15u) == 0) g_m104a_v = p_file_int(M104A_A, M104A_B, -1);
