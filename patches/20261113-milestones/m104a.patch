+/* 合成测试图（640x360 RGBA）：5 条彩条 + 按帧号横向移动的白色方块 ⇒ 一眼可判「这是我们写的」，
+   且方块位置随帧变化 ⇒ 同时证明写是活的（不是一张冻住的旧帧）。 */
+#define M104A_PAT_W 640
+#define M104A_PAT_H 360
+static uint8_t *m104a_pat_buf(void)
+{
+    static uint8_t *buf;
+    if (buf) return buf;
+    buf = (uint8_t *)calloc((size_t)M104A_PAT_W * M104A_PAT_H, 4);
+    return buf;
