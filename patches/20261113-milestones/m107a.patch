+++ mario-odessy-harmony/entry/src/main/cpp/platform/nvn_vk/nvn_vk.c
@@ -23352,6 +23352,442 @@
     if (!(g_m105a_texmask[si >> 6] & (1ull << (si & 63)))) return 0;  /* 本帧必须已有带贴图笔写过它 */
     g_m105a_skip_n++;
