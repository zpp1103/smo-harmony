+         M4r P1 的既有语义「n=0 的纯深度 pass 不动颜色目标」本来只有深度解出时才走到，这里补齐另一支。
+     2 = rescue-slot：同场景改投槽表里一张专用 800x450（= guest 1600x900 ÷2）槽，固定身份 'M100A'+尺寸；
+         槽一旦进表，[wp] tgt 的 writers_all 与 present 候选池都能看见它。
+   两者都只改「往哪写」，不动 shader / 管线 / 深度挂载 / 上屏选择判据。 */
+#define M100A_SW_A "/data/storage/el2/base/files/smo_m100a"
+#define M100A_SW_B "/data/app/el2/100/base/com.vibecc.smo/files/smo_m100a"
+#define M100A_NK   8
+typedef struct { const void *vs, *fs; char vss[17], fss[17]; unsigned long long verts, draws; } m100a_hk_t;
+static m100a_hk_t g_m100a_hk[M100A_NK];
+static unsigned g_m100a_hk_n;
+static int g_m100a_mode = -1;
+static void m100a_hostkey(const void *vsk, const void *fsk, const char *vss, const char *fss, unsigned nverts)
+{
+    unsigned i;
+    for (i = 0; i < g_m100a_hk_n; i++)
+        if (g_m100a_hk[i].vs == vsk && g_m100a_hk[i].fs == fsk) {
+            g_m100a_hk[i].verts += (unsigned long long)nverts;
+            g_m100a_hk[i].draws++;
+            return;
+        }
+    if (g_m100a_hk_n >= M100A_NK) return;    /* 实测 host 桶只有 6 个不同键；8 个够，超了只丢新键 */
+    g_m100a_hk[i].vs = vsk; g_m100a_hk[i].fs = fsk;
+    snprintf(g_m100a_hk[i].vss, sizeof g_m100a_hk[i].vss, "%s", vss ? vss : "?");
+    snprintf(g_m100a_hk[i].fss, sizeof g_m100a_hk[i].fss, "%s", fss ? fss : "?");
+    g_m100a_hk[i].verts = (unsigned long long)nverts;
+    g_m100a_hk[i].draws = 1;
+    g_m100a_hk_n++;
+}
+static int m100a_sw(void)
+{
+    static unsigned long long last;
+    if (g_m100a_mode < 0) {
+        p_file_seed(M100A_SW_A, M100A_SW_B);
+        g_m100a_mode = p_file_int(M100A_SW_A, M100A_SW_B, 0);
+        last = (unsigned long long)r_now_ms();
+        vk_boot_logf("[m100a] sw init mode=%d (0=off 1=keep-cur 2=rescue-slot; log+routing only)", g_m100a_mode);
+        return g_m100a_mode;
+    }
+    if ((unsigned long long)r_now_ms() - last >= 3000ull) {
+        const int v = p_file_int(M100A_SW_A, M100A_SW_B, 0);
+        last = (unsigned long long)r_now_ms();
+        if (v != g_m100a_mode) {
+            vk_boot_logf("[m100a] sw %d -> %d (host-fallback rescue mode switched at runtime)",
+                         g_m100a_mode, v);
+            g_m100a_mode = v;
+        }
+    }
+    return g_m100a_mode;
+}
+static const char *m100a_mode_name(int m)
+{
+    return m == 1 ? "keep-cur" : (m == 2 ? "rescue-slot" : "off");
+}
+static h_rt_slot *m100a_rescue_slot(void)
+{
+    const unsigned w = h_rs_dim(1600u), h = h_rs_dim(900u);
+    const unsigned long long nk = 0x4D31303041000000ull |
+                                  ((unsigned long long)(w & 0xFFFFu) << 16) |
+                                  (unsigned long long)(h & 0xFFFFu);
+    return h_rt_ensure(nk, w, h);
+}
+static void m100a_hk_line(unsigned long long call, unsigned long long el, unsigned long long tick)
+{
+    char ln[1024];
+    int lo = 0;
+    unsigned i, a, b;
+    unsigned ord[M100A_NK];
+    for (i = 0; i < g_m100a_hk_n; i++) ord[i] = i;
+    for (a = 0; a < g_m100a_hk_n; a++)                 /* verts 降序（与 wp_tick 同款选择排序） */
+        for (b = a + 1; b < g_m100a_hk_n; b++)
+            if (g_m100a_hk[ord[b]].verts > g_m100a_hk[ord[a]].verts) {
+                const unsigned t = ord[a]; ord[a] = ord[b]; ord[b] = t;
+            }
+    for (i = 0; i < g_m100a_hk_n && lo < (int)sizeof ln - 160; i++) {
+        const m100a_hk_t *e = &g_m100a_hk[ord[i]];
+        const unsigned long long pv = g_wp_verts_host ? e->verts * 1000ull / g_wp_verts_host : 0ull;
+        lo += snprintf(ln + lo, sizeof ln - (size_t)lo,
+                       "%s#%u vs=%s fs=%s verts=%llu(%llu.%llu%%) draws=%llu",
+                       i ? " | " : "", i + 1, e->vss, e->fss, e->verts,
+                       pv / 10ull, pv % 10ull, e->draws);
+    }
+    vk_boot_logf("[m100a] hostk pipe=%llu t=%llus tick=%llu keys=%u host_verts_cum=%llu host_draws_cum=%llu :: %s",
+                 call, el, tick, g_m100a_hk_n, g_wp_verts_host, g_wp_draws_host, ln);
+}
