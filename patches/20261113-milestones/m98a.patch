+/* 过曝白：三通道均值都 ≥250。M97A 的 flat 白 spread=0 已被 spread 门挡掉，这条挡「大面积 255 + 少量 250」。 */
+static int m98a_over_white(const m98a_c_t *c)
+{ return c->ok && c->mean[0] >= 250 && c->mean[1] >= 250 && c->mean[2] >= 250; }
+
+/* 内容三门（判据①③）：spread>0 且 colored>5% 且 非过曝白。 */
+static int m98a_is_content(const m98a_c_t *c)
+{ return c->ok && c->spread > 0 && c->cvd > 5.0 && !m98a_over_white(c); }
+
+/* 兜底缓存：记住最近一张**通过内容三门**的帧（槽号 + img 身份 + 时刻）。 */
+static void m98a_fb_arm(const m98a_c_t *c)
+{
+    if (!c->ok) return;
+    h_rt_slot *s = &g_rt_tab[c->slot];
+    if (!s->img) return;
+    g_m98a_fb_slot = c->slot; g_m98a_fb_img = s->img;
+    g_m98a_fb_w = s->w; g_m98a_fb_h = s->h; g_m98a_fb_lay = p_slot_layout(s);
+    clock_gettime(CLOCK_MONOTONIC, &g_m98a_fb_ts);
+}
+/* 兜底还能用吗：槽还活着 + img 身份没换 + 距上次通过判据 ≤2 s。 */
+static int m98a_fb_ok(void)
+{
+    if (g_m98a_fb_slot < 0 || g_m98a_fb_slot >= H_RT_SLOTS) return 0;
+    h_rt_slot *s = &g_rt_tab[g_m98a_fb_slot];
+    if (!m97a_usable(s) || s->img != g_m98a_fb_img) return 0;
+    struct timespec now; clock_gettime(CLOCK_MONOTONIC, &now);
+    const long long d = (long long)(now.tv_sec - g_m98a_fb_ts.tv_sec) * 1000000000LL
+                      + (long long)(now.tv_nsec - g_m98a_fb_ts.tv_nsec);
+    return d >= 0 && (unsigned long long)d <= M98A_FB_NS;
+}
