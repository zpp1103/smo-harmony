+/* M98A 自动选源：返回槽号（-1 = 没选到），tier 说明这一帧凭什么：
+   1 = 内容三门（spread>0 且 colored>5% 且 非过曝白）的 800×450 颜色 RT，取「本帧写入最多」的第一个；
+   3 = 本帧池子全黑/全白/没写过 ⇒ 上一帧通过判据那张（≤2 s）；
+   2 = 弱档：spread>0 且非过曝白，但 colored ≤5%（例如黑底 + 少量亮点），如实上屏并标 weak。 */
+static int m98a_pick(unsigned rw, unsigned rh, int *tier, m98a_c_t *best, char *list, int cap)
+{
+    const int ns = (int)(sizeof g_rt_tab / sizeof *g_rt_tab);
+    int ord[H_RT_SLOTS], i800[H_RT_SLOTS];
+    int nall = 0, n800 = 0;
+    *tier = 0; memset(best, 0, sizeof *best);
+    if (list && cap > 0) list[0] = 0;
+
+    /* 1. 「本帧真被 draw 写过」的活槽（g_slot_dw_prev 是 submit 边界快照：present 时 g_slot_dw 已清零） */
+    for (int i = 0; i < ns; i++) {
+        if (!m97a_usable(&g_rt_tab[i])) continue;
+        if (g_slot_dw_prev[i]) ord[nall++] = i;
+    }
+    /* 2. 按「本帧写入 → 整 boot 写入」降序 */
+    for (int a = 0; a < nall; a++)
+        for (int b = a + 1; b < nall; b++) {
+            const unsigned da = g_slot_dw_prev[ord[a]], db = g_slot_dw_prev[ord[b]];
+            const unsigned long long aa = g_slot_dw_all[ord[a]], ab = g_slot_dw_all[ord[b]];
+            if (db > da || (db == da && ab > aa)) { const int t = ord[a]; ord[a] = ord[b]; ord[b] = t; }
+        }
+    /* 3. present 源同尺寸（本机 = 800×450）的颜色 RT 子集，保持上面的写入序 */
+    for (int a = 0; a < nall; a++) {
+        const h_rt_slot *s = &g_rt_tab[ord[a]];
+        if (s->w != rw || s->h != rh) continue;
+        const VkImageLayout lay = p_slot_layout((h_rt_slot *)s);
+        if (lay != VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL &&
+            lay != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL) continue;
+        i800[n800++] = ord[a];
+    }
+    /* 4. 签名：先签 800×450 子集前 4（判据要的），再补 top-4 写入槽（探针要的），去重，总上限 8 */
+    m98a_c_t sig[16]; int nsig = 0;
+    for (int pass = 0; pass < 2; pass++) {
+        const int lim = (pass == 0) ? n800 : nall;
+        for (int a = 0; a < lim && a < 4 && nsig < 8; a++) {
+            const int sl = (pass == 0) ? i800[a] : ord[a];
+            int dup = 0;
+            for (int k = 0; k < nsig; k++) if (sig[k].slot == sl) { dup = 1; break; }
+            if (dup) continue;
+            if (m98a_sig(sl, &sig[nsig])) nsig++;
+        }
+    }
+    /* 5. 判据（sig[] 前半段 = 800×450 且按本帧写入降序 ⇒ 第一个命中的就是「写入最多且过判据」） */
+    int b1 = -1, b2 = -1;
+    for (int a = 0; a < nsig; a++) {
+        const m98a_c_t *c = &sig[a];
+        if (c->w != rw || c->h != rh || c->dwf == 0) continue;
+        if (b1 < 0 && m98a_is_content(c)) { b1 = a; continue; }
+        if (b2 < 0 && c->spread > 0 && !m98a_over_white(c)) b2 = a;
+    }
+    int pick = -1;
+    if (b1 >= 0) {
+        *tier = 1; *best = sig[b1]; pick = sig[b1].slot; m98a_fb_arm(&sig[b1]);
+    } else if (m98a_fb_ok()) {
+        h_rt_slot *fs = &g_rt_tab[g_m98a_fb_slot];
+        *tier = 3; pick = g_m98a_fb_slot;
+        memset(best, 0, sizeof *best);
+        best->slot = pick; best->ok = 1; best->w = fs->w; best->h = fs->h;
+        best->dwf = g_slot_dw_prev[pick]; best->dwa = g_slot_dw_all[pick];
+        best->spread = -1; best->cvd = -1.0;      /* 本帧没重签（省一次回读）；上一帧签过的值见 [m98a] src 历史 */
+    } else if (b2 >= 0) {
+        *tier = 2; *best = sig[b2]; pick = sig[b2].slot;
+    }
+    /* 6. 探针：本帧 top-4 写入槽 slot:texid:dwf:colored */
+    if (list && cap > 0) {
+        int o = 0;
+        for (int a = 0; a < nall && a < 4 && o < cap - 48; a++) {
+            const int sl = ord[a];
+            double cv = -1.0;
+            for (int k = 0; k < nsig; k++) if (sig[k].slot == sl) { cv = sig[k].cvd; break; }
+            o += snprintf(list + o, (size_t)(cap - o), "%s%d:%d:%u:%.0f",
+                          a ? " " : "", sl, (int)g_rt_tab[sl].tex_id,
+                          g_slot_dw_prev[sl], cv);
+        }
+        if (!nall) snprintf(list, (size_t)cap, "none");
+    }
+    {   /* 每 30 次 present 打一行候选面（不必每帧都打） */
+        static unsigned long long lastc;
+        if (m97a_budget() && (lastc == 0 || g_p_calls - lastc >= 30)) {
+            lastc = g_p_calls;
+            vk_boot_logf("[m98a] cands nall=%d n800=%d sig=%d tier=%d pick=%d ext=%ux%u top4=%s",
+                         nall, n800, nsig, *tier, pick, rw, rh, (list && list[0]) ? list : "<none>");
+        }
+    }
+    return pick;
 }
 
