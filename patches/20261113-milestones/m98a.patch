+/* 一个候选槽的内容签名：走 r_tex_signature（16 条横带 × 16 列 = 256 采样点，≈1/28 幅面 + 一次 submit），
+   与 `[wp] rt` / M97A census 同一条路、同一口径。colored% = 100 − 主色占比（M96A/M97A 同口径）。 */
+typedef struct {
+    int      slot, ok;
+    unsigned w, h, dwf;
+    unsigned long long dwa, mean[3], mx[3], mn[3];
+    int      spread;        /* 三通道 (max−min) 的最大值；0 = 常量图（flat 白/纯黑都是 0） */
+    double   cvd;           /* colored% = 100 − 主色占比 */
+    double   nzb;           /* 非黑像素%（c_stat_t.colored 口径，只做参考） */
+} m98a_c_t;
+
+static int m98a_sig(int slot, m98a_c_t *o)
+{
+    memset(o, 0, sizeof *o);
+    o->slot = slot;
+    h_rt_slot *s = &g_rt_tab[slot];
+    if (!m97a_usable(s)) return 0;
+    r_sig_t sg; memset(&sg, 0, sizeof sg);
+    if (!r_tex_signature(s->img, p_slot_layout(s), s->w, s->h, 4, &sg) || !sg.npx) return 0;
+    const double np = (double)sg.npx;
+    o->w = s->w; o->h = s->h;
+    o->dwf = g_slot_dw_prev[slot];
+    o->dwa = g_slot_dw_all[slot];
+    for (int c = 0; c < 3; c++) {
+        o->mean[c] = (unsigned long long)((double)sg.sum[c] / np);
+        o->mx[c] = sg.mx[c]; o->mn[c] = sg.mn[c];
+        const unsigned long long d = (sg.mx[c] > sg.mn[c]) ? (sg.mx[c] - sg.mn[c]) : 0ull;
+        if ((int)d > o->spread) o->spread = (int)d;
+    }
+    int dom = 0;
+    for (int i = 1; i < sg.nt; i++) if (sg.tn[i] > sg.tn[dom]) dom = i;
+    const unsigned long long dsh = sg.nt ? sg.tn[dom] : 0ull;
+    o->cvd = 100.0 * (np - (double)dsh) / np;
+    o->nzb = 100.0 * (double)sg.nz / (4.0 * np);
+    o->ok = 1;
+    return 1;
+}
