+   时机：拷贝 + fence 都过去之后（此刻 staging 里装的就是本帧要送屏的像素）⇒ 与 `[p] sig` 同一刻。
+   预算：全 boot ≤8 行、且相邻两行间隔 ≥30 s（一次性自证，不是周期报表）——这样菜单段与 3D 段
+   各有若干行，能直接比对「同一根 slot/texid 在菜单段与 3D 段拷出来的均值是否不同」。
+   只读：不碰任何 Vulkan 状态、不改选源。 */
+static void m103a_proof_line(unsigned long long call, const char *why, int sel_slot,
+                             VkImage simg, uint32_t sw, uint32_t sh, int lay, int winok)
+{
+    static long last;
+    static unsigned n;
+    if (!why || n >= 8) return;
+    {
+        long now = (long)time(NULL);
+        if (n && now - last < 30) return;   /* 同一 30 s 拍子最多一行 */
+        last = now; n++;
+    }
+    const int nsl = (int)(sizeof g_rt_tab / sizeof *g_rt_tab);
+    /* ② 我们拷的槽在 RT 表里的身份（与 [p] dump 同一张表） */
+    const char *slot_img = "<none>";
+    unsigned long long slot_imgv = 0, slot_key = 0;
+    int slot_tx = -1, slot_same = -1;
+    unsigned slot_w = 0, slot_h = 0;
+    int dt = -1;
+    if (sel_slot >= 0 && sel_slot < nsl) {
+        h_rt_slot *s = &g_rt_tab[sel_slot];
+        slot_img = s->img ? "img" : "no-img";
+        slot_imgv = (unsigned long long)(uintptr_t)s->img;
+        slot_key = (unsigned long long)s->key;
+        slot_tx = s->tex_id; slot_w = (unsigned)s->w; slot_h = (unsigned)s->h;
+        slot_same = (s->img == simg) ? 1 : 0;
+        dt = slot_tx;
+    }
+    /* ③ 游戏自己指定上屏的那张 */
+    int gi = -1, gi_tx = -1, gi_same = -1;
+    unsigned long long gi_img = 0;
+    unsigned gi_w = 0, gi_h = 0;
+    { h_rt_slot *gs = NULL; gi = p_slot_by_key(g_p_tex_key, &gs);
+      if (gi >= 0 && gs) {
+          gi_img = (unsigned long long)(uintptr_t)gs->img; gi_tx = gs->tex_id;
+          gi_w = (unsigned)gs->w; gi_h = (unsigned)gs->h;
+          gi_same = (gs->img == simg) ? 1 : 0;
+      } }
+    /* ④ staging 均值（每 64 像素取 1，成本 <0.1 ms） */
+    unsigned long long sr = 0, sg = 0, sb = 0, nz = 0, ns = 0;
+    { const unsigned char *p = (const unsigned char *)g_p_map;
+      if (p) {
+          const unsigned long long npx = (unsigned long long)g_p_cp_w * g_p_cp_h;
+          for (unsigned long long i = 0; i < npx; i += 64) {
+              const unsigned char *q = p + i * 4;
+              sr += q[0]; sg += q[1]; sb += q[2];
+              if (q[0] || q[1] || q[2]) nz++;
+              ns++;
+          }
+      } }
+    vk_boot_logf("[m103a] proof #%u call=%llu draws=%llu sel_why=%s sel_slot=%d simg=%#llx ext=%ux%u lay=%d win=%s | "
+                 "slot[%d]: %s img=%#llx texid=%d ext=%ux%u key=%#llx same_img=%d | "
+                 "gpres slot=%d img=%#llx texid=%d ext=%ux%u same_img=%d | "
+                 "staging mean=%llu/%llu/%llu nz=%.2f%% of %llux%llu | align dump_slot=%d dump_texid=%d",
