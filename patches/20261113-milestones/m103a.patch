+                 sel_slot, slot_img, slot_imgv, slot_tx, slot_w, slot_h, slot_key, slot_same,
+                 gi, gi_img, gi_tx, gi_w, gi_h, gi_same,
+                 ns ? sr / ns : 0ull, ns ? sg / ns : 0ull, ns ? sb / ns : 0ull,
+                 ns ? 100.0 * (double)nz / (double)ns : 0.0,
+                 (unsigned long long)g_p_cp_w, (unsigned long long)g_p_cp_h,
+                 sel_slot, dt);
+}
