+/* 定长 fs 拷贝（不 snprintf：本函数在 draw 路径上每笔都跑）。 */
+static void m113a_cp17(char *d, const char *s)
+{
+    int k = 0;
+    if (s) { while (k < 16 && s[k]) { d[k] = s[k]; k++; } }
+    d[k] = 0;
+}
