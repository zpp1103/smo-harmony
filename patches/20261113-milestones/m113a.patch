+/* knob 文件必须 app 自己先建（hdc 在沙箱里建不出新文件）；每 2 s 重读。
+   **val=0（缺省）时一行都不打**（A6：关态探针行 0 行）；只有 val>0 才打 seed/变化/心跳行。 */
+static int m113a_knob(void)
+{
+    const double t = (double)pf_now_us() / 1e6;
+    if (g_m113a_v == -2) {
+        const char *p[2] = { M113A_A, M113A_B };
+        int have = 0, i;
+        for (i = 0; i < 2 && !have; i++) { FILE *f = fopen(p[i], "r"); if (f) { fclose(f); have = 1; } }
+        for (i = 0; i < 2 && !have; i++) { FILE *f = fopen(p[i], "w"); if (f) { fputs("0\n", f); fclose(f); have = 1; } }
+        g_m113a_v = p_file_int(M113A_A, M113A_B, 0);
+        g_m113a_kt = t; g_m113a_klog = t;
+        if (g_m113a_v > 0) vk_boot_logf("[m113a] sw knob -> val=%d (seed)", g_m113a_v);
+        return g_m113a_v;
+    }
+    if (t - g_m113a_kt >= 2.0) {
+        const int v = p_file_int(M113A_A, M113A_B, 0);
+        g_m113a_kt = t;
+        if (v != g_m113a_v) {
+            g_m113a_v = v;
+            g_m113a_klog = t;
+            vk_boot_logf("[m113a] sw knob -> val=%d", g_m113a_v);
+        } else if (g_m113a_v > 0 && t - g_m113a_klog >= 10.0) {
+            g_m113a_klog = t;
+            vk_boot_logf("[m113a] sw knob -> val=%d", g_m113a_v);
+        }
+    }
+    return g_m113a_v;
+}
