+/* VBO 快照几何覆盖（同 M110A 口径）：位置属性 = loc0（紧排 vec4），按索引实际引用到的顶点统计
+   世界范围；NDC 覆盖 = 候选矩阵（单位阵 + VS 每个 cbuf bank 的 off+96/off+0 两处 4x4）里视内点
+   最多者的投影 bbox 裁到 [-1,1] 的面积占比；mb 如实标出用了哪一路，找不到给 why=no_matrix。 */
+static void m113a_geom(const R_Key *kv, int nattr, const uint32_t *attrloc,
+                       const VkDeviceSize *aoff_v, const uint32_t *nents,
+                       const void *map, int count, VkDeviceSize vbytes, m113a_geo *o)
+{
+    int k, kp = -1, i, n;
+    unsigned nv;
+    const float *pos;
+    const uint32_t *dix;
+    memset(o, 0, sizeof *o);
+    o->mb = -3;
+    snprintf(o->why, sizeof o->why, "%s", "-");
+    if (!map) { snprintf(o->why, sizeof o->why, "%s", "nomap"); return; }
+    for (k = 0; k < nattr && k < R_MAX_ATTR; k++) if (attrloc[k] == 0u) { kp = k; break; }
+    if (kp < 0) { snprintf(o->why, sizeof o->why, "%s", "no_loc0"); return; }
+    nv = nents[kp];
+    if (!nv) { snprintf(o->why, sizeof o->why, "%s", "nents0"); return; }
+    if (nv > (unsigned)M113A_GEOM_MAX) nv = (unsigned)M113A_GEOM_MAX;
+    pos = (const float *)(const void *)((const uint8_t *)map + aoff_v[kp]);
+    dix = (const uint32_t *)(const void *)((const uint8_t *)map + vbytes);
+    n = count > 0 ? count : 0;
+    if (n > (int)(M113A_GEOM_MAX * 3u)) n = (int)(M113A_GEOM_MAX * 3u);
+    {
+        int used = 0;
+        float xmn = 0.f, xmx = 0.f, ymn = 0.f, ymx = 0.f, zmn = 0.f, zmx = 0.f;
+        for (i = 0; i < n; i++) {
+            const uint32_t v = dix[i];
+            const float *q;
+            if (v >= nv) continue;
+            q = pos + (size_t)v * 4;
+            if (!used) { xmn = xmx = q[0]; ymn = ymx = q[1]; zmn = zmx = q[2]; }
+            else {
+                if (q[0] < xmn) xmn = q[0]; if (q[0] > xmx) xmx = q[0];
+                if (q[1] < ymn) ymn = q[1]; if (q[1] > ymx) ymx = q[1];
+                if (q[2] < zmn) zmn = q[2]; if (q[2] > zmx) zmx = q[2];
+            }
+            used++;
+        }
+        o->nidx = n;
+        if (!used) { snprintf(o->why, sizeof o->why, "%s", "no_vert"); return; }
+        o->xmin = xmn; o->xmax = xmx; o->ymin = ymn; o->ymax = ymx; o->zmin = zmn; o->zmax = zmx;
+    }
+    {
+        int cand, best = -3, bestin = -1, bestpj = 0;
+        float bx0 = 0.f, bx1 = 0.f, by0 = 0.f, by1 = 0.f;
+        int step = 1, npr = n;
+        if (npr > 64) { step = npr / 64; npr = 64; }
+        for (cand = -1; cand < 64; cand++) {
+            float M[16];
+            int nb, half, j, nin = 0, npj = 0;
+            float x0 = 0.f, x1 = 0.f, y0 = 0.f, y1 = 0.f;
+            if (cand < 0) {
+                memset(M, 0, sizeof M); M[0] = M[5] = M[10] = M[15] = 1.0f;
+            } else {
+                uint32_t off;
+                nb = cand & 31; half = (cand >> 5) & 1;
+                if (!kv || !(kv->cbuf_mask & (1u << nb))) continue;
+                off = g_r_ubo_off[0][nb];
+                if (!off || !g_r_ubo_map) continue;
+                if ((unsigned long long)off + 96ull + 64ull > (unsigned long long)R_UBO_ARENA) continue;
+                memcpy(M, (const uint8_t *)g_r_ubo_map + off + (half ? 0u : 96u), sizeof M);
+            }
+            for (j = 0; j < npr; j++) {
+                const uint32_t v = dix[(size_t)(j * step)];
+                const float *p;
+                float q[4], nx, ny, w;
+                if (v >= nv) continue;
+                p = pos + (size_t)v * 4;
+                q[0] = M[0] * p[0] + M[1] * p[1] + M[2] * p[2] + M[3] * p[3];
+                q[1] = M[4] * p[0] + M[5] * p[1] + M[6] * p[2] + M[7] * p[3];
+                q[3] = M[12] * p[0] + M[13] * p[1] + M[14] * p[2] + M[15] * p[3];
+                npj++;
+                w = q[3];
+                if (!(w > 1e-6f)) continue;
+                nx = q[0] / w; ny = q[1] / w;
+                if (!(nx == nx) || !(ny == ny)) continue;
+                if (nx >= -1.001f && nx <= 1.001f && ny >= -1.001f && ny <= 1.001f) {
+                    if (!nin) { x0 = x1 = nx; y0 = y1 = ny; }
+                    else {
+                        if (nx < x0) x0 = nx; if (nx > x1) x1 = nx;
+                        if (ny < y0) y0 = ny; if (ny > y1) y1 = ny;
+                    }
+                    nin++;
+                }
+            }
+            if (nin > bestin) { bestin = nin; best = cand; bestpj = npj; bx0 = x0; bx1 = x1; by0 = y0; by1 = y1; }
+        }
+        o->mb = best; o->nin = bestin; o->npj = bestpj;
+        if (bestin <= 0) { snprintf(o->why, sizeof o->why, "%s", "no_matrix"); return; }
+        {
+            float cx0 = bx0 < -1.f ? -1.f : bx0, cx1 = bx1 > 1.f ? 1.f : bx1;
+            float cy0 = by0 < -1.f ? -1.f : by0, cy1 = by1 > 1.f ? 1.f : by1;
+            float fx = (cx1 - cx0) * 0.5f, fy = (cy1 - cy0) * 0.5f;
+            if (fx < 0.f) fx = 0.f; if (fx > 1.f) fx = 1.f;
+            if (fy < 0.f) fy = 0.f; if (fy > 1.f) fy = 1.f;
+            o->cover = fx * fy;
+        }
+        o->ok = 1;
+    }
 }
 
+/* ===== draw 时点（A1 + A3/A4 的匹配）=====
+   返 1 = 本笔跳过（只在 knob bit1 时可能）。 */
+static int m113a_draw(const R_Key *kv, const R_Key *kf, int si, int dvar,
+                      unsigned nverts, int count, int topo,
+                      int nattr, const uint32_t *attrloc, const VkDeviceSize *aoff_v,
+                      const uint32_t *nents, const void *map, VkDeviceSize vbytes)
+{
+    /* ───── A1 计数无条件：以下 5 行是入口的第一批语句，**它们之前没有任何 if / return / 门控**
+       （选槽门、fs 门、knob 门、dvar 门全部在它们之后；sink 格只用于"槽号非法"的下标归一）。
+       可复核：本函数第一条语句 = 下标记数，第二条 = wr 自增。 ───── */
+    const int ii = (si >= 0 && si < H_RT_SLOTS) ? si : H_RT_SLOTS;
+    g_m113a_wr[ii] += (g_m113a_wr[ii] < 0xffffffffu) ? 1u : 0u;      /* ← wr 自增（无前置条件） */
+    g_m113a_dv[ii] += (dvar >= 3) ? 1u : 0u;                        /* 审计：其中深度笔 */
+    g_m113a_lno[ii] = nverts;                                       /* last_nv */
+    m113a_cp17(g_m113a_lfs[ii], (kf && kf->key[0]) ? kf->key : "-");/* last_fs */
+    /* ───── 以下才是门（A4 的匹配谓词只依赖 fs / decl / real / 目标槽 wh 四项）───── */
+    if (g_m113a_v == -2) (void)m113a_knob();
+    if (g_m113a_v <= 0) return 0;
+    if (si < 0 || si >= H_RT_SLOTS) return 0;
+    if (!kf || !kf->key[0]) return 0;
+    if (strcmp(kf->key, M113A_FS) != 0) return 0;
+    {
+        int decl = 0, real = 0;
+        m105a_ntex(kf, &decl, &real);
+        if (decl != 4 || real != 4) return 0;
+    }
+    {
+        const h_rt_slot *s = &g_rt_tab[si];
+        if (s->w != 400u || s->h != 225u) return 0;                 /* tgt wh==400x225 */
+    }
+    /* ⇒ 命中「帧末那一组」：g_m113a_seq 是本窗口的命中序号（与 wr 无关，仅供行号对齐） */
+    g_m113a_seq++;
+    g_m113a_hit4++;
+    if ((g_m113a_v & 1) && g_m113a_capwant && g_m113a_capn < M113A_CAPN) {
+        m113a_cap *c = &g_m113a_cap[g_m113a_capn];
+        int tgt = 0, sr = -1, dr = -1, sa = -1, da = -1, er = -1, ea = -1, okf = 0;
+        memset(c, 0, sizeof *c);
+        c->seq = g_m113a_seq;
+        c->nv = nverts;
+        c->cnt = (unsigned)(count > 0 ? count : 0);
+        c->slot = si;
+        c->topo = (int)topo;
+        c->dvar = dvar;
+        c->mask = (dvar >= 3) ? 0x0 : 0xF;
+        c->cull = m40c_sw() ? 2 : 0;                 /* 2 = BACK（M40C 开关），0 = NONE（本移植缺省） */
+        c->zt = (dvar != 0);
+        c->zw = (dvar != 0);
+        m14b_dec(g_m14b_blend_raw, &tgt, &sr, &dr, &sa, &da, &er, &ea);
+        okf = m14b_func_ok(sr) && m14b_func_ok(dr) && m14b_func_ok(sa) && m14b_func_ok(da)
+              && m14b_eq_ok(er) && m14b_eq_ok(ea);
+        c->m14bfix = g_m14b_fix;
+        c->m14b = g_m14b_blend_en ? 1 : 0;
+        c->blendok = okf;
+        c->blend_en = (g_m14b_fix && g_m14b_blend_en && okf) ? 1 : 0;   /* = m14b_apply 真正下发的 en */
+        c->sr = sr; c->dr = dr; c->sa = sa; c->da = da; c->er = er; c->ea = ea;
+        c->hasc = (sr >= 0x61 || dr >= 0x61 || sa >= 0x61 || da >= 0x61) ? 1 : 0;
+        memcpy(c->vp, g_r_fs_vp, sizeof c->vp);
+        memcpy(c->sc, g_r_fs_sc, sizeof c->sc);
+        snprintf(c->fs, sizeof c->fs, "%s", kf->key);
+        {
+            int ntex = kf->ntex, u;
+            if (ntex > (int)NVN_TX_SLOTS) ntex = (int)NVN_TX_SLOTS;
+            if (ntex > 4) ntex = 4;                  /* 规格：u=0..3 全部 resolve */
+            for (u = 0; u < ntex; u++) m113a_tex_meta(kf, u, &c->tx[u]);
+            c->ntx = ntex;
+        }
+        m113a_geom(kv, nattr, attrloc, aoff_v, nents, map, count, vbytes, &c->geo);
+        g_m113a_capn++;
+    }
+    if (g_m113a_v & 2) {                             /* A4：只跳这一组，其余一笔不跳 */
+        g_m113a_skipped++;
+        g_m113a_skipf++;
+        if (g_m113a_skiplog < 8ull) {
+            g_m113a_skiplog++;
+            vk_boot_logf("[m113a] skip slot=%d wh=400x225 fs=%s seq=%llu nv=%u cnt=%u dvar=%d mask=0x%x",
+                         si, kf->key, g_m113a_seq, nverts, (unsigned)(count > 0 ? count : 0),
+                         dvar, (dvar >= 3) ? 0u : 0xFu);
+        }
+        return 1;
+    }
+    return 0;
+}
