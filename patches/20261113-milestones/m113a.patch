+/* ＝＝ A2：选槽只在报告/上屏路径调用；**只读计数器，一笔都不丢** ＝＝
+   候选 = 池里有活图且有 ext 的 400x225 槽；取本窗口 wr 最大者（并列取 wh 大者、再取槽号小者）。
+   没有任何合格写入时保持上一帧的选择（槽失效才清 -1）—— 这一步不影响计数。 */
+static void m113a_pick(void)
+{
+    int i, b = -1;
+    unsigned bw = 0, bwh = 0;
+    for (i = 0; i < H_RT_SLOTS; i++) {
+        const h_rt_slot *s = &g_rt_tab[i];
+        unsigned w0;
+        if (!s->key || !s->img || !s->w || !s->h) continue;
+        if (s->w != 400u || s->h != 225u) continue;
+        w0 = g_m113a_wr[i];
+        if (!w0) continue;
+        if (b < 0 || w0 > bw || (w0 == bw && ((s->w * s->h) > bwh))) {
+            b = i; bw = w0; bwh = s->w * s->h;
+        }
+    }
+    if (b < 0) {
+        if (g_m113a_sel >= 0) {
+            const h_rt_slot *s = &g_rt_tab[g_m113a_sel];
+            if (!s->key || !s->img || !s->w || !s->h) g_m113a_sel = -1;
+        }
+        return;
+    }
+    g_m113a_sel = b;
+}
+
+/* 槽整幅回读 + 签名 + 白像素千分比（只在 present 安全点调用）。 */
+static int m113a_sig_img(VkImage img, VkImageLayout lay, unsigned w, unsigned h, m107a_sig_t *o)
+{
+    VkDeviceSize sz;
+    void *px;
+    memset(o, 0, sizeof *o);
+    if (!img || !w || !h) return 0;
+    if ((unsigned long long)w * (unsigned long long)h > M113A_PX_MAX) return 0;
+    if (lay != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL && lay != VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL &&
+        lay != VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL && lay != VK_IMAGE_LAYOUT_GENERAL) return 0;
+    sz = (VkDeviceSize)w * (VkDeviceSize)h * 4ull;
+    pthread_mutex_lock(&g_vkq_lock);
+    px = c_raw_copy(img, lay, w, h, sz);
+    pthread_mutex_unlock(&g_vkq_lock);
+    if (!px) return 0;
+    m107a_sig((const uint8_t *)px, w, h, o);
+    free(px);
+    return o->npx ? 1 : 0;
+}
+
+static int m113a_sig_slot(int slot, m107a_sig_t *o)
+{
+    h_rt_slot *s;
+    memset(o, 0, sizeof *o);
+    if (slot < 0 || slot >= H_RT_SLOTS) return 0;
+    s = &g_rt_tab[slot];
+    if (!s->key || !s->img || !s->w || !s->h) return 0;
+    return m113a_sig_img(s->img, p_slot_layout(s), s->w, s->h, o);
+}
+
+/* 纹理槽解析（4/4 全部 resolve，三级回落，全部只读；不猜、失败给 why）。
+   ① r_fs_slot_image（rt/shadow/tex）；② nvn_vk_tex 对象；③ 裸 view（显式标 rawview）。 */
+static void m113a_tex_meta(const R_Key *kf, int i, m113a_tx *t)
+{
+    int u;
+    memset(t, 0, sizeof *t);
+    t->id = -1; t->dcol = -1;
+    snprintf(t->what, sizeof t->what, "%s", "none");
+    snprintf(t->why, sizeof t->why, "%s", "empty");
+    if (!kf) { snprintf(t->why, sizeof t->why, "%s", "nokf"); return; }
+    u = r_unit_of(kf, i);
+    t->u = u;
+    if (u < 0 || u >= NVN_TX_SLOTS) { snprintf(t->why, sizeof t->why, "%s", "u_range"); return; }
+    t->id = g_r_tx_info[u].id; t->fmt = g_r_tx_info[u].fmt;
+    t->kind = g_r_tx_info[u].kind; t->up = g_r_tx_info[u].up;
+    {
+        VkImage im = VK_NULL_HANDLE;
+        VkImageLayout ly = VK_IMAGE_LAYOUT_UNDEFINED;
+        unsigned w0 = 0, h0 = 0, b0 = 0;
+        const char *what = "none";
+        if (r_fs_slot_image(u, &im, &ly, &w0, &h0, &b0, &what)) {
+            t->img = im; t->lay = (int)ly; t->w = w0; t->h = h0; t->bpp = (int)b0;
+            t->img_ok = 1;
+            snprintf(t->what, sizeof t->what, "%s", what ? what : "-");
+            snprintf(t->why, sizeof t->why, "%s", "-");
+            return;
+        }
+        if (g_r_tx_texobj[u] && g_r_tx_texobj[u]->img) {
+            t->img = g_r_tx_texobj[u]->img; t->lay = (int)g_r_tx_texobj[u]->layout;
+            t->w = g_r_tx_texobj[u]->w; t->h = g_r_tx_texobj[u]->h;
+            t->bpp = (int)vkfmt_bpp_guess(g_r_tx_texobj[u]->fmt);
+            t->img_ok = 1;
+            snprintf(t->what, sizeof t->what, "%s", "texobj");
+            snprintf(t->why, sizeof t->why, "%s", "fs_slot_miss");
+            return;
+        }
+        if (g_r_tx_view[u]) {
+            t->w = g_r_tx_info[u].w; t->h = g_r_tx_info[u].h;
+            snprintf(t->what, sizeof t->what, "%s", "rawview");
+            snprintf(t->why, sizeof t->why, "%s", "no_img");
+            return;
+        }
+    }
+}
