+/* ＝＝ A1 的载体：无条件计数表（末格 = sink）＝＝ */
+static unsigned g_m113a_wr[M113A_N];        /* 本窗口每一笔 draw 的计数（无任何前置门） */
+static unsigned g_m113a_dv[M113A_N];        /* 其中深度笔（dvar>=3）笔数，供审计 */
+static unsigned g_m113a_lno[M113A_N];       /* last_nv */
+static char g_m113a_lfs[M113A_N][17];       /* last_fs */
+static int g_m113a_v = -2;
+static int g_m113a_sel = -1;
+static double g_m113a_kt, g_m113a_klog, g_m113a_t0, g_m113a_rt;
+static unsigned long long g_m113a_fno, g_m113a_pf, g_m113a_seq;
+static m113a_cap g_m113a_cap[M113A_CAPN];
+static unsigned g_m113a_capn;
+static int g_m113a_capwant;
+static unsigned long long g_m113a_skipped, g_m113a_skipf, g_m113a_skiplog;
+static unsigned long long g_m113a_hit4, g_m113a_missnowr;
+static unsigned long long g_m113a_blits, g_m113a_bline, g_m113a_bfail;
