+/* ================= M113A（2026-11-14）：计数无条件 + 报告时选槽 + 状态抓取/skip 按 fs 直接匹配 ============
+   两轮失败的根因（M110A/M111A 的 report §3）：都是「用选槽门去门控计数」——
+     build#1：先 memset 窗口写入量、再 pick ⇒ pick 只看到全 0 ⇒ 永远落到下标最小的陈旧白槽（0 笔）；
+     build#2：把 wr++ 放到 `if (si != sel) return 0;` 这道门**之后** ⇒ sel=-1 ⇒ 一笔都不计 ⇒ 自举死锁。
+   本轮按 task.md §0 六条重写，**去掉「选槽门控」这个失败源**：
+     A1 计数无条件：m113a_draw() 的**前四行**就是 wr 自增 / last_fs / last_nv 记账，它们之前
+        **没有任何 if**（入口到自增之间只有一条下标记数与一条饱和表达式）；选槽门、fs 门、knob 门
+        一律在自增**之后**。knob=0 时照样记账（纯整数，无输出、无渲染影响），所以「选择」永不可能
+        反过来饿死「计数」。
+     A2 选槽只在报告/上屏时算：m113a_pick() 只读计数器（绝不丢弃任何笔），每 30 s 打
+        `[m113a] top k=0..2 slot=… wh=… wr=… last_fs=…`；目标槽 = 本窗口 wh==400x225 里 wr 最大者
+        （并列取 wh 大者、再并列取槽号小者）。
+     A3 状态抓取按 fs 直接匹配（**不看 sel**）：fs==b715ff0659654281 ∧ decl==4 ∧ real==4 ∧
+        本笔目标槽 wh==400x225 的每一笔 ⇒ present 安全点打 d 行（blend/vp/sc/mask/z/cull/topo/nv/idx）
+        + 4/4 纹理 t 行（u=0..3 全部 resolve）+ g 行（几何覆盖 ndc_cover）。draw 路径零回读。
+     A4 skip 直接匹配（同一谓词、同样不看 sel）：smo_m113a bit1 时跳过这些笔，其余一笔不跳；
+        并把目标槽经 M106A 的同一条通道 blit 上屏（同一张 800x450 dst 图 + 同一条 vkCmdBlitImage
+        + 同一条 present 拷贝，不造第二条通道）；每帧打 `[m113a] f call=… skip=… t2[dcol mean sp]`。
+     A5 自检：knob≠0 时，启动 60 s 后若计数器仍全 0 ⇒ `[m113a] miss why=no_wr` +
+        `[m113a] boot sel=CAND …`（候选表 + wh 直方图）；**只多打日志，不改任何绘制行为**。
+     A6 knob `smo_m113a` 缺省 0：三个 hook（draw / present / frame）都不输出、不跳笔、不回读
+        ⇒ 关态逐字节等于 M111A（= M109A 链）。bit0(1)=抓状态，bit1(2)=skip + 目标槽 blit 上屏。
+   预算：top 每 30 s 3 行；f 每帧 1 行（bit1）；d/t/g 每帧 ≤4 笔 × 6 行，窗口 = 3D 段前 10 帧 +
+   之后每 60 帧（≤8 帧/窗口）；skip 行 ≤8；miss 行 ≤3。 */
+#define M113A_FS        "b715ff0659654281"
+#define M113A_A         P_SLOT_DIR_A "/smo_m113a"
+#define M113A_B         P_SLOT_DIR_B "/smo_m113a"
+#define M113A_N         (H_RT_SLOTS + 1)   /* 末格 = slot 非法时的 sink 格（保证自增行里没有 if） */
+#define M113A_CAPN      4u
+#define M113A_PX_MAX    1048576ull
+#define M113A_GEOM_MAX  8192u
+#define M113A_CACHE     8
+#define M113A_TOPK      3
+#define M113A_FRAME_MAX 8ull
+#define M113A_REPORT_S  30.0
+#define M113A_MISSMAX   3u
+
+typedef struct {
+    int u, id, fmt, kind, up, bpp, img_ok, lay, rb, dcol;
+    unsigned w, h, mr, mg, mb, spread;
+    VkImage img;
+    char what[10];
+    char why[16];
+} m113a_tx;
+
+typedef struct {
+    int ok, nidx, npj, nin, mb;
+    float xmin, xmax, ymin, ymax, zmin, zmax, cover;
+    char why[16];
+} m113a_geo;
+
+typedef struct {
+    unsigned long long seq;
+    unsigned nv, cnt;
+    int slot, topo, dvar, mask, cull, zt, zw, blend_en, blendok, m14b, m14bfix;
+    int sr, dr, sa, da, er, ea, hasc;
+    float vp[4];
+    int sc[4];
+    char fs[17];
+    int ntx;
+    m113a_tx tx[4];
+    m113a_geo geo;
+} m113a_cap;
