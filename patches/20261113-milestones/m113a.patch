+/* ===== present 安全点：d / t / g 行（回读全在这里，draw 路径零回读） ===== */
+static void m113a_emit_cap(int ci)
+{
+    static struct { VkImage img; int ok; m107a_sig_t sg; } cache[M113A_CACHE];
+    static int cachen;
+    m113a_cap *c = &g_m113a_cap[ci];
+    int k;
+    /* ① d 行：本笔真实下发的状态 */
+    vk_boot_logf("[m113a] d i=%d seq=%llu slot=%d wh=%ux%u nv=%u idx=%u topo=%d dvar=%d "
+                 "blend=%d src=%s dst=%s op=%s srcA=%s dstA=%s opA=%s blendc=%s m14b=%d fix=%d blok=%d "
+                 "mask=0x%x vp=%.1f,%.1f,%.1fx%.1f sc=%d,%d,%dx%d z=%d/%d/%s cull=%s fs=%s",
+                 ci, c->seq, c->slot, (unsigned)g_rt_tab[c->slot].w, (unsigned)g_rt_tab[c->slot].h,
+                 c->nv, c->cnt, c->topo, c->dvar,
+                 c->blend_en,
+                 (c->m14bfix && c->sr >= 0) ? m14b_func_name(c->sr) : "-",
+                 (c->m14bfix && c->dr >= 0) ? m14b_func_name(c->dr) : "-",
+                 (c->m14bfix && c->er >= 0) ? m14b_eq_name(c->er) : "-",
+                 (c->m14bfix && c->sa >= 0) ? m14b_func_name(c->sa) : "-",
+                 (c->m14bfix && c->da >= 0) ? m14b_func_name(c->da) : "-",
+                 (c->m14bfix && c->ea >= 0) ? m14b_eq_name(c->ea) : "-",
+                 c->hasc ? "0,0,0,0" : "na",
+                 c->m14b, c->m14bfix, c->blendok,
+                 (unsigned)c->mask,
+                 (double)c->vp[0], (double)c->vp[1], (double)c->vp[2], (double)c->vp[3],
+                 c->sc[0], c->sc[1], c->sc[2], c->sc[3],
+                 c->zt, c->zw, c->zt ? "LEQUAL" : "ALWAYS",
+                 (c->cull == 2) ? "BACK" : "NONE", c->fs);
+    /* ② t 行：4/4 全部 resolve（回读按图去重，每帧 ≤4 张、单张 ≤1 Mpx） */
+    for (k = 0; k < c->ntx && k < 4; k++) {
+        m113a_tx *t = &c->tx[k];
+        int ci2, rb = 0, dcol = -1;
+        unsigned mr = 0, mg = 0, mb = 0, sp = 0;
+        if (t->img_ok && t->bpp == 4) {
+            for (ci2 = 0; ci2 < cachen; ci2++) if (cache[ci2].img == t->img) break;
+            if (ci2 < cachen) {
+                rb = cache[ci2].ok; dcol = rb ? (int)cache[ci2].sg.dcol : -1;
+                mr = cache[ci2].sg.mr; mg = cache[ci2].sg.mg; mb = cache[ci2].sg.mb; sp = cache[ci2].sg.spread;
+            } else {
+                m107a_sig_t sg;
+                rb = m113a_sig_img(t->img, (VkImageLayout)t->lay, t->w, t->h, &sg);
+                dcol = rb ? (int)sg.dcol : -1;
+                mr = sg.mr; mg = sg.mg; mb = sg.mb; sp = sg.spread;
+                if (cachen < M113A_CACHE) { cache[cachen].img = t->img; cache[cachen].ok = rb; cache[cachen].sg = sg; cachen++; }
+            }
+            t->rb = rb; t->dcol = dcol;
+        }
+        vk_boot_logf("[m113a] t i=%d u=%d texid=%d kind=%d up=%d fmt=%d what=%s wh=%ux%u bpp=%d "
+                     "mean=%u/%u/%u sp=%u dcol=%d rb=%d why=%s",
+                     ci, t->u, t->id, t->kind, t->up, t->fmt, t->what,
+                     t->w, t->h, t->bpp, mr, mg, mb, sp, dcol, rb, t->why);
+    }
+    /* ③ g 行：VBO 快照几何覆盖 */
+    vk_boot_logf("[m113a] g i=%d nidx=%d nv=%u xmin=%.5g xmax=%.5g ymin=%.5g ymax=%.5g "
+                 "zmin=%.5g zmax=%.5g ndc_cover=%.3f nin=%d/%d mb=%d ok=%d why=%s",
+                 ci, c->geo.nidx, c->nv, (double)c->geo.xmin, (double)c->geo.xmax,
+                 (double)c->geo.ymin, (double)c->geo.ymax, (double)c->geo.zmin, (double)c->geo.zmax,
+                 (double)c->geo.cover, c->geo.nin, c->geo.npj, c->geo.mb, c->geo.ok, c->geo.why);
+}
+
+/* A5：候选表 + wh 直方图（只读 g_rt_tab / 计数器，**不改任何绘制行为**）。 */
+static void m113a_boot_cand(void)
+{
+    unsigned h225 = 0, h228 = 0, h450 = 0, ho = 0, nlive = 0;
+    char cand[200];
+    int i, shown = 0, cl = 0;
+    cand[0] = 0;
+    for (i = 0; i < H_RT_SLOTS; i++) {
+        const h_rt_slot *s = &g_rt_tab[i];
+        if (!s->key || !s->img || !s->w || !s->h) continue;
+        nlive++;
+        if (s->w == 400u && s->h == 225u) h225++;
+        else if (s->w == 400u && s->h == 228u) h228++;
+        else if (s->w == 800u && s->h == 450u) h450++;
+        else ho++;
+        if (shown < 4 && cl < 150) {
+            cl += snprintf(cand + cl, sizeof cand - (size_t)cl, "%s%d(%ux%u,wr=%u,nv=%u,fs=%s)",
+                           shown ? "," : "", i, (unsigned)s->w, (unsigned)s->h,
+                           g_m113a_wr[i], g_m113a_lno[i], g_m113a_lfs[i][0] ? g_m113a_lfs[i] : "-");
+            if (cl < 0 || cl >= (int)sizeof cand) cl = (int)sizeof cand - 1;
+            shown++;
+        }
+    }
+    if (!shown) snprintf(cand, sizeof cand, "%s", "-");
+    vk_boot_logf("[m113a] boot sel=CAND sel=%d nlive=%u nlive400x225=%u wh[400x225=%u 400x228=%u "
+                 "800x450=%u other=%u] cand=%s",
+                 g_m113a_sel, nlive, h225, h225, h228, h450, ho, cand);
+}
+
+/* A2 报告：每 30 s 打 top k=0..2（wr 降序，并列取 wh 大者、再取槽号小者）+ 目标槽 + A5 自检。
+   只读计数器；打完这一窗口才清零（清零**不丢任何笔**：新窗口从下一帧重新累计）。 */
+static void m113a_report(unsigned long long call)
+{
+    int k, i, chosen[M113A_TOPK];
+    unsigned long long nz = 0;
+    for (k = 0; k < M113A_TOPK; k++) chosen[k] = -1;
+    for (i = 0; i < H_RT_SLOTS; i++) if (g_m113a_wr[i]) nz++;
+    m113a_pick();                                   /* 目标槽（只读计数器） */
+    for (k = 0; k < M113A_TOPK; k++) {
+        int b = -1, j;
+        unsigned bw = 0;
+        for (j = 0; j < H_RT_SLOTS; j++) {
+            const h_rt_slot *s = &g_rt_tab[j];
+            unsigned w0;
+            int dup = 0, q;
+            if (!s->key || !s->img || !s->w || !s->h) continue;
+            for (q = 0; q < k; q++) if (chosen[q] == j) dup = 1;
+            if (dup) continue;
+            w0 = g_m113a_wr[j];
+            if (!w0) continue;
+            if (b < 0 || w0 > bw || (w0 == bw && (s->w * s->h) > (g_rt_tab[b].w * g_rt_tab[b].h))) { b = j; bw = w0; }
+        }
+        chosen[k] = b;
+        if (b < 0) break;
+        {
+            const h_rt_slot *s = &g_rt_tab[b];
+            vk_boot_logf("[m113a] top k=%d slot=%d wh=%ux%u wr=%u last_fs=%s last_nv=%u dv=%u sel=%d call=%llu",
+                         k, b, (unsigned)s->w, (unsigned)s->h, g_m113a_wr[b],
+                         g_m113a_lfs[b][0] ? g_m113a_lfs[b] : "-", g_m113a_lno[b], g_m113a_dv[b],
+                         g_m113a_sel, call);
+        }
+    }
+    /* A5 自检（只在 knob≠0 时打；knob=0 必须 0 行 ⇒ A6 优先） */
+    if (!nz && g_m113a_missnowr < (unsigned long long)M113A_MISSMAX && g_m113a_t0 > 0.0) {
+        const double now = (double)pf_now_us() / 1e6;
+        if (now - g_m113a_t0 >= 60.0) {
+            g_m113a_missnowr++;
+            vk_boot_logf("[m113a] miss why=no_wr f=%llu call=%llu (本窗口 wr 全 0：一笔 draw 都没走到计数点；"
+                         "自检不改变任何绘制行为)", g_m113a_fno, call);
+            m113a_boot_cand();
+        }
+    }
+    /* 收口本窗口（下一帧起重新累计） */
+    memset(g_m113a_wr, 0, sizeof g_m113a_wr);
+    memset(g_m113a_dv, 0, sizeof g_m113a_dv);
+    memset(g_m113a_lno, 0, sizeof g_m113a_lno);
+    memset(g_m113a_lfs, 0, sizeof g_m113a_lfs);
+    g_m113a_hit4 = 0;
+}
+
+/* 帧边界（present 内）：A2 报告 / A3 抓取行 / A4 每帧 f 行。knob=0 ⇒ 一行不打、零回读。 */
+static void m113a_frame(unsigned long long call)
+{
+    const int v = m113a_knob();
+    const double now = (double)pf_now_us() / 1e6;
+    if (!g_m113a_t0) g_m113a_t0 = now;
+    if (v <= 0) return;                              /* A6：关态零输出 */
+    if (!g_m113a_rt || now - g_m113a_rt >= M113A_REPORT_S) {
+        g_m113a_rt = now;
+        m113a_report(call);
+    }
+    if (v & 1) {                                     /* A3：抓取行（回读都在本安全点） */
+        int ci;
+        for (ci = 0; ci < (int)g_m113a_capn && ci < (int)M113A_CAPN; ci++) m113a_emit_cap(ci);
+    }
+    if (v & 2) {                                     /* A4：每帧判读行 */
+        m113a_pick();
+        g_m113a_t2ok = m113a_sig_slot(g_m113a_sel, &g_m113a_t2);
+        {
+            const h_rt_slot *s = (g_m113a_sel >= 0) ? &g_rt_tab[g_m113a_sel] : NULL;
+            vk_boot_logf("[m113a] f call=%llu skip=%u t2[dcol=%d mean=%u/%u/%u sp=%u] sel=%d wh=%ux%u "
+                         "hit=%llu blit=%d rb=%d",
+                         call, (unsigned)g_m113a_skipf, g_m113a_t2ok ? (int)g_m113a_t2.dcol : -1,
+                         g_m113a_t2.mr, g_m113a_t2.mg, g_m113a_t2.mb, g_m113a_t2.spread,
+                         g_m113a_sel, s ? (unsigned)s->w : 0u, s ? (unsigned)s->h : 0u,
+                         g_m113a_hit4, g_m113a_blit_on, g_m113a_t2ok);
+        }
+    }
+    /* 收口帧内状态 + 抓取窗口预算（3D 段前 10 帧 + 之后每 60 帧） */
+    g_m113a_skipf = 0;
+    g_m113a_capn = 0;
+    g_m113a_fno++;
+    g_m113a_capwant = (g_m113a_fno < 10ull || (g_m113a_fno % 60ull) == 0ull) ? 1 : 0;
+    g_m113a_blit_on = 0;
+}
