+/* 整幅回读 + 签名 + 白像素千分比（只在 present 安全点调用；失败返 0 并显式给 why）。 */
+static int m110a_sig_img(VkImage img, VkImageLayout lay, unsigned w, unsigned h,
+                         m107a_sig_t *o, unsigned *w10)
+{
+    VkDeviceSize sz;
+    void *px;
+    *w10 = 0;
+    memset(o, 0, sizeof *o);
+    if (!img || !w || !h) return 0;
+    if ((unsigned long long)w * (unsigned long long)h > M110A_PX_MAX) return 0;
+    if (lay != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL && lay != VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL &&
+        lay != VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL && lay != VK_IMAGE_LAYOUT_GENERAL) return 0;
+    sz = (VkDeviceSize)w * (VkDeviceSize)h * 4ull;
+    pthread_mutex_lock(&g_vkq_lock);
+    px = c_raw_copy(img, lay, w, h, sz);
+    pthread_mutex_unlock(&g_vkq_lock);
+    if (!px) return 0;
+    m107a_sig((const uint8_t *)px, w, h, o);
+    {
+        const unsigned long long npx = (unsigned long long)w * (unsigned long long)h;
+        unsigned long long wh = 0, i;
+        const uint8_t *q = (const uint8_t *)px;
+        for (i = 0; i < npx; i++) {
+            const unsigned r = q[i * 4 + 0], g = q[i * 4 + 1], b = q[i * 4 + 2];
+            if (r >= 240u && g >= 240u && b >= 240u) wh++;
+        }
+        *w10 = npx ? (unsigned)(wh * 1000ull / npx) : 0u;
+    }
+    free(px);
+    return o->npx ? 1 : 0;
+}
+
+/* 槽整幅签名（属性选中槽；只在 present 安全点调用）。 */
+static int m110a_sig_slot(int slot, m107a_sig_t *o, unsigned *w10)
+{
+    h_rt_slot *s;
+    *w10 = 0;
+    memset(o, 0, sizeof *o);
+    if (slot < 0 || slot >= H_RT_SLOTS) return 0;
+    s = &g_rt_tab[slot];
+    if (!s->key || !s->img || !s->w || !s->h) return 0;
+    return m110a_sig_img(s->img, p_slot_layout(s), s->w, s->h, o, w10);
+}
