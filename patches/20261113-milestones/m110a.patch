+/* 属性选槽（**不看槽号**）：wh=400x225 且窗口颜色写入量最大；退 400x228；再退 800x450。
+   M110A r2 修正（真机踩到）：① 只考虑**本窗口真被写过**（wr>0）的槽 —— 否则 0 笔的陈旧白槽会按
+   「下标最小」被选中（真机实测一直选到 slot21/texid1967 这个 0 笔的老槽，导致 0 命中）；
+   ② 本窗口一笔符合属性的写入都没有时**保持上一帧的选择**（槽失效才清 -1），不翻到陈旧槽。 */
+static void m110a_pick(void)
+{
+    int i, b = -1, b2 = -1, b3 = -1;
+    unsigned wb = 0, wb2 = 0, wb3 = 0;
+    for (i = 0; i < H_RT_SLOTS; i++) {
+        const h_rt_slot *s = &g_rt_tab[i];
+        unsigned w0;
+        if (!s->key || !s->img || !s->w || !s->h) continue;
+        w0 = g_m110a_wr[i];
+        if (!w0) continue;
+        if (s->w == 400u && s->h == 225u) {
+            if (b < 0 || w0 > wb) { b = i; wb = w0; }
+        } else if (s->w == 400u && s->h == 228u) {
+            if (b2 < 0 || w0 > wb2) { b2 = i; wb2 = w0; }
+        } else if (s->w == 800u && s->h == 450u) {
+            if (b3 < 0 || w0 > wb3) { b3 = i; wb3 = w0; }
+        }
+    }
+    if (b < 0 && b2 < 0 && b3 < 0) {
+        if (g_m110a_sel >= 0) {
+            const h_rt_slot *s = &g_rt_tab[g_m110a_sel];
+            if (!s->key || !s->img || !s->w || !s->h) g_m110a_sel = -1;
+        }
+        return;
+    }
+    {
+        const int nw = (b >= 0) ? b : ((b2 >= 0) ? b2 : b3);
+        if (nw != g_m110a_sel) {           /* 槽变了：组记忆作废（组是按槽学的） */
+            g_m110a_gn = 0; g_m110a_gslot = 0; g_m110a_gok = 0;
+            memset(g_m110a_gfs, 0, sizeof g_m110a_gfs);
+        }
+        g_m110a_sel = nw;
+    }
 }
 
