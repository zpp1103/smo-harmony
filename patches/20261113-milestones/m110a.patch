+/* knob 文件必须 app 自己先建（hdc 在沙箱里建不出新文件）；每 2 s 重读，变化/心跳都打 val= 行。 */
+static int m110a_knob(void)
+{
+    const double t = (double)pf_now_us() / 1e6;
+    if (g_m110a_v == -2) {
+        const char *p[2] = { M110A_A, M110A_B };
+        int have = 0, i;
+        for (i = 0; i < 2 && !have; i++) { FILE *f = fopen(p[i], "r"); if (f) { fclose(f); have = 1; } }
+        for (i = 0; i < 2 && !have; i++) { FILE *f = fopen(p[i], "w"); if (f) { fputs("0\n", f); fclose(f); have = 1; } }
+        g_m110a_v = p_file_int(M110A_A, M110A_B, 0);
+        g_m110a_kt = t; g_m110a_klog = t;
+        m110a_decode(g_m110a_v);
+        vk_boot_logf("[m110a] sw knob -> val=%d (seed)", g_m110a_v);
+        return g_m110a_v;
+    }
+    if (t - g_m110a_kt >= 2.0) {
+        const int v = p_file_int(M110A_A, M110A_B, 0);
+        g_m110a_kt = t;
+        if (v != g_m110a_v) {
+            g_m110a_v = v;
+            m110a_decode(v);
+            g_m110a_klog = t;
+            vk_boot_logf("[m110a] sw knob -> val=%d", g_m110a_v);
+        } else if (t - g_m110a_klog >= 10.0) {
+            g_m110a_klog = t;
+            vk_boot_logf("[m110a] sw knob -> val=%d", g_m110a_v);
+        }
+    }
+    return g_m110a_v;
+}
