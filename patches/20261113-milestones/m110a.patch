+/* ===== draw 时点：命中判定（无回读）+ 抓状态 + knob=2 时跳过。返 1 = 本笔跳过 ===== */
+static int m110a_draw(const R_Key *kv, const R_Key *kf, int si, int dvar,
+                      unsigned nverts, int count, int topo,
+                      int nattr, const uint32_t *attrloc, const VkDeviceSize *aoff_v,
+                      const uint32_t *nents, const void *map, VkDeviceSize vbytes)
+{
+    int decl = 0, real = 0, hit = 0, i = -1;
+    if (g_m110a_v == -2) (void)m110a_knob();
+    if (g_m110a_v <= 0) return 0;
+    if (si < 0 || si >= H_RT_SLOTS) return 0;
+    if (si != g_m110a_sel || dvar >= 3) return 0;
+    g_m110a_atmpt++;
+    if (g_m110a_wr[si] < 0xffffffffu) g_m110a_wr[si]++;
+    m105a_ntex(kf, &decl, &real);
+    g_m110a_nslot++;
+    m110a_tail_push(kf && kf->key[0] ? kf->key : "", decl, real);
+    if (g_m110a_gn == 4u && kf && kf->key[0] && !strcmp(kf->key, g_m110a_gfs)) {
+        g_m110a_gcount++;
+        if (g_m110a_gok && g_m110a_gcount <= 4u && g_m110a_hit < 4u && decl == 4 && real == 4) {
+            i = (int)g_m110a_hit;
+            g_m110a_hit++;
+            hit = 1;
+        }
+    }
+    if (!hit) return 0;
+    /* 抓状态（纯 CPU 记账，不回读） */
+    if (g_m110a_capwant && g_m110a_capn < M110A_CAPN) {
+        m110a_cap *c = &g_m110a_cap[g_m110a_capn];
+        int tgt = 0, sr = -1, dr = -1, sa = -1, da = -1, er = -1, ea = -1, okf = 0;
+        memset(c, 0, sizeof *c);
+        c->seq = g_m110a_atmpt;
+        c->nv = nverts;
+        c->cnt = (unsigned)(count > 0 ? count : 0);
+        c->slot = si;
+        c->topo = (int)topo;
+        c->dvar = dvar;
+        c->mask = (dvar >= 3) ? 0x0 : 0xF;
+        c->cull = m40c_sw() ? 2 : 0;                    /* 2 = BACK（M40C 开关），0 = NONE（本移植缺省） */
+        c->zt = (dvar != 0);
+        c->zw = (dvar != 0);
+        m14b_dec(g_m14b_blend_raw, &tgt, &sr, &dr, &sa, &da, &er, &ea);
+        okf = m14b_func_ok(sr) && m14b_func_ok(dr) && m14b_func_ok(sa) && m14b_func_ok(da)
+              && m14b_eq_ok(er) && m14b_eq_ok(ea);
+        c->m14bfix = g_m14b_fix;
+        c->m14b = g_m14b_blend_en ? 1 : 0;
+        c->blendok = okf;
+        c->blend_en = (g_m14b_fix && g_m14b_blend_en && okf) ? 1 : 0;   /* = m14b_apply 真正下发的 en */
+        c->sr = sr; c->dr = dr; c->sa = sa; c->da = da; c->er = er; c->ea = ea;
+        c->hasc = (sr >= 0x61 || dr >= 0x61 || sa >= 0x61 || da >= 0x61) ? 1 : 0;
+        memcpy(c->vp, g_r_fs_vp, sizeof c->vp);
+        memcpy(c->sc, g_r_fs_sc, sizeof c->sc);
+        snprintf(c->fs, sizeof c->fs, "%s", (kf && kf->key[0]) ? kf->key : "-");
+        {
+            int ntex = kf ? kf->ntex : 0, u;
+            if (ntex > (int)NVN_TX_SLOTS) ntex = (int)NVN_TX_SLOTS;
+            if (ntex > 4) ntex = 4;                     /* 规格：u=0..3 全部 resolve */
+            for (u = 0; u < ntex; u++) m110a_tex_meta(kf, u, &c->tx[u]);
+            c->ntx = ntex;
+            if (kf && kf->ntex > 4 && g_m110a_miss_tex < 2ull) {
+                g_m110a_miss_tex++;
+                vk_boot_logf("[m110a] note i=%d ntex_decl=%d > 4 ⇒ t 行只解 u=0..3（其余槽不猜）",
+                             i, (int)kf->ntex);
+            }
+        }
+        m110a_geom(kv, nattr, attrloc, aoff_v, nents, map, count, vbytes, &c->geo);
+        g_m110a_capn++;
+    }
+    /* knob=2：只跳这一组（命中上限 4 笔，别的一笔不动） */
+    if (g_m110a_v >= 2) {
+        g_m110a_skipped++;
+        g_m110a_fskip++;
+        if (g_m110a_skip_log < 24ull) {
+            g_m110a_skip_log++;
+            vk_boot_logf("[m110a] skip i=%d slot=%d fs=%s seq=%llu nv=%u cnt=%u mask=0x%x blend=%d "
+                         "gcount=%u gok=%d (只跳帧末这一组)",
+                         i, si, (kf && kf->key[0]) ? kf->key : "-", g_m110a_atmpt,
+                         nverts, (unsigned)(count > 0 ? count : 0),
+                         (dvar >= 3) ? 0u : 0xFu, (g_m14b_fix && g_m14b_blend_en) ? 1 : 0,
+                         g_m110a_gcount, g_m110a_gok);
+        }
+        return 1;
+    }
+    return 0;
+}
+
+/* ===== present 时点：t2 回读 + 组学习 + f 行 + 抓取行（d/t/g）+ 收口 + 选槽 ===== */
+static void m110a_emit_cap(int ci)
+{
+    static struct { VkImage img; int ok; m107a_sig_t sg; unsigned w10; unsigned w, h; } cache[M110A_CACHE];
+    static int cachen;
+    m110a_cap *c = &g_m110a_cap[ci];
+    int k;
+    /* ① d 行：本笔真实下发的状态（blend 取 m14b_apply 的公式，mask/vp/sc/z/cull 取管线固定值 + 动态下发值） */
+    vk_boot_logf("[m110a] d i=%d seq=%llu slot=%d wh=%ux%u nv=%u idx=%u topo=%d dvar=%d "
+                 "blend=%d src=%s dst=%s op=%s srcA=%s dstA=%s opA=%s blendc=%s m14b=%d fix=%d blok=%d "
+                 "mask=0x%x vp=%.1f,%.1f,%.1fx%.1f sc=%d,%d,%dx%d z=%d/%d/%s cull=%s fs=%s",
+                 ci, c->seq, c->slot, (unsigned)g_rt_tab[c->slot].w, (unsigned)g_rt_tab[c->slot].h,
+                 c->nv, c->cnt, c->topo, c->dvar,
+                 c->blend_en,
+                 (c->m14bfix && c->sr >= 0) ? m14b_func_name(c->sr) : "-",
+                 (c->m14bfix && c->dr >= 0) ? m14b_func_name(c->dr) : "-",
+                 (c->m14bfix && c->er >= 0) ? m14b_eq_name(c->er) : "-",
+                 (c->m14bfix && c->sa >= 0) ? m14b_func_name(c->sa) : "-",
+                 (c->m14bfix && c->da >= 0) ? m14b_func_name(c->da) : "-",
+                 (c->m14bfix && c->ea >= 0) ? m14b_eq_name(c->ea) : "-",
+                 c->hasc ? "0,0,0,0" : "na",
+                 c->m14b, c->m14bfix, c->blendok,
+                 (unsigned)c->mask,
+                 (double)c->vp[0], (double)c->vp[1], (double)c->vp[2], (double)c->vp[3],
+                 c->sc[0], c->sc[1], c->sc[2], c->sc[3],
+                 c->zt, c->zw, c->zt ? "LEQUAL" : "ALWAYS",
+                 (c->cull == 2) ? "BACK" : "NONE", c->fs);
+    /* ② t 行：4/4 全部 resolve（回读按图去重） */
+    for (k = 0; k < c->ntx && k < 4; k++) {
+        m110a_tx *t = &c->tx[k];
+        int ci2, rb = 0, dcol = -1;
+        unsigned mr = 0, mg = 0, mb = 0, sp = 0;
+        if (t->img_ok && t->bpp == 4) {
+            for (ci2 = 0; ci2 < cachen; ci2++) if (cache[ci2].img == t->img) break;
+            if (ci2 < cachen) {
+                rb = cache[ci2].ok; dcol = rb ? (int)cache[ci2].sg.dcol : -1;
+                mr = cache[ci2].sg.mr; mg = cache[ci2].sg.mg; mb = cache[ci2].sg.mb; sp = cache[ci2].sg.spread;
+            } else {
+                m107a_sig_t sg;
+                unsigned w10 = 0;
+                rb = m110a_sig_img(t->img, (VkImageLayout)t->lay, t->w, t->h, &sg, &w10);
+                dcol = rb ? (int)sg.dcol : -1;
+                mr = sg.mr; mg = sg.mg; mb = sg.mb; sp = sg.spread;
+                if (cachen < M110A_CACHE) {
+                    cache[cachen].img = t->img; cache[cachen].ok = rb; cache[cachen].sg = sg;
+                    cache[cachen].w10 = w10; cache[cachen].w = t->w; cache[cachen].h = t->h;
+                    cachen++;
+                }
+            }
+            t->rb = rb; t->dcol = dcol; t->mr = mr; t->mg = mg; t->mb = mb; t->spread = sp;
+        }
+        vk_boot_logf("[m110a] t i=%d u=%d texid=%d kind=%d up=%d fmt=%d what=%s wh=%ux%u bpp=%d "
+                     "mean=%u/%u/%u sp=%u dcol=%d rb=%d why=%s",
+                     ci, t->u, t->id, t->kind, t->up, t->fmt, t->what,
+                     t->w, t->h, t->bpp, mr, mg, mb, sp, dcol, rb, t->why);
+    }
+    /* ③ g 行：VBO 快照几何覆盖 */
+    vk_boot_logf("[m110a] g i=%d nidx=%d nv=%u xmin=%.5g xmax=%.5g ymin=%.5g ymax=%.5g "
+                 "zmin=%.5g zmax=%.5g ndc_cover=%.3f nin=%d/%d mb=%d ok=%d why=%s",
+                 ci, c->geo.nidx, c->nv, (double)c->geo.xmin, (double)c->geo.xmax,
+                 (double)c->geo.ymin, (double)c->geo.ymax, (double)c->geo.zmin, (double)c->geo.zmax,
+                 (double)c->geo.cover, c->geo.nin, c->geo.npj, c->geo.mb, c->geo.ok, c->geo.why);
+}
+
+static void m110a_frame(unsigned long long call)
+{
+    const int mv = m110a_knob();
+    if (mv <= 0) {
+        memset(g_m110a_wr, 0, sizeof g_m110a_wr);
+        g_m110a_nslot = 0; g_m110a_hit = 0; g_m110a_gcount = 0; g_m110a_fskip = 0;
+        g_m110a_capn = 0; g_m110a_tailn = 0; g_m110a_atmpt = 0;
+        memset(g_m110a_tail, 0, sizeof g_m110a_tail);
+        g_m110a_sel = -1;
+        return;
+    }
+    /* 组学习：本帧最后 4 笔「选中槽颜色笔」是否同 fs ∧ decl==4 ∧ real==4 */
+    if (g_m110a_tailn >= 4u && g_m110a_tail[3].fs[0]) {
+        const char *f0 = g_m110a_tail[3].fs;
+        int same = 1, u;
+        for (u = 0; u < 4; u++) {
+            if (g_m110a_tail[u].decl != 4u || g_m110a_tail[u].real != 4u) same = 0;
+            if (strcmp(g_m110a_tail[u].fs, f0) != 0) same = 0;
+        }
+        if (same) {
+            if (!g_m110a_gfs[0] || strcmp(g_m110a_gfs, f0) != 0) {
+                snprintf(g_m110a_gfs, sizeof g_m110a_gfs, "%s", f0);
+                g_m110a_gn = 4u; g_m110a_gslot = (unsigned)g_m110a_sel;
+                g_m110a_gok = 0;                     /* 本帧的 fs 计数不适用于新 fs ⇒ 下一帧才允许跳 */
+                vk_boot_logf("[m110a] grp learn f=%llu slot=%d fs=%s n=4 decl=4 real=4 (下一帧起可命中)",
+                             g_m110a_fno, g_m110a_sel, g_m110a_gfs);
+            } else if (g_m110a_gn == 4u) {
+                g_m110a_gok = (g_m110a_gcount == 4u) ? 1 : 0;
+            }
+        } else {
+            g_m110a_gn = 0; g_m110a_gok = 0; g_m110a_gcount = 0;
+            if (g_m110a_miss_nogrp < 4ull) {
+                g_m110a_miss_nogrp++;
+                vk_boot_logf("[m110a] miss why=no_grp f=%llu slot=%d tailn=%u (本帧最后 4 笔不是同 fs/decl=4/real=4)",
+                             g_m110a_fno, g_m110a_sel, g_m110a_tailn);
+            }
+        }
+    } else if (g_m110a_miss_nogrp < 4ull) {
+        g_m110a_miss_nogrp++;
+        vk_boot_logf("[m110a] miss why=no_grp f=%llu slot=%d tailn=%u (帧内选中槽颜色笔不足 4 笔)",
+                     g_m110a_fno, g_m110a_sel, g_m110a_tailn);
+    }
+    /* t2：本帧最后一次提交已完成 ⇒ 安全回读点 */
+    {
+        unsigned w10 = 0;
+        g_m110a_t2ok = m110a_sig_slot(g_m110a_sel, &g_m110a_t2, &w10);
+        g_m110a_t2w10 = w10;
+    }
+    /* f 行：每帧 1 行判读 */
+    if (g_m110a_pf < (unsigned long long)M110A_FRAME_MAX) {
+        const h_rt_slot *s = (g_m110a_sel >= 0) ? &g_rt_tab[g_m110a_sel] : NULL;
+        vk_boot_logf("[m110a] f call=%llu fno=%llu slot=%d wh=%ux%u texid=%d nslots=%llu ntry=%llu "
+                     "skipped=%u grp_fs=%s grp_n=%u gok=%d gcount=%u hit=%u "
+                     "t2[dcol=%d mean=%u/%u/%u sp=%u white10=%u rb=%d] blit=%d",
+                     call, g_m110a_fno, g_m110a_sel, s ? (unsigned)s->w : 0u, s ? (unsigned)s->h : 0u,
+                     s ? s->tex_id : -1, g_m110a_nslot, g_m110a_atmpt, g_m110a_fskip,
+                     g_m110a_gfs[0] ? g_m110a_gfs : "-", g_m110a_gn, g_m110a_gok, g_m110a_gcount, g_m110a_hit,
+                     g_m110a_t2ok ? (int)g_m110a_t2.dcol : -1, g_m110a_t2.mr, g_m110a_t2.mg, g_m110a_t2.mb,
+                     g_m110a_t2.spread, g_m110a_t2w10, g_m110a_t2ok, g_m110a_blit_on);
+        g_m110a_pf++;
+    }
+    /* 抓取行（回读都在这里 = present 安全点） */
+    {
+        int ci;
+        for (ci = 0; ci < (int)g_m110a_capn && ci < (int)M110A_CAPN; ci++) m110a_emit_cap(ci);
+    }
+    if (g_m110a_fskip) g_m110a_skipf++;
+    if (g_m110a_sel < 0 && g_m110a_miss_slot < 4ull) {
+        g_m110a_miss_slot++;
+        vk_boot_logf("[m110a] miss why=no_slot f=%llu (池里没有 400x225 / 400x228 / 800x450 的活槽)", g_m110a_fno);
+    }
+    /* 收口 + 下一帧的选槽（**先选槽、后清窗口**：r2 修正 —— 原顺序先 memset 再 pick ⇒ pick 只看到
+       全 0 的写入量，永远落到下标最小的那个 400x225 陈旧槽，0 命中。窗口每 8 帧清一次。） */
+    g_m110a_nslot = 0; g_m110a_hit = 0; g_m110a_gcount = 0; g_m110a_fskip = 0;
+    g_m110a_capn = 0; g_m110a_tailn = 0; g_m110a_atmpt = 0;
+    memset(g_m110a_tail, 0, sizeof g_m110a_tail);
+    g_m110a_fno++;
+    g_m110a_capwant = (g_m110a_fno < 10ull || (g_m110a_fno % 60ull) == 0ull) ? 1 : 0;
+    g_m110a_blit_on = 0;
+    m110a_pick();
+    if ((g_m110a_fno % 8ull) == 0ull) memset(g_m110a_wr, 0, sizeof g_m110a_wr);
+}
