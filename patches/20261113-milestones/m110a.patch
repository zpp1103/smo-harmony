+/* VBO 快照几何覆盖：位置属性 = loc0（本移植把属性展开成紧排 vec4，GPU 读的就是这些 float）。
+   世界范围按「索引实际引用到的顶点」统计；NDC 覆盖用候选矩阵投影后 |x|,|y|<=1.001 的点求 bbox 面积占比。
+   候选矩阵 = 单位阵（位置已是裁剪空间）+ VS 每个 cbuf bank 的两处 4x4 视图（off+96 与 off+0，
+   前者 = M7f/M4az 定位的「c[24..39] = 行式 P·V」口径）；取**视内点数最多**的那个并如实标注 mb。 */
+static void m110a_geom(const R_Key *kv, int nattr, const uint32_t *attrloc,
+                       const VkDeviceSize *aoff_v, const uint32_t *nents,
+                       const void *map, int count, VkDeviceSize vbytes, m110a_geo *o)
+{
+    int k, kp = -1, i, n;
+    unsigned nv;
+    const float *pos;
+    const uint32_t *dix;
+    memset(o, 0, sizeof *o);
+    o->mb = -3;
+    snprintf(o->why, sizeof o->why, "%s", "-");
+    if (!map) { snprintf(o->why, sizeof o->why, "%s", "nomap"); return; }
+    for (k = 0; k < nattr && k < R_MAX_ATTR; k++) if (attrloc[k] == 0u) { kp = k; break; }
+    if (kp < 0) { snprintf(o->why, sizeof o->why, "%s", "no_loc0"); return; }
+    nv = nents[kp];
+    if (!nv) { snprintf(o->why, sizeof o->why, "%s", "nents0"); return; }
+    if (nv > (unsigned)M110A_GEOM_MAX) nv = (unsigned)M110A_GEOM_MAX;
+    pos = (const float *)(const void *)((const uint8_t *)map + aoff_v[kp]);
+    dix = (const uint32_t *)(const void *)((const uint8_t *)map + vbytes);
+    n = count > 0 ? count : 0;
+    if (n > (int)(M110A_GEOM_MAX * 3u)) n = (int)(M110A_GEOM_MAX * 3u);
+    {
+        int used = 0;
+        float xmn = 0.f, xmx = 0.f, ymn = 0.f, ymx = 0.f, zmn = 0.f, zmx = 0.f;
+        for (i = 0; i < n; i++) {
+            const uint32_t v = dix[i];
+            const float *q;
+            if (v >= nv) continue;
+            q = pos + (size_t)v * 4;
+            if (!used) { xmn = xmx = q[0]; ymn = ymx = q[1]; zmn = zmx = q[2]; }
+            else {
+                if (q[0] < xmn) xmn = q[0]; if (q[0] > xmx) xmx = q[0];
+                if (q[1] < ymn) ymn = q[1]; if (q[1] > ymx) ymx = q[1];
+                if (q[2] < zmn) zmn = q[2]; if (q[2] > zmx) zmx = q[2];
+            }
+            used++;
+        }
+        o->nidx = n;
+        if (!used) { snprintf(o->why, sizeof o->why, "%s", "no_vert"); return; }
+        o->xmin = xmn; o->xmax = xmx; o->ymin = ymn; o->ymax = ymx; o->zmin = zmn; o->zmax = zmx;
+    }
+    {   /* 候选矩阵搜索：视内点数最多者 */
+        int cand, best = -3, bestin = -1, bestpj = 0;
+        float bx0 = 0.f, bx1 = 0.f, by0 = 0.f, by1 = 0.f;
+        int step = 1, npr = n;
+        if (npr > 64) { step = npr / 64; npr = 64; }
+        for (cand = -1; cand < 64; cand++) {
+            float M[16];
+            int nb, half, j, nin = 0, npj = 0;
+            float x0 = 0.f, x1 = 0.f, y0 = 0.f, y1 = 0.f;
+            if (cand < 0) {
+                memset(M, 0, sizeof M); M[0] = M[5] = M[10] = M[15] = 1.0f;
+            } else {
+                uint32_t off;
+                nb = cand & 31; half = (cand >> 5) & 1;
+                if (!kv || !(kv->cbuf_mask & (1u << nb))) continue;
+                off = g_r_ubo_off[0][nb];
+                if (!off || !g_r_ubo_map) continue;
+                if ((unsigned long long)off + 96ull + 64ull > (unsigned long long)R_UBO_ARENA) continue;
+                memcpy(M, (const uint8_t *)g_r_ubo_map + off + (half ? 0u : 96u), sizeof M);
+            }
+            for (j = 0; j < npr; j++) {
+                const uint32_t v = dix[(size_t)(j * step)];
+                const float *p;
+                float q[4], nx, ny, w;
+                if (v >= nv) continue;
+                p = pos + (size_t)v * 4;
+                q[0] = M[0] * p[0] + M[1] * p[1] + M[2] * p[2] + M[3] * p[3];
+                q[1] = M[4] * p[0] + M[5] * p[1] + M[6] * p[2] + M[7] * p[3];
+                q[3] = M[12] * p[0] + M[13] * p[1] + M[14] * p[2] + M[15] * p[3];
+                npj++;
+                w = q[3];
+                if (!(w > 1e-6f)) continue;
+                nx = q[0] / w; ny = q[1] / w;
+                if (!(nx == nx) || !(ny == ny)) continue;
+                if (nx >= -1.001f && nx <= 1.001f && ny >= -1.001f && ny <= 1.001f) {
+                    if (!nin) { x0 = x1 = nx; y0 = y1 = ny; }
+                    else {
+                        if (nx < x0) x0 = nx; if (nx > x1) x1 = nx;
+                        if (ny < y0) y0 = ny; if (ny > y1) y1 = ny;
+                    }
+                    nin++;
+                }
+            }
+            if (nin > bestin) { bestin = nin; best = cand; bestpj = npj; bx0 = x0; bx1 = x1; by0 = y0; by1 = y1; }
+        }
+        o->mb = best; o->nin = bestin; o->npj = bestpj;
+        if (bestin <= 0) { snprintf(o->why, sizeof o->why, "%s", "no_matrix"); return; }
+        {   /* bbox 裁到 [-1,1]，面积占比 = 覆盖的屏幕比例（0..1） */
+            float cx0 = bx0 < -1.f ? -1.f : bx0, cx1 = bx1 > 1.f ? 1.f : bx1;
+            float cy0 = by0 < -1.f ? -1.f : by0, cy1 = by1 > 1.f ? 1.f : by1;
+            float fx = (cx1 - cx0) * 0.5f, fy = (cy1 - cy0) * 0.5f;
+            if (fx < 0.f) fx = 0.f; if (fx > 1.f) fx = 1.f;
+            if (fy < 0.f) fy = 0.f; if (fy > 1.f) fy = 1.f;
+            o->cover = fx * fy;
+        }
+        o->ok = 1;
+    }
+}
