+/* 源槽整幅回读 + 签名（设备侧数字，不猜）。≤1/2 s 一次，只读；回读走 g_vkq_lock（与 M99A 同锁序）。 */
+static void m106a_sig_probe(int slot, h_rt_slot *s)
+{
+    if (!s || !s->img || !s->w || !s->h) return;
+    const VkImageLayout lay = p_slot_layout(s);
+    const VkDeviceSize sz = (VkDeviceSize)s->w * (VkDeviceSize)s->h * 4ull;
+    pthread_mutex_lock(&g_vkq_lock);
+    void *px = c_raw_copy(s->img, lay, s->w, s->h, sz);
+    pthread_mutex_unlock(&g_vkq_lock);
+    if (!px) {
+        vk_boot_logf("[m106a] sig src slot=%d wh=%ux%u lay=%d readback=FAIL", slot,
+                     (unsigned)s->w, (unsigned)s->h, (int)lay);
+        return;
+    }
+    m106a_sig_t sg;
+    m106a_sig((const uint8_t *)px, s->w, s->h, &sg);
+    free(px);
+    vk_boot_logf("[m106a] sig src slot=%d wh=%ux%u lay=%d mean=%u/%u/%u spread=%u colored=%u.%u%% "
+                 "dcol=%u nyb=%u.%u%% nz=%u.%u%% npx=%u",
+                 slot, (unsigned)s->w, (unsigned)s->h, (int)lay, sg.mr, sg.mg, sg.mb, sg.spread,
+                 sg.col10 / 10u, sg.col10 % 10u, sg.dcol, sg.nyb10 / 10u, sg.nyb10 % 10u,
+                 sg.nz10 / 10u, sg.nz10 % 10u, sg.npx);
 }
 
