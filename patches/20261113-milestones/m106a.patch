+/* 布局 → (srcAccess, srcStage)。barrier 的 oldLayout 必须与真实布局一致，故按槽自己的记账走。 */
+static void m106a_lay_acc(VkImageLayout lay, VkAccessFlags *acc, VkPipelineStageFlags *st)
+{
+    switch (lay) {
+    case VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL:
+        *acc = VK_ACCESS_SHADER_READ_BIT; *st = VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT; break;
+    case VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL:
+        *acc = VK_ACCESS_TRANSFER_READ_BIT; *st = VK_PIPELINE_STAGE_TRANSFER_BIT; break;
+    case VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL:
+        *acc = VK_ACCESS_TRANSFER_WRITE_BIT; *st = VK_PIPELINE_STAGE_TRANSFER_BIT; break;
+    case VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL:
+        *acc = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+        *st = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT; break;
+    default:
+        *acc = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        *st = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT; break;
+    }
+}
