+/* knob：文件必须 app 自己先建（hdc 在沙箱里建不出新文件）；每 2 s 重读，值变化立刻打
+   `[m106a] sw knob -> val=`，未变化也每 10 s 打一行同格式心跳（M104A 教训：knob 未生效不许当结果）。 */
+static int m106a_knob(void)
+{
+    const double t = (double)pf_now_us() / 1e6;
+    if (g_m106a_v == -2) {
+        const char *p[2] = { M106A_A, M106A_B };
+        int have = 0, i;
+        for (i = 0; i < 2 && !have; i++) { FILE *f = fopen(p[i], "r"); if (f) { fclose(f); have = 1; } }
+        for (i = 0; i < 2 && !have; i++) { FILE *f = fopen(p[i], "w"); if (f) { fputs("0\n", f); fclose(f); have = 1; } }
+        g_m106a_v = p_file_int(M106A_A, M106A_B, 0);
+        g_m106a_kt = t; g_m106a_klog = t;
+        vk_boot_logf("[m106a] sw knob -> val=%d (seed)", g_m106a_v);
+        return g_m106a_v;
+    }
+    if (t - g_m106a_kt >= 2.0) {
+        const int v = p_file_int(M106A_A, M106A_B, 0);
+        g_m106a_kt = t;
+        if (v != g_m106a_v) {
+            g_m106a_v = v; g_m106a_klog = t;
+            vk_boot_logf("[m106a] sw knob -> val=%d", g_m106a_v);
+        } else if (t - g_m106a_klog >= 10.0) {
+            g_m106a_klog = t;
+            vk_boot_logf("[m106a] sw knob -> val=%d", g_m106a_v);
+        }
+    }
+    return g_m106a_v;
+}
