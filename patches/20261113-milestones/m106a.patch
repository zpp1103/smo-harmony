+/* 目标图：800×450 / RGBA8 UNORM（与 present 源同格式 ⇒ blit 免转换）/ TRANSFER_DST|TRANSFER_SRC /
+   device-local，懒创建一次。失败返回非 0 并留日志（调用方据此 fallback=1，不静默）。 */
+static int m106a_dst_img(void)
+{
+    if (g_m106a_img) return 0;
+    if (g_m106a_creat_rc) return g_m106a_creat_rc;
+    if (!g_dev) { g_m106a_creat_rc = -1; return -1; }
+    VkImageCreateInfo ii = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ii.imageType = VK_IMAGE_TYPE_2D;
+    ii.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ii.extent = (VkExtent3D){ M106A_DW, M106A_DH, 1 };
+    ii.mipLevels = 1; ii.arrayLayers = 1;
+    ii.samples = VK_SAMPLE_COUNT_1_BIT;
+    ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ii.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    ii.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ii.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkResult rv = vkCreateImage(g_dev, &ii, NULL, &g_m106a_img);
+    if (rv != VK_SUCCESS) {
+        g_m106a_img = VK_NULL_HANDLE; g_m106a_creat_rc = (int)rv;
+        vk_boot_logf("[m106a] dst img vkCreateImage rv=%d (%s) rc=%d -> fallback=1", (int)rv, vr(rv), (int)rv);
+        return g_m106a_creat_rc;
+    }
+    VkMemoryRequirements rq;
+    vkGetImageMemoryRequirements(g_dev, g_m106a_img, &rq);
+    const int ti = find_type(rq, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    VkMemoryAllocateInfo ai = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    ai.allocationSize = rq.size; ai.memoryTypeIndex = ti >= 0 ? (uint32_t)ti : 0;
+    rv = vkAllocateMemory(g_dev, &ai, NULL, &g_m106a_mem);
+    if (rv != VK_SUCCESS) {
+        g_m106a_creat_rc = (int)rv;
+        vkDestroyImage(g_dev, g_m106a_img, NULL);
+        g_m106a_img = VK_NULL_HANDLE; g_m106a_mem = VK_NULL_HANDLE;
+        vk_boot_logf("[m106a] dst img vkAllocateMemory(%llu) rv=%d (%s) rc=%d -> fallback=1",
+                     (unsigned long long)rq.size, (int)rv, vr(rv), (int)rv);
+        return g_m106a_creat_rc;
+    }
+    vkBindImageMemory(g_dev, g_m106a_img, g_m106a_mem, 0);
+    g_m106a_dlay = VK_IMAGE_LAYOUT_UNDEFINED;
+    vk_boot_logf("[m106a] dst img %ux%u fmt=RGBA8 usage=TFR_DST|TFR_SRC img=%#llx mem=%#llx bytes=%llu rc=0",
+                 (unsigned)M106A_DW, (unsigned)M106A_DH,
+                 (unsigned long long)(uintptr_t)g_m106a_img,
+                 (unsigned long long)(uintptr_t)g_m106a_mem, (unsigned long long)rq.size);
+    return 0;
+}
