+   路径），不静默、不半途改架构。
+   判据口径（M105A 遗留盲区）：`dcol` = 每通道 >>4 量化后的**不同三元组数**（12-bit 精确计数，
+   ≥8 才算有内容），`nyb` = 不属于 黑(各通道<16) / 纯黄(r,g≥240 且 b<32) 的像素占比（>5% 才算有画面）。 */
+#define M106A_A P_SLOT_DIR_A "/smo_m106a"
+#define M106A_B P_SLOT_DIR_B "/smo_m106a"
+#define M106A_DW 800u
+#define M106A_DH 450u
+static VkImage g_m106a_img;
+static VkDeviceMemory g_m106a_mem;
+static VkImageLayout g_m106a_dlay = VK_IMAGE_LAYOUT_UNDEFINED;
+static int g_m106a_creat_rc;                    /* 0 = 建好；非 0 = 建图失败（含 VkResult） */
+static int g_m106a_v = -2;
+static double g_m106a_kt, g_m106a_klog;
+static unsigned long long g_m106a_blits, g_m106a_bfail, g_m106a_fb_pre, g_m106a_sticky_off;
