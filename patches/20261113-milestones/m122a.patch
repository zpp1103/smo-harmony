+}
+static void m122a_lv_note(const nvn_vk_tex *t, unsigned level)
+{
+    if (!t || level >= 32) return;
+    for (unsigned i = 0; i < g_m122a_lv_n; i++)
+        if (g_m122a_lv[i].t == t) { g_m122a_lv[i].mask |= 1u << level; return; }
+    if (g_m122a_lv_n >= M122A_LV_N) { g_m122a_lv_full++; return; }
+    g_m122a_lv[g_m122a_lv_n].t = t;
+    g_m122a_lv[g_m122a_lv_n].mask = 1u << level;
+    g_m122a_lv_n++;
+}
+/* 「从 level 0 起连续上传的层数」；没有记录 ⇒ 1（只知 mip0 ⇒ 合法域退化成 {0}，等于旧行为）。 */
+static int m122a_lv_uploaded(const nvn_vk_tex *t)
+{
+    if (!t) return 1;
+    for (unsigned i = 0; i < g_m122a_lv_n; i++) {
+        if (g_m122a_lv[i].t != t) continue;
+        const unsigned m = g_m122a_lv[i].mask;
+        const unsigned lim = (t->levels && t->levels < 32u) ? t->levels : 32u;
+        unsigned k = 0;
+        while (k < lim && (m >> k & 1u)) k++;
+        return k ? (int)k : 1;
+    }
+    return 1;
+}
+/* 缺省 0；B 视图优先（hdc 可写）、A 兜底；2 s 重读（与 m113a/m119a knob 同口径）。
+   注意：log 只出现在「值变化」时 ⇒ 关态 0 行（不污染 build #5 的 hilog）。 */
+static int m122a_samp_on(void)
+{
+    static int v = -1;
+    static double kt;
+    const double t = (double)pf_now_us() / 1e6;
+    static double klog;
+    if (v < 0) {
+        g_m122a_samp_env = m122a_env_flag("SMO_SAMP_LOD");
+        v = p_file_int(M122A_SAMP_SW_A, M122A_SAMP_SW_B, 0);
+        if (!v) v = g_m122a_samp_env;
+        kt = klog = t;
+        if (v > 0) vk_boot_logf("[m122a] samp clamp sw=%d (seed)", v);
+        return v ? 1 : 0;
+    }
+    if (t - kt >= 2.0) {
+        kt = t;
+        int nv = p_file_int(M122A_SAMP_SW_A, M122A_SAMP_SW_B, 0);
+        if (!nv) nv = g_m122a_samp_env;
+        if (nv != v) { v = nv; klog = t; vk_boot_logf("[m122a] samp clamp sw=%d", v); }
+        (void)klog;
+    }
+    return v ? 1 : 0;
+}
+/* 把 NVN 的 LOD 范围夹进「Vulkan 合法 ∧ 本层真的采得到」的域：levels = 已上传层数（>=1）。
+   mn/mx = 最终 minLod/maxLod；*changed = 本次 clamp 真的动了数值；*rawmx = 夹之前的 maxLod 候选。 */
+static void m122a_lod_fit(int minf, float nvn_min, float nvn_max, int levels,
+                          float *mn, float *mx, int *changed, float *rawmx)
+{
+    const float top = (levels > 1) ? (float)(levels - 1) : 0.0f;   /* 真能采到的最高层号 */
+    float a = (minf <= 1) ? 0.0f : nvn_min;     /* 上游：非 mip 过滤不吃 LOD 下限 */
+    float b = (minf <= 1) ? 0.25f : nvn_max;    /* 上游：非 mip 过滤只允许贴 level 0 */
+    int ch = 0;
+    if (rawmx) *rawmx = b;
+    if (a < 0.0f) { a = 0.0f; ch = 1; }         /* 负 minLod 合法但不吃（本层没有更低的层） */
+    if (a > top)  { a = top;  ch = 1; }         /* minLod > 层数：越界 */
+    if (b > top)  { b = top;  ch = 1; }         /* 派活单点名情形：maxLod > levels */
+    if (b < a)    { b = a;    ch = 1; }         /* Vulkan 硬要求 maxLod >= minLod */
+    *mn = a; *mx = b;
+    if (changed) *changed = ch;
+}
+static void m122a_samp_log(int slot, int minf, int lv, float orig, float final_)
+{
