+/* ================= M122A (2026-11-14)：P3 NVN→Vulkan clip depth 通用映射（knob `smo_clip_map`，缺省 0）======
+   问题：NVN 的裁剪体是 **z ∈ [-w, w]**（near = -w，OpenGL 口径），Vulkan 的裁剪体是 **z ∈ [0, w]**。
+   本层全树没有任何 `VK_EXT_depth_clip_control`（M119A 已 grep：0 命中）⇒ 驱动按 [0,w] 裁，
+   near 附近的几何被整块裁掉。上游 nxohos 的做法（`ohos-port/docs/HarmonyOS移植适配说明.md:343-368`
+   + `dm/gfx/vk/gfx_vk_shader.c:397` 的 `spv_clip_depth`）**不是**点对点烘焙，而是：
+     在 SPIR-V 的**最终位置输出阶段**（顶点入口的每个 OpReturn 之前 / 几何入口的每次 EmitVertex 前后）
+     插入 `gl_Position.z = gl_Position.z * 0.5 + gl_Position.w * 0.5`。
+   本文件现状：只有两处**点对点烘焙**（:23819 的 M3w 探针按 `z2=(p[2]+p[3])*0.5` 复算、:17927
+   在某个固定 VS 里写死），对其它 shader 一律无效。本块把它做成**通用字节改写**：
+     · 只看 stage 0（顶点）——本语料 14,510 条里 **4442 条 VS / 10068 条 FS，无几何着色器**（M122A
+       离线普查：4442/4442 条 VS 都满足上游的「位置输出结构体第一个成员 = BuiltIn Position」前置，
+       且每个入口恰好 **1 个** OpReturn ⇒ 注入点唯一、可离线预判）；
+     · 改写点 = `r_module()` 里 `vkCreateShaderModule` **之前**（:7353 附近，本层 SPIR-V 进驱动的
+       **唯一**活路径；另一处 :5477 是诊断三角形，不走游戏 key）；
+     · 插入的类型/常量走 `m122a_spvi_*`（照抄上游 spvi_decl/scalar/const：先在既有声明里找，找不到
+       才新造 id；保证不重复声明，也不改 `OpEntryPoint` 的接口清单）。
+   三个工程约束（照上游纪律）：
+     ① **不许用 `depthClampEnable=true` 冒充**（那会把几何钳到近平面而不是映射）；
+     ② 变体必须进缓存键 —— 本层模块缓存是「每 key 一个 VkShaderModule」（R_Key.mod），所以
+        **knob 在进程内首次读取后锁存**：中途改文件不影响已建模块（想 A/B 必须冷启动，
+        与 METH:104「关开关≠干净对照」同口径）；持久化的 pipe_cache.bin 由驱动按模块字节哈希，
+        变体字节不同 ⇒ 天然是另一个条目（注释写清，不额外改 magic）；
+     ③ 关态（缺省 0）：不进改写函数、不分配、`si.pCode/si.codeSize` 一字不改、0 行新日志。
+   取证行（前 3 条 + 每 30 s 一条）：`[m122a] clip map n=… mode=… skip=… key=… bytes=… -> …`
+     n = 已改写的 VS 模块数；mode = 映射式（`nvn_negw->vk_0w(z*0.5+w*0.5)`）或 skip 原因；
+     skip = 前置不满足（无输出结构体/无 Position/无 Return）的 VS 模块数。
+   ========================================================================================== */
+#define M122A_CLIP_SW_A M122A_SW_DIR_A "/smo_clip_map"
+#define M122A_CLIP_SW_B M122A_SW_DIR_B "/smo_clip_map"
+static int g_m122a_clip_v = -2;
+static int g_m122a_clip_env = -1;
+static double g_m122a_clip_kt;
+static unsigned long long g_m122a_clip_n, g_m122a_clip_skip;
+static double g_m122a_clip_klast;
+/* 缺省 0；读一次就锁存（见上面 ②）。关态 = 一个静态整数比较。 */
+static int m122a_clip_on(void)
+{
+    if (g_m122a_clip_v >= 0) return g_m122a_clip_v ? 1 : 0;
+    g_m122a_clip_env = m122a_env_flag("SMO_CLIP_MAP");
+    g_m122a_clip_v = p_file_int(M122A_CLIP_SW_A, M122A_CLIP_SW_B, 0);
+    if (!g_m122a_clip_v) g_m122a_clip_v = g_m122a_clip_env;
+    g_m122a_clip_kt = (double)pf_now_us() / 1e6;
+    if (g_m122a_clip_v > 0)
+        vk_boot_logf("[m122a] clip map sw=%d (seed, latched: 中途改文件不生效, 需冷启动)", g_m122a_clip_v);
+    return g_m122a_clip_v ? 1 : 0;
+}
+__attribute__((constructor)) static void m122a_clip_seed(void)
+{
+    static const char *const p[2] = { M122A_CLIP_SW_A, M122A_CLIP_SW_B };
+    for (int i = 0; i < 2; i++) {
+        FILE *r = fopen(p[i], "r");
+        if (r) { fclose(r); continue; }
+        { FILE *f = fopen(p[i], "w"); if (f) { fputs("0\n", f); fclose(f); } }
+    }
 }
+static void m122a_clip_log(const R_Key *k, uint32_t inw, uint32_t outw)
+{
+    const double t = (double)pf_now_us() / 1e6;
+    if (g_m122a_clip_n + g_m122a_clip_skip > 3 && t - g_m122a_clip_klast < 30.0) return;
+    g_m122a_clip_klast = t;
+    vk_boot_logf("[m122a] clip map n=%llu mode=%s skip=%llu key=%s stage=%d words=%u->%u",
+                 g_m122a_clip_n,
+                 outw ? "nvn_negw_to_vk_0w(z*0.5+w*0.5)" : "skip(no_pos_output)",
+                 g_m122a_clip_skip, k ? k->key : "-", k ? k->stage : -1, inw, outw ? outw : inw);
+}
+/* ---- SPIR-V 小工具（照抄 gfx_vk_shader.c:275-288 的 spvi_decl/scalar/const，只留本块用到的部分）----
+   c.nt = 新造的类型/常量指令流（插在「第一个全局变量之前」，Vulkan 要求类型/常量在有使用者之前声明）。 */
+typedef struct { const uint32_t *w; uint32_t fn, bound, *nt, nnt; } m122a_spvi;
+static uint32_t m122a_spvi_find(const uint32_t *a, uint32_t lo, uint32_t hi, uint32_t op,
+                               const uint32_t *ops, uint32_t nops)
+{
+    for (uint32_t j = lo; j < hi;) {
+        uint32_t m = a[j] >> 16;
+        if (!m) break;
+        if ((a[j] & 0xffff) == op && m == nops + 2 && !memcmp(&a[j + 2], ops, nops * 4)) return a[j + 1];
+        j += m;
+    }
+    return 0;
+}
+static uint32_t m122a_spvi_decl(m122a_spvi *c, uint32_t op, const uint32_t *ops, uint32_t nops)
+{
+    uint32_t id = m122a_spvi_find(c->w, 5, c->fn, op, ops, nops);
+    if (!id) id = m122a_spvi_find(c->nt, 0, c->nnt, op, ops, nops);
+    if (id || c->nnt + nops + 2 > 4096) return id;
+    id = c->bound++;
+    c->nt[c->nnt++] = (nops + 2) << 16 | op;
+    c->nt[c->nnt++] = id;
+    memcpy(&c->nt[c->nnt], ops, nops * 4);
+    c->nnt += nops;
+    return id;
+}
+static uint32_t m122a_spvi_scalar(m122a_spvi *c, uint32_t k)
+{
+    uint32_t o[2] = { 32, k - 1 };   /* OpTypeInt 32, 有符号(2)/无符号(1) */
+    return m122a_spvi_decl(c, 21, o, 2);
+}
+static uint32_t m122a_spvi_const(m122a_spvi *c, uint32_t type, uint32_t literal)
+{
+    for (uint32_t i = 5; i < c->fn;) {
+        uint32_t n = c->w[i] >> 16;
+        if (!n) break;
+        if ((c->w[i] & 0xffff) == 43 && n == 4 && c->w[i + 1] == type && c->w[i + 3] == literal) return c->w[i + 2];
+        i += n;
+    }
+    for (uint32_t i = 0; i < c->nnt;) {
+        uint32_t n = c->nt[i] >> 16;
+        if ((c->nt[i] & 0xffff) == 43 && n == 4 && c->nt[i + 1] == type && c->nt[i + 3] == literal) return c->nt[i + 2];
+        i += n;
+    }
+    if (c->nnt + 4 > 4096) return 0;
+    uint32_t id = c->bound++;
+    c->nt[c->nnt++] = 4u << 16 | 43;
+    c->nt[c->nnt++] = type;
+    c->nt[c->nnt++] = id;
+    c->nt[c->nnt++] = literal;
+    return id;
+}
+/* 返回新码流（malloc，调用方 free）；NULL = 本模块不适用（前置不满足 / 没有注入点 / 分配失败）。
+   语义与上游 spv_clip_depth 逐条同构：在**顶点入口**每个 OpReturn 之前插 z' = z*0.5 + w*0.5。
+   （上游的几何着色器分支——每次 EmitVertex 前后并回写还原——本层用不到：语料无 GS，见块首注释。） */
+static uint32_t *m122a_spv_clip_depth(const uint32_t *w, uint32_t nw, int stage, uint32_t *onw)
+{
+    *onw = 0;
+    if (!w || nw < 20 || stage != 0 || w[0] != 0x07230203u) return NULL;
+    uint32_t fn = nw, epfn = 0, ps = 0, member0 = 0, pstruct = 0, pos = 0, f32 = 0, v4 = 0;
+    for (uint32_t i = 5; i < nw;) {
+        uint32_t n = w[i] >> 16, op = w[i] & 0xffff;
+        if (!n || i + n > nw) return NULL;
+        if (op == 54) { fn = i; break; }                                     /* OpFunction = 类型/常量段结束 */
+        if (op == 15 && n >= 3 && w[i + 1] == 0) { if (epfn) return NULL; epfn = w[i + 2]; }   /* 唯一 Vertex 入口 */
+        if (op == 72 && n == 5 && w[i + 2] == 0 && w[i + 3] == 11 && w[i + 4] == 0) {          /* BuiltIn Position */
+            if (ps && ps != w[i + 1]) return NULL;
+            ps = w[i + 1];
+        }
+        if (op == 30 && n >= 3 && w[i + 1] == ps) member0 = w[i + 2];         /* OpTypeStruct 第一个成员 */
+        if (op == 32 && n == 4 && w[i + 2] == 3 && w[i + 3] == ps) pstruct = w[i + 1];   /* 只认 Output 指针，不认 gl_in */
+        if (op == 59 && n >= 4 && w[i + 3] == 3 && w[i + 1] == pstruct) { if (pos) return NULL; pos = w[i + 2]; }
+        if (op == 22 && n == 3 && w[i + 2] == 32) f32 = w[i + 1];
