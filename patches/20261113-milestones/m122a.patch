+   （nvn_vk_tex_upload_level 由 upload_storage 的 level 循环驱动，:3745/:3782 附近），但池里通常只有
+   level 0 的字节 ⇒ 越界层被 `off >= len` / deswizzle 几何判掉。所以这里给每张 nvn_vk_tex 记一个
+   **已上传层位图**（侧表；不改 nvn_vk.h 的结构体布局），合法域取 `[0, uploaded_levels-1]`；
+   没有记录 ⇒ 只知 mip0（= 旧行为）。这一条正是 :7178/:8780 当初把 maxLod 钉成 0 的原因，
+   现在把它写成「数据驱动 + 可开关」，为将来多 mip 上传铺路。
+   knob（文件通道，沿用 M113A/M119A/M40K 的约定）：
+     `smo_samp_lod` 0 = 关（缺省，逐字节旧行为：minLod=maxLod=0，缓存键 lod 位恒 0，0 行日志）
+                   1 = 开（数据驱动 clamp + lod 量化进 sampler 缓存键，METH:104）
+     env `SMO_SAMP_LOD` 仅作首次读取兜底（`aa start` 前注入用），文件值优先。
+   取证行（低频：前 3 次 + 之后每 30 s 一行，满足「≥1/30 s」且不刷屏）：
+     `[m122a] samp clamp n=… changed=… maxlod_orig=… -> …`
+       n            = 走过 clamp 的 sampler 创建次数（缓存命中不算）
+       changed      = clamp 真的动了数值的次数（= 有越界被夹；n 与 changed 分开才看得出「夹了几次」）
+       maxlod_orig  = 最近一次被夹之前的 maxLod 候选（NVN lod_max；非 mip 过滤时按上游归一成 0.25）
+       ->           = 夹完的最终 maxLod
+   ========================================================================================== */
+#define M122A_SW_DIR_A "/data/storage/el2/base/files"
+#define M122A_SW_DIR_B "/data/app/el2/100/base/com.vibecc.smo/files"
+#define M122A_SAMP_SW_A M122A_SW_DIR_A "/smo_samp_lod"
+#define M122A_SAMP_SW_B M122A_SW_DIR_B "/smo_samp_lod"
+static int p_file_int(const char *a, const char *b, int def);   /* M122A 前置声明（定义在 :28588 附近） */
+/* 已上传 mip 层位图（侧表，128 张；只在 knob 开时写，关态一次缓存整数比较就返回）。 */
+#define M122A_LV_N 128
+static struct { const nvn_vk_tex *t; unsigned mask; } g_m122a_lv[M122A_LV_N];
+static unsigned g_m122a_lv_n, g_m122a_lv_full;
+static unsigned long long g_m122a_samp_n, g_m122a_samp_changed, g_m122a_samp_eff;
+static float g_m122a_samp_orig, g_m122a_samp_final;
+static int g_m122a_samp_env = -1;
+static int m122a_env_flag(const char *name)
+{
