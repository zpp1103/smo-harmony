+/* --- 声明缓存（gfx_bridge → 回放层，一次绑定的生命周期内有效） --- */
+static nvn_rt_att g_m119b_att[M119B_MAX_ATT];
+static int        g_m119b_att_n;                 /* 最近一次声明的颜色目标数（0 = 没有声明） */
+void nvn_vk_rt_attachments(int n, const nvn_rt_att *atts)
