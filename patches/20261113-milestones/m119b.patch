+/* --- 懒建 N 附件 render pass（N = 2..8）。与 g_r_rp 同参：loadOp=LOAD / storeOp=STORE / CAO→CAO。
+       var=0（颜色-only）⇒ g_r_rp_n[N]；var=1/2（颜色+深度）⇒ g_r_rp_dn[var][N]，深度仍挂 at[N]
+       （与 h_rp_depth 同构；var=3/4 是「仅深度」，没有颜色附件，不需要 N 附件变体）。 --- */
+static VkRenderPass g_r_rp_n[M119B_MAX_ATT + 1];      /* 索引 = 颜色附件数 N */
+static VkRenderPass g_r_rp_dn[5][M119B_MAX_ATT + 1];  /* [var][N]，var = 1/2 */
+static int h_mrt_rp_d(int var, int N)
+{
+    if (N < 2 || N > M119B_MAX_ATT) return 0;
+    if (var < 0 || var > 2) return 0;
+    if (g_r_rp_dn[var][N]) return 1;
+    if (!g_dev) return 0;
+    VkAttachmentDescription at[M119B_MAX_ATT + 1];
+    VkAttachmentReference ar[M119B_MAX_ATT];
+    memset(at, 0, sizeof at); memset(ar, 0, sizeof ar);
+    for (int i = 0; i < N; i++) {
+        at[i].format = VK_FORMAT_R8G8B8A8_UNORM;
+        at[i].samples = VK_SAMPLE_COUNT_1_BIT;
+        at[i].loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        at[i].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        at[i].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        at[i].stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        at[i].initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        at[i].finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        ar[i].attachment = (uint32_t)i;
+        ar[i].layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    }
+    uint32_t na = (uint32_t)N;
+    VkAttachmentReference dr = { 0, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL };
+    if (var) {
+        at[N].format = (var == 1) ? VK_FORMAT_D32_SFLOAT : VK_FORMAT_X8_D24_UNORM_PACK32;
+        at[N].samples = VK_SAMPLE_COUNT_1_BIT;
+        at[N].loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;      /* 与 h_rp_depth 同口径：清零由 h_depth_clear_frame 显式做 */
+        at[N].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        at[N].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        at[N].stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        at[N].initialLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+        at[N].finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+        dr.attachment = (uint32_t)N;
+        na = (uint32_t)N + 1;
+    }
+    VkSubpassDescription sp = {0};
+    sp.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sp.colorAttachmentCount = (uint32_t)N;
+    sp.pColorAttachments = ar;
+    sp.pDepthStencilAttachment = var ? &dr : NULL;
+    VkSubpassDependency dep = {0};
+    dep.srcSubpass = VK_SUBPASS_EXTERNAL; dep.dstSubpass = 0;
+    dep.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT;
+    dep.dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT;
+    dep.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    dep.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
+                        VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    VkRenderPassCreateInfo rpi = { VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO };
+    rpi.attachmentCount = na; rpi.pAttachments = at;
+    rpi.subpassCount = 1; rpi.pSubpasses = &sp;
+    rpi.dependencyCount = 1; rpi.pDependencies = &dep;
+    VkResult rv = vkCreateRenderPass(g_dev, &rpi, NULL, &g_r_rp_dn[var][N]);
+    if (rv != VK_SUCCESS) {
+        g_r_rp_dn[var][N] = VK_NULL_HANDLE;
+        vk_boot_logf("[m119b] mrt rp n=%d var=%d rv=%d (%s) -> 单附件回退", N, var, (int)rv, vr(rv));
+        return 0;
+    }
+    g_mrt_rp_ok++;
+    vk_boot_logf("[m119b] mrt rp n=%d var=%d rp=%#llx attachments=%u color=%d dfmt=%d load=LOAD store=STORE",
+                 N, var, (unsigned long long)(uintptr_t)g_r_rp_dn[var][N], na, N,
+                 (int)((var == 1) ? VK_FORMAT_D32_SFLOAT : VK_FORMAT_X8_D24_UNORM_PACK32));
+    return 1;
+}
+static int h_mrt_rp(int N) { return h_mrt_rp_d(0, N); }
+/* --- framebuffer：按「(颜色视图元组, 深度视图)」缓存（会话内不销毁，与 g_fbd/h_rt 的既有纪律一致） --- */
+#define M119B_FB_MAX 48
+static struct { VkImageView v[M119B_MAX_ATT]; VkImageView dv; int n; VkFramebuffer fb; } g_mrt_fbd[M119B_FB_MAX];
+static int g_mrt_fbd_n;
+static VkFramebuffer h_fb_mrt_d(int var, int n, h_d_slot *ds)
+{
+    if (n < 2 || n > M119B_MAX_ATT) return VK_NULL_HANDLE;
+    if (var < 0 || var > 2) return VK_NULL_HANDLE;
+    VkImageView views[M119B_MAX_ATT + 1];
+    VkImageView dv = VK_NULL_HANDLE;
+    for (int i = 0; i < n; i++) {
+        if (!g_mrt_slot[i] || !g_mrt_slot[i]->view) return VK_NULL_HANDLE;
+        views[i] = g_mrt_slot[i]->view;
+    }
+    if (var) {
+        if (!ds || !ds->view) return VK_NULL_HANDLE;
+        if (ds->w != g_mrt_slot[0]->w || ds->h != g_mrt_slot[0]->h) { g_mrt_fb_fail++; return VK_NULL_HANDLE; }
+        dv = ds->view;
+        views[n] = dv;
+    }
+    if (!h_mrt_rp_d(var, n)) return VK_NULL_HANDLE;
+    for (int i = 0; i < g_mrt_fbd_n; i++) {
+        if (g_mrt_fbd[i].n != n || g_mrt_fbd[i].dv != dv) continue;
+        int same = 1;
+        for (int k = 0; k < n; k++) if (g_mrt_fbd[i].v[k] != views[k]) { same = 0; break; }
+        if (same) return g_mrt_fbd[i].fb;
+    }
+    if (g_mrt_fbd_n >= M119B_FB_MAX) { g_mrt_fb_full++; return VK_NULL_HANDLE; }
+    { const h_rt_slot *p0 = g_mrt_slot[0];
+      VkFramebufferCreateInfo fbi = { VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO };
+      fbi.renderPass = var ? g_r_rp_dn[var][n] : g_r_rp_n[n];
+      fbi.attachmentCount = (uint32_t)(n + (var ? 1 : 0)); fbi.pAttachments = views;
+      fbi.width = p0->w; fbi.height = p0->h; fbi.layers = 1;
+      VkFramebuffer fb = VK_NULL_HANDLE;
+      if (vkCreateFramebuffer(g_dev, &fbi, NULL, &fb) != VK_SUCCESS) {
+          g_mrt_fb_fail++;
+          vk_boot_logf("[m119b] mrt fb n=%d var=%d ext=%ux%u failed", n, var,
+                       (unsigned)p0->w, (unsigned)p0->h);
+          return VK_NULL_HANDLE;
+      }
+      g_mrt_fbd[g_mrt_fbd_n].n = n; g_mrt_fbd[g_mrt_fbd_n].dv = dv;
+      for (int k = 0; k < n; k++) g_mrt_fbd[g_mrt_fbd_n].v[k] = views[k];
+      g_mrt_fbd[g_mrt_fbd_n].fb = fb;
+      g_mrt_fbd_n++;
+      if (g_mrt_fb_lines++ < 12)
+          vk_boot_logf("[m119b] mrt fb n=%d var=%d fb=%#llx ext=%ux%u slot0=%d fbs=%d",
+                       n, var, (unsigned long long)(uintptr_t)fb, (unsigned)p0->w, (unsigned)p0->h,
+                       (int)(p0 - g_rt_tab), g_mrt_fbd_n);
+      return fb; }
+}
+static VkFramebuffer h_fb_mrt(int n) { return h_fb_mrt_d(0, n, NULL); }
+static int h_mrt_target(int var, h_d_slot *ds, VkRenderPass *rp, VkFramebuffer *fb)
+{
+    if (g_mrt_n < 2) return 0;
+    if (!g_mrt_slot[0] || g_mrt_slot[0] != g_rt_cur) return 0;
+    { VkFramebuffer f = h_fb_mrt_d(var, g_mrt_n, ds);
+      if (!f) return 0;
+      *rp = var ? g_r_rp_dn[var][g_mrt_n] : g_r_rp_n[g_mrt_n];
+      *fb = f;
+      return 1; }
+}
+/* draw 前：把 N 个附件都转到 COLOR_ATTACHMENT_OPTIMAL（只对真的不在该布局的附件下屏障）。 */
+static void h_mrt_barriers(VkCommandBuffer cb)
+{
+    if (g_mrt_n < 2 || !cb) return;
+    for (int i = 0; i < g_mrt_n; i++) {
+        h_rt_slot *s = g_mrt_slot[i];
