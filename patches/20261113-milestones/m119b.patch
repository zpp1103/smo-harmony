+/* 取证行：`[m119b] mrt n=… slots=[…] via=…`（前 8 次 + 之后每 30 s 一行；关态 0 行）。 */
+static void m119b_mrt_line(int n)
+{
+    static double last;
+    static unsigned early;
+    const double t = (double)pf_now_us() / 1e6;
+    if (early >= 8 && t - last < 30.0) return;
+    if (early < 8) early++;
