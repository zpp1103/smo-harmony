+                        g_mrt_slot[i] ? (int)(g_mrt_slot[i] - g_rt_tab) : -1);
+      vk_boot_logf("[m119b] mrt n=%d slots=[%s] via=texid/wh ext=%ux%u fb=%#llx lines=%llu "
