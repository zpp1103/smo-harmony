+#define M119B_DIR_A "/data/storage/el2/base/files"
+#define M119B_DIR_B "/data/app/el2/100/base/com.vibecc.smo/files"
+#define M119B_MRT_A M119B_DIR_A "/smo_rt_mrt"
+#define M119B_MRT_B M119B_DIR_B "/smo_rt_mrt"
+#define M119B_RB_A  M119B_DIR_A "/smo_rb_chk"
+#define M119B_RB_B  M119B_DIR_B "/smo_rb_chk"
+#define M119B_MAX_ATT 8
+static int p_file_int(const char *a, const char *b, int def);   /* 定义在 :22687 附近，此处前置声明 */
+/* 缺省 0；2 s 重读；只在「值变化」时打一行 ⇒ 关态 0 行日志。 */
+static int m119b_sw(const char *pa, const char *pb, int slot)
+{
+    static int v[2] = { -1, -1 };
+    static double kt[2];
+    const double t = (double)pf_now_us() / 1e6;
+    const char *nm = slot ? "smo_rb_chk" : "smo_rt_mrt";
+    if (v[slot] < 0) {
+        v[slot] = p_file_int(pa, pb, 0);
