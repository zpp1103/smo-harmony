+/* --- 本次绑定的附件槽（[0] = 主附件 = g_rt_cur） --- */
+static h_rt_slot *g_mrt_slot[M119B_MAX_ATT];
+static int         g_mrt_n;                      /* >=2 ⇒ 本笔绑定走 N 附件通道；0/1 ⇒ 单附件（旧路径） */
+static int         g_mrt_pass_on;                /* 本笔 draw 真的用了 N 附件 renderPass（管线变体的键） */
+static VkFramebuffer g_mrt_fb_last;
+static unsigned long long g_mrt_lines, g_mrt_passes, g_mrt_fb_full, g_mrt_fb_fail;
+static unsigned g_mrt_fb_lines;
+static unsigned long long g_mrt_rp_ok, g_mrt_pipe_ok, g_mrt_pipe_fail;
+/* skip 原因（**每个都有名字**，绝不静默丢附件） */
+enum { M119B_SK_NONE = 0, M119B_SK_DEPTH, M119B_SK_DECL, M119B_SK_PRIMARY, M119B_SK_UNRESOLVED,
+       M119B_SK_EXT, M119B_SK_SLOT, M119B_SK_DUP, M119B_SK_RP };
+static unsigned long long g_mrt_sk[16];
+static unsigned g_mrt_sk_log;
+static const char *m119b_why(int w)
+{
+    switch (w) {
+    case M119B_SK_DEPTH:      return "depth_pass";
+    case M119B_SK_DECL:       return "decl_mismatch";
+    case M119B_SK_PRIMARY:    return "primary_denied";
+    case M119B_SK_UNRESOLVED: return "unresolved";
+    case M119B_SK_EXT:        return "ext_mismatch";
+    case M119B_SK_SLOT:       return "slot_fail";
+    case M119B_SK_DUP:        return "alias_dup";
+    case M119B_SK_RP:         return "rp_fb_fail";
+    default:                  return "none";
+    }
+}
+static void m119b_mrt_skip(int why)
+{
+    if (why > 0 && why < 16) g_mrt_sk[why]++;
+    if (g_mrt_sk_log < 12) {
+        g_mrt_sk_log++;
+        vk_boot_logf("[m119b] mrt skip why=%s decl=%d slot=%d ext=%ux%u rp_ok=%llu",
