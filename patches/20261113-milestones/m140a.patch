+#define M140A_DIR_B "/data/app/el2/100/base/com.vibecc.smo/files"
+#define M140A_SW_A  M140A_DIR_A "/smo_rt_submerge"
+#define M140A_SW_B  M140A_DIR_B "/smo_rt_submerge"
+#define M140A_MAXBAR 24u                 /* 一张合并 CB 里最多录多少个 barrier，超了强制收口 */
+static int g_m140a_merge = 0;            /* 0 = 关（缺省）；constructor 里按文件覆盖 */
+static unsigned g_m140a_bars;            /* 本张 CB 已录 barrier 数（关态恒 0，不累加） */
+static unsigned long long g_m140a_merged, g_m140a_forced, g_m140a_rec;
+
+/* 照抄 m135a_seed：种 "0\n" + chmod 0666（hdc 是 uid=2000，只能覆盖**已存在**的 666 文件）。 */
+__attribute__((constructor)) static void m140a_seed(void)
+{
+    static const char *const p[2] = { M140A_SW_A, M140A_SW_B };
+    for (int i = 0; i < 2; i++) {
+        if (access(p[i], F_OK) == 0) { chmod(p[i], 0666); continue; }
+        int fd = open(p[i], O_CREAT | O_WRONLY | O_TRUNC, 0666);
+        if (fd >= 0) { ssize_t wr = write(fd, "0\n", 2); (void)wr; close(fd); chmod(p[i], 0666); }
+    }
+    /* 读一次（A→B 兜底）：只在 constructor 里做 ⇒ 运行期每次只有一次 int 读 + 一次比较。 */
+    for (int i = 0; i < 2; i++) {
+        int fd = open(p[i], O_RDONLY);
+        if (fd < 0) continue;
+        char b[16]; ssize_t n = read(fd, b, sizeof b - 1); close(fd);
+        if (n <= 0) break;
+        b[n] = 0; g_m140a_merge = atoi(b) != 0; break;
+    }
+}
+static int m140a_merge_on(void)
+{
+    static int logged;
+    if (g_m140a_merge && !logged) {
+        logged = 1;
+        vk_boot_logf("[m140a] rt submerge on=1 file=%s maxbar=%u (barrier CB 跨目标续录，收口点=clear/tex/stream-end)",
+                     M140A_SW_B, (unsigned)M140A_MAXBAR);
+    }
+    return g_m140a_merge;
+}
 
