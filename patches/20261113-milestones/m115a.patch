+/* /proc/self/maps 里包含 addr 的那一行（原样，含 lo-hi/perms/offset/path）；找不到 ⇒ "maps=none"。
+   只在取证点调用（一次启动至多几行），允许 fopen。返回 1 = 找到。 */
+int smo_obs_page_owner(uint64_t addr, char *out, size_t outn)
+{
+    char line[512];
+    if (!out || !outn) return 0;
+    snprintf(out, outn, "maps=none");
+    FILE *f = fopen("/proc/self/maps", "r");
+    if (!f) return 0;
+    while (fgets(line, (int)sizeof line, f)) {
+        unsigned long long lo = 0, hi = 0;
+        if (sscanf(line, "%llx-%llx", &lo, &hi) != 2) continue;
+        if (addr < lo || addr >= hi) continue;
+        line[strcspn(line, "\r\n")] = 0;
+        snprintf(out, outn, "maps=%.400s", line);
+        fclose(f);
+        return 1;
+    }
+    fclose(f);
     return 0;
 }
